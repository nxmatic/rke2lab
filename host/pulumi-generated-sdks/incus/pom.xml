<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>host-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../host-parent/pom.xml</relativePath>
  </parent>

  <groupId>io.nxmatic.rke2lab.sdks</groupId>
  <artifactId>incus</artifactId>
  <name>host/pulumi-generated-sdks/incus</name>
  <description>Incus provider client SDK, GENERATED by the Pulumi Java codegen from the Incus
    provider schema — not authored here. We version it as source and keep it compilable, but its
    origin is the generator: regenerate rather than hand-edit. Host-side by nature (all gRPC),
    never an OSGi bundle. Lives under host/pulumi-generated-sdks/ to make that provenance explicit;
    the groupId stays io.nxmatic.rke2lab.sdks (independent of the directory).</description>

  <dependencies>
    <dependency>
      <groupId>com.pulumi</groupId>
      <artifactId>pulumi</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <compilerArgs>
            <arg>-nowarn</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
