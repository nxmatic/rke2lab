<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>host-parent</artifactId>
  <packaging>pom</packaging>
  <name>host/host-parent</name>
  <description>Parent of the host-space modules — the counterpart of osgi/bundle-parent. Carries the
    dependency management for the host-only inter-module artifacts (the Pulumi-generated incus SDK and
    the pulumi-edge pair): they are consumed only within the host space, so their versions
    live here rather than polluting the global build-parent. Plugin versions (shade, exec) stay in
    build-parent: they are NOT host-specific — netplan and osgi/manifests shade exec jars too, so the
    pluginManagement is genuinely global; only the per-module shade/exec &lt;configuration&gt; is local
    to each consumer.</description>

  <!--
    Host-only inter-module versions, at ${project.version}. seed-master lives at the ROOT (its parent
    is build-parent, not this) because it is the composition runtime spanning both spaces, so it cannot
    inherit this management — it pins these three artifacts explicitly. This block exists for the host
    modules themselves (e.g. pulumi-edge-testkit -> pulumi-edge).
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.nxmatic.rke2lab.sdks</groupId>
        <artifactId>incus</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>pulumi-edge</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>pulumi-edge-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
