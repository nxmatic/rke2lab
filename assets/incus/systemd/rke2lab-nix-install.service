[Unit]
Description=Install Nix Package Manager for RKE2 Lab
After=rke2lab-network.target
Requires=rke2lab-network.target

[Service]
Type=oneshot
ExecStart=/srv/host/scripts.d/rke2lab-nix-install.sh
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab-tools.target
