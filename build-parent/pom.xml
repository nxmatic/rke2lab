<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.nxmatic.rke2lab</groupId>
  <artifactId>build-parent</artifactId>
  <!-- 0.0.0: a deliberate "release that does not exist" sentinel — a fixed RELEASE coordinate (not a
       SNAPSHOT) so a release child like maven-embed-staging-ext can parent it past the
       no-snapshot-install guard, while the number signals it is never a real published release. -->
  <version>0.0.0</version>
  <packaging>pom</packaging>
  <name>build-parent</name>
  <description>The build parent: global configuration (properties, dependency/plugin
    management, common test dependencies, repositories, profiles) inherited by every
    module. Carries NO &lt;modules&gt; — aggregation is the aggregators' job (root pom.xml
    and the per-space poms). OSGi-specific build config (bnd) lives in osgi/bundle-parent,
    not here.</description>

  <properties>
    <rke2lab.version>0.0.0-SNAPSHOT</rke2lab.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <maven.compiler.plugin.version>3.15.0</maven.compiler.plugin.version>
    <maven.jar.plugin.version>3.5.0</maven.jar.plugin.version>
    <build.helper.plugin.version>3.6.1</build.helper.plugin.version>
    <maven.shade.plugin.version>3.6.2</maven.shade.plugin.version>
    <exec.maven.plugin.version>3.6.3</exec.maven.plugin.version>
    <maven.toolchains.plugin.version>3.2.0</maven.toolchains.plugin.version>
    <maven.enforcer.plugin.version>3.6.3</maven.enforcer.plugin.version>
    <maven.dependency.plugin.version>3.11.0</maven.dependency.plugin.version>
    <maven.surefire.plugin.version>3.5.6</maven.surefire.plugin.version>
    <!-- Default test run excludes the slow/throwaway tests (JUnit5 tag expression).
         Orthogonal tags, mapped to the integration-atlas two spaces + cost/nature:
           host  = exercises host space (the Pulumi/gRPC engine);
           osgi  = exercises OSGi space (the resolver / pure model);
           live  = drives a real Pulumi inline up() (seconds each, spawns gRPC);
           spike = throwaway proof, not a regression test.
         Override with -Plive / -Pspike / -Phost / -Posgi / -Pall-worlds. -->
    <surefire.groups/>
    <surefire.excludedGroups>live | spike</surefire.excludedGroups>
    <spotless.version>3.7.0</spotless.version>
    <!-- NullAway static null-analysis via error-prone (the -Pnullaway opt-in profile below reads the
         @NullMarked packages). Confirmed to run on the JDK 25 toolchain with the full javac module
         export/open set the profile passes. -->
    <errorprone.version>2.50.0</errorprone.version>
    <nullaway.version>0.13.7</nullaway.version>
    <!-- NullAway gate severity, ERROR by default (the gate bites). Override to WARN while
         troubleshooting a surfaced null issue: -Dnullaway.severity=WARN. Turn the gate off
         entirely with -Dnullaway.skip (the profile deactivates when that property is present). -->
    <nullaway.severity>ERROR</nullaway.severity>
    <shellcheck.maven.plugin.version>0.5.1</shellcheck.maven.plugin.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <!-- Tracks the flake's nixpkgs shfmt (the toolchain source of truth);
         the nix build also passes -Dshfmt.version=${pkgs.shfmt.version} so the
         spotless gate's binary and config always agree. Bump together. -->
    <shfmt.version>3.12.0</shfmt.version>
  </properties>

  <!--
    The single dependencyManagement of the build. It imports the standalone BOM
    (the external version catalog, on its own lifecycle/version) and manages the
    rke2lab inter-module versions here at ${project.version} — they share the
    project's lifecycle, so they belong to the project, not the third-party BOM.
    Children carry NO dependencyManagement; they inherit this one.
  -->
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>bom</artifactId>
        <version>1.0.0</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- bnd-read: the shared bnd-header reading. Like the BOM, it has its OWN lifecycle (the
           maven-embed-staging-ext aggregator, built and installed as a RELEASE before the reactor),
           so its version is fixed here, NOT ${rke2lab.version}. boot-discovery depends on it; the
           single source for that version is this line. -->
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>bnd-read</artifactId>
        <version>1.0.0</version>
      </dependency>
      <!-- rke2lab inter-module versions (project lifecycle) -->
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>seed-master</artifactId>
        <version>${rke2lab.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>seed-master</artifactId>
        <version>${rke2lab.version}</version>
        <classifier>exec</classifier>
      </dependency>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>manifests-core</artifactId>
        <version>${rke2lab.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>netplan-core</artifactId>
        <version>${rke2lab.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>systemd-port</artifactId>
        <version>${rke2lab.version}</version>
      </dependency>
      <dependency>
        <groupId>io.nxmatic.rke2lab</groupId>
        <artifactId>cdk8s-systemd</artifactId>
        <version>${rke2lab.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <!--
    Test toolchain common to every module: JUnit 5 for assertions, JGiven for
    behaviour-as-documentation (unit/component tests written as Given/When/Then),
    and Mockito for interaction verification / multi-method collaborator doubles.
    Declared once here so every module gets them without redeclaring; versions
    come from the imported BOM (spring-boot-dependencies + jgiven). seed-master
    additionally depends on jgiven-core in MAIN scope — it plays scenarios in
    production to emit the runbook.
  -->
  <dependencies>
    <!-- JSpecify null-safety annotations (@NullMarked/@Nullable): compile-only intent metadata, no
         runtime engine. Declared here at the ROOT parent so EVERY module (osgi bundles via
         bundle-parent, host/exec via build-parent directly) gets it without redeclaration. A
         package opts IN by posing @NullMarked on its package-info; the jar merely sits on the
         classpath. OSGi bundles drop the RUNTIME-retained org.jspecify.annotations import in their
         bnd.bnd (analysis-only, nothing resolves it at runtime). -->
    <dependency>
      <groupId>org.jspecify</groupId>
      <artifactId>jspecify</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- checker-qual: @MonotonicNonNull for set-once fields (builder fields, lazy caches). NullAway
         reads it at compile time; provided (analysis-only, nothing resolves it at runtime). -->
    <dependency>
      <groupId>org.checkerframework</groupId>
      <artifactId>checker-qual</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!--
    Repository resolution order: Maven Central first (always), then the
    internal GH Packages repos as a fallback for io.nxmatic artifacts.

    Why explicit Central before GH Packages:
    Maven asks every <repository> for every artifact in declaration order.
    GH Packages returns HTTP 500 (rather than 404) for unknown artifacts,
    and the response is slow.  Putting Central first means the vast majority
    of dependency lookups (transitive third-party trees) succeed at Central
    and never touch GH Packages — only io.nxmatic artifacts (which Central
    misses) fall through.
  -->
  <repositories>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>github-nxmatic-java-systemd</id>
      <url>https://maven.pkg.github.com/nxmatic/java-systemd</url>
    </repository>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>github-nxmatic-java-bbox-api-client</id>
      <url>https://maven.pkg.github.com/nxmatic/java-bbox-api-client</url>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
            <!-- Lint on by default: implementation warnings are dette to resolve now, not to hide
                 behind a flag. -processing silences the "no annotation processor claimed" noise
                 from OSGi DS/metatype annotations bnd consumes at a later phase. Not -Werror yet —
                 that lands once the existing warnings are cleared. -->
            <compilerArgs>
              <arg>-Xlint:all</arg>
              <arg>-Xlint:-processing</arg>
            </compilerArgs>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven.jar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build.helper.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven.shade.plugin.version}</version>
          <!-- Shared exec-jar shade across the three exec/ entrypoints (seed-master,
               netplan-cli, manifests-cli): the flags and the artifact filter are
               identical, so they live here. Each module supplies only its own
               <transformers> (mainClass differs per module; the CLIs add a logback
               IncludeResourceTransformer, seed-master adds Add-Opens) — those merge
               onto this managed execution by the implicit 'default' execution id.
               The logback.xml exclude is a harmless no-op for seed-master (it bundles
               none), so the filter is safe to share. -->
          <executions>
            <execution>
              <goals>
                <goal>shade</goal>
              </goals>
              <phase>package</phase>
              <configuration>
                <createDependencyReducedPom>false</createDependencyReducedPom>
                <shadedArtifactAttached>true</shadedArtifactAttached>
                <shadedClassifierName>exec</shadedClassifierName>
                <filters>
                  <filter>
                    <artifact>*:*</artifact>
                    <excludes>
                      <exclude>META-INF/MANIFEST.MF</exclude>
                      <exclude>META-INF/*.SF</exclude>
                      <exclude>META-INF/*.DSA</exclude>
                      <exclude>META-INF/*.RSA</exclude>
                      <exclude>META-INF/SIG-*</exclude>
                      <exclude>META-INF/LICENSE*</exclude>
                      <exclude>META-INF/NOTICE*</exclude>
                      <exclude>logback.xml</exclude>
                      <exclude>module-info.class</exclude>
                      <exclude>META-INF/versions/*/module-info.class</exclude>
                    </excludes>
                  </filter>
                </filters>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.maven.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-toolchains-plugin</artifactId>
          <version>${maven.toolchains.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven.enforcer.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-dependency-plugin</artifactId>
          <version>${maven.dependency.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven.surefire.plugin.version}</version>
          <configuration>
            <!-- JUnit5 tag expressions, both property-driven so the profiles below
                 (and -D overrides) can steer them. Orthogonal tags map to the
                 integration-atlas two spaces + cost/nature:
                   host  = exercises host space (the Pulumi/gRPC engine);
                   osgi  = exercises OSGi space (the resolver / pure model);
                   live  = drives a real Pulumi inline up() (gRPC, seconds each);
                   spike = throwaway proof, not a regression test.
                 Default: groups empty (all), excludedGroups 'live | spike'. -->
            <groups>${surefire.groups}</groups>
            <excludedGroups>${surefire.excludedGroups}</excludedGroups>
          </configuration>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>dev.dimlight</groupId>
          <artifactId>shellcheck-maven-plugin</artifactId>
          <version>${shellcheck.maven.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <executions>
          <execution>
            <id>select-jdk-toolchain</id>
            <goals>
              <goal>toolchain</goal>
            </goals>
            <configuration>
              <toolchains>
                <jdk>
                  <version>${maven.compiler.release}</version>
                </jdk>
              </toolchains>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-tooling</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${maven.compiler.release},)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
          <!-- Reactor jars resolve sibling-to-sibling from target/ via -am; a SNAPSHOT installed into
               ~/.m2 would let a build silently resolve a stale frozen sibling and mask workspace
               incoherence. The install phase is reached only by `mvn install`/`deploy`, never by
               `package`, so this guard is silent on the normal build and fails loudly on a SNAPSHOT
               install. A baseline jar is installed under a RELEASE version (passes), never a SNAPSHOT. -->
          <execution>
            <id>no-snapshot-install</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <phase>install</phase>
            <configuration>
              <rules>
                <requireReleaseVersion>
                  <message>Reactor SNAPSHOTs must not be installed to ~/.m2 — siblings resolve through the reactor via -am. Only a deliberate RELEASE-versioned baseline jar may be installed.</message>
                </requireReleaseVersion>
              </rules>
            </configuration>
          </execution>
          <!-- The permanent guard mirroring the BOM's <exclusion>s: what the BOM cuts on every
               transitive path, this bans globally, so a future dependency bump cannot silently
               reintroduce it by another route. Keep this list in sync with the BOM exclusions.
               - org.osgi:osgi.cmpn — the compendium aggregate (one bundle, 137 exported packages);
                 nothing compiles against it and its DS-API packages are owned by the dedicated spec
                 jars (staged), so flattening it would split those packages off the system bundle. -->
          <execution>
            <id>enforce-banned-dependencies</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>org.osgi:osgi.cmpn</exclude>
                  </excludes>
                  <message>org.osgi:osgi.cmpn (the OSGi compendium aggregate) must not reach the dependency graph — it splits the staged DS-API packages. It is excluded from pax-logging in the BOM; if it reappeared, a new transitive path introduced it. Add the matching &lt;exclusion&gt; in bom/pom.xml.</message>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
          <shell>
            <includes>
              <include>src/main/resources/**/*.sh</include>
              <include>src/test/resources/**/*.sh</include>
            </includes>
            <shfmt>
              <version>${shfmt.version}</version>
            </shfmt>
          </shell>
          <formats>
            <format>
              <includes>
                <include>AGENTS.md</include>
                <include>README.adoc</include>
                <include>docs/**/*.adoc</include>
                <include>docs/**/*.md</include>
              </includes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-apply-on-build</id>
            <goals>
              <goal>apply</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>nxmatic</id>
      <build>
        <directory>target~nxmatic</directory>
      </build>
    </profile>
    <!-- Test selection by tag. The default build excludes 'live | spike'
         (see the surefire.excludedGroups property). These profiles re-include
         or narrow by tag; -Dgroups=… / -DexcludedGroups=… still work for ad hoc
         boolean expressions (host, osgi, live, spike). -->
    <profile>
      <!-- Run everything, including the slow live deployments and the spikes. -->
      <id>all-worlds</id>
      <properties>
        <surefire.excludedGroups/>
      </properties>
    </profile>
    <profile>
      <!-- Add the live (real Pulumi inline up()) tests back to the default run. -->
      <id>live</id>
      <properties>
        <surefire.excludedGroups>spike</surefire.excludedGroups>
      </properties>
    </profile>
    <profile>
      <!-- Run ONLY the throwaway spikes (named *SpikeTest, tagged spike). -->
      <id>spike</id>
      <properties>
        <surefire.groups>spike</surefire.groups>
        <surefire.excludedGroups/>
      </properties>
    </profile>
    <profile>
      <!-- Run ONLY host-space tests (the Pulumi/gRPC engine side). -->
      <id>host</id>
      <properties>
        <surefire.groups>host</surefire.groups>
        <surefire.excludedGroups/>
      </properties>
    </profile>
    <profile>
      <!-- Run ONLY OSGi-space tests (the resolver / pure model side). -->
      <id>osgi</id>
      <properties>
        <surefire.groups>osgi</surefire.groups>
        <surefire.excludedGroups/>
      </properties>
    </profile>
    <!-- NullAway static null-analysis via error-prone, ON BY DEFAULT (the gate). Scoped by
         OnlyNullMarked=true, so only @NullMarked packages are analysed; every other module compiles
         untouched. error-prone forks the compiler and needs the javac module exports/opens below.
         Severity is ${nullaway.severity} (ERROR by default — the gate bites); override to WARN while
         troubleshooting (-Dnullaway.severity=WARN), or skip the gate with -Dnullaway.skip. Test
         sources are out of scope (XepExcludedPaths) — passing null to exercise a guard is legitimate
         there. Activation is by ABSENCE of nullaway.skip, so it stays on regardless of which
         -P<world> profiles are selected. -->
    <profile>
      <id>nullaway</id>
      <activation>
        <property>
          <name>!nullaway.skip</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-compiler-plugin</artifactId>
            <configuration>
              <annotationProcessorPaths>
                <path>
                  <groupId>com.google.errorprone</groupId>
                  <artifactId>error_prone_core</artifactId>
                  <version>${errorprone.version}</version>
                </path>
                <path>
                  <groupId>com.uber.nullaway</groupId>
                  <artifactId>nullaway</artifactId>
                  <version>${nullaway.version}</version>
                </path>
              </annotationProcessorPaths>
              <compilerArgs>
                <arg>-Xlint:all</arg>
                <arg>-Xlint:-processing</arg>
                <arg>-XDcompilePolicy=simple</arg>
                <arg>-XDshould-stop.ifError=FLOW</arg>
                <arg>-Xplugin:ErrorProne -XepDisableAllChecks -XepExcludedPaths:(.*/src/test/.*)|(.*-test/src/.*)|(.*-testkit/src/.*) -Xep:NullAway:${nullaway.severity} -XepOpt:NullAway:OnlyNullMarked=true -XepOpt:NullAway:JSpecifyMode=true -XepOpt:NullAway:ExcludedFieldAnnotations=com.tngtech.jgiven.annotation.ProvidedScenarioState,com.tngtech.jgiven.annotation.ExpectedScenarioState,com.tngtech.jgiven.annotation.ScenarioState,com.tngtech.jgiven.annotation.ScenarioStage,org.mockito.Mock,org.mockito.InjectMocks,org.mockito.Captor,org.osgi.service.component.annotations.Reference</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
              </compilerArgs>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
