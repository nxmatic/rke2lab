<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>netplan-cli</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>exec/netplan-cli</name>
  <description>Netplan CLI: the executable north-adapter that drives the netplan core
    (osgi/netplan/netplan-core). The synthesis command boots an embedded Felix from the bundles
    staged in its -exec jar (the same boot seam as seed-master + manifests-cli) and reads
    NetplanSynthesisService from the registry; the build-time blueprint export runs flat.</description>

  <dependencies>
    <!-- The host-world boot infrastructure: OsgiRuntime + (transitively) the whole boot stack
         (felix.framework + osgi.core compile, felix.scr + felix.resolver + pax-logging + the
         DS-runtime API runtime). The CLI compiles against OsgiRuntime; the felix/pax jars it only
         stages + installs, never compiles against. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The model bundle: embedded INTACT under META-INF/bundles (stage-embedded-bundles below) and
         installed by OsgiRuntime, NOT flattened into the uber-jar (excluded from the shade) so it
         stays the single exporter of its own io.nxmatic.rke2lab.netplan package. runtime scope
         MACHINE-ENFORCES path 2: the CLI compiles only against -port + OsgiRuntime, never against a
         netplan-core impl type — the compiler now forbids the host→impl leak. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-core</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- BlueprintExportCommand serializes the blueprint POJOs to YAML at build time, flat (no Felix):
         jackson stays a flat host dep, the same as seed-master flattens its non-bundle libs. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- The host LoggerContext pax-logging-logback reuses (StaticLogbackContext=true): stays flat. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <!-- The embedded-Felix CLI-scope test boots the same topology as the deployed jar. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <excludes>
          <exclude>logback.xml</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>logback.xml</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.nxmatic.rke2lab.netplan.cli.NetplanCli</mainClass>
        </configuration>
      </plugin>
      <!-- Flags + artifact filter inherited from build-parent's managed shade
           execution; only the per-module transformers + the embed-exclusions are declared here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!-- Shade excludes DERIVED + injected by the osgi-staging-extension from what the
                   bundles declare — no hand-list. The empty artifactSet is the seam it fills. -->
              <artifactSet>
                <excludes/>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>logback.xml</resource>
                  <file>${project.basedir}/src/main/resources/logback.xml</file>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.nxmatic.rke2lab.netplan.cli.NetplanCli</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Stage the designed-for-OSGi jars INTACT under META-INF/bundles (a <resource> root, so
               they land in the uber-jar AND on the test classpath). OsgiRuntime.embedded* streams
               each into Felix at boot. The artifactItems are DERIVED + injected by the
               osgi-staging-extension (same closure as the shade excludes), single-sourced. -->
          <execution>
            <id>stage-embedded-bundles</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <skip>${rke2lab.staging.skip}</skip>
              <outputDirectory>${project.build.directory}/generated-resources/META-INF/bundles</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <artifactItems/>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <rke2lab.staging.skip>true</rke2lab.staging.skip>
      </properties>
    </profile>
  </profiles>
</project>
