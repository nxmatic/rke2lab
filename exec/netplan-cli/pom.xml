<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>netplan-cli</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>exec/netplan-cli</name>
  <description>Netplan CLI: the executable north-adapter for the blueprint export. The yamlExport
    verb drives NetplanCliScenario on the embedded JUnit launcher (the same BDD-as-engine machinery
    seed-master + manifests-cli use), sowing the `netplan` coordinate through the broker; that grows
    NetplanBlueprintScenario in-container (where ClusterNetworkBlueprint, a type=contract bundle
    record, is reachable) which writes blueprint.json into a SOIL temp dir. The CLI reads that
    host-neutral JSON back and converts it to YAML — no contract type crosses to the flat host.</description>

  <dependencies>
    <!-- The host-world boot infrastructure: OsgiRuntime + (transitively) the whole boot stack
         (felix.framework + osgi.core compile, felix.scr + felix.resolver + pax-logging + the
         DS-runtime API runtime). The CLI compiles against OsgiRuntime; the felix/pax jars it only
         stages + installs, never compiles against. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>

    <!-- BDD-as-engine: the CLI drives NetplanCliScenario on the embedded JUnit launcher, sowing the
         `netplan` coordinate through the broker instead of referencing a type=contract bundle record
         flat host-side. Mirrors the manifests-cli dep set. -->
    <!-- The launcher engine + OSGi connection contract: the host scenario reaches
         OsgiConnection/SeedRuntime/ScenarioCellar/RunRole/TxIdSeed/LogFileSeed/ScenarioOutcomeSeed. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- The neutral launcher core (JUnitLauncherCore) NetplanCli names directly. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-launcher</artifactId>
    </dependency>
    <!-- The common gardening spine consumed FLAT (SeedReceiver, SessionSeed, Gardening.sow,
         EphemeralCellar). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-bdd</artifactId>
    </dependency>
    <!-- The broker seam the host speaks (Amendment roles + Cellar); the ONE host<->OSGi membrane. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The broker mechanism (embed type=runtime): DefaultSeedBroker + DefaultAmendmentAssembler,
         staged under META-INF/bundles + published by SCR so the sow resolves the netplan door. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-runtime</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The pax-logging-logback fragment (embed type=model) carrying the logback policy in Java. On
         the graph so the staging closure stages it under META-INF/bundles; at boot it attaches to
         pax-logging-logback and the launcher invokes its PaxLogbackConfigurer reflectively. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>pax-logback-config</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The netplan SCION bundle (embed type=model): NetplanRunbookHandler + NetplanAmendReflector
         serve the `netplan` coordinates and grow NetplanBlueprintScenario in-container. Staged INTACT;
         it pulls netplan-contract into the staged world via its import closure (no flat host copy). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-bdd</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- jGiven-in-OSGi wrap, dual-realm (staged as a bundle AND kept host-flat): the host root
         scenario is a jGiven ScenarioTest, so jgiven runs FLAT for it and as a BUNDLE for the scion. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- jGiven the host scenario compiles against (ScenarioTestBase, Stage, annotations) + its
         JUnit5 extension + the ReportModel/ExecutionStatus NetplanCli reads the run verdict from. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The Jupiter API + engine are runtime code here: the CLI hands JupiterTestEngine.class to
         JUnitLauncherCore to play the scenario, and the scenario declares @Test/@RegisterExtension. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <!-- JUnit Platform artifacts the CLI imports DIRECTLY: DiscoverySelectors (platform-engine) to
         select the scenario, SummaryGeneratingListener (platform-launcher) to read the verdict. -->
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
    </dependency>
    <!-- junit-jupiter-params staged as a bundle (runtime): jgiven-junit5 imports the params packages
         MANDATORY in its bytecode, so the wire must resolve in-framework. Same as seed-master. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>runtime</scope>
    </dependency>
    <!-- The scenario builds the SOIL amendment as a JsonNode, and NetplanCli parses blueprint.json
         then re-emits it as YAML — jackson-databind + jackson-dataformat-yaml are compile deps. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <!-- The org.osgi.service.log API (LogLevel): scenario-engine's OsgiConnection exposes it as the
         framework log-level knob's currency, so the host flat classpath must carry it or the boot
         hits NoClassDefFoundError. The SLIM spec artifact. Same declaration seed-master carries. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.log</artifactId>
    </dependency>

    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- Host slf4j binds to java.util.logging (slf4j-jdk14): host logs ride the JDK JUL bus, drained
         by pax-logging-api's JdkHandler into pax-logging-logback. No host logback backend. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-jdk14</artifactId>
    </dependency>
    <!-- The embedded-Felix CLI-scope test boots the same topology as the deployed jar. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <excludes>
          <exclude>logback.xml</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>logback.xml</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.nxmatic.rke2lab.netplan.cli.NetplanCli</mainClass>
        </configuration>
      </plugin>
      <!-- Flags + artifact filter inherited from build-parent's managed shade
           execution; only the per-module transformers + the embed-exclusions are declared here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!-- Shade excludes DERIVED + injected by the osgi-staging-extension from what the
                   bundles declare — no hand-list. The empty artifactSet is the seam it fills. -->
              <artifactSet>
                <excludes/>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.nxmatic.rke2lab.netplan.cli.NetplanCli</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Stage the designed-for-OSGi jars INTACT under META-INF/bundles (a <resource> root, so
               they land in the uber-jar AND on the test classpath). OsgiRuntime.embedded* streams
               each into Felix at boot. The artifactItems are DERIVED + injected by the
               osgi-staging-extension (same closure as the shade excludes), single-sourced. -->
          <execution>
            <id>stage-embedded-bundles</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <skip>${rke2lab.staging.skip}</skip>
              <outputDirectory>${project.build.directory}/generated-resources/META-INF/bundles</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <artifactItems/>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <rke2lab.staging.skip>true</rke2lab.staging.skip>
      </properties>
    </profile>
  </profiles>
</project>
