<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>seed-master</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>exec/seed-master</name>
  <description>Main bootstrap orchestration and Pulumi control plane: the shaded entry point
    (controlplane.Main) that drives provisioning and hosts the level-0 node wiring.</description>

  <dependencies>
    <dependency>
      <groupId>com.pulumi</groupId>
      <artifactId>pulumi</artifactId>
      <exclusions>
        <exclusion>
          <groupId>com.google.api.grpc</groupId>
          <artifactId>proto-google-common-protos</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.grpc</groupId>
      <artifactId>grpc-netty</artifactId>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab.sdks</groupId>
      <artifactId>incus</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>pulumi-edge</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>pulumi-edge-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Runtime-scope: the host compiles only against the -port types; unitrepo-core is needed at
         run time (and on the test classpath the host-seam test locates it as a bundle). WI-C will
         embed it intact as an OSGi bundle. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>unitrepo-core</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- felix.resolver is the org.osgi.service.resolver.Resolver PROVIDER: its bundle activator
         registers the service that manifests-core's @Reference Resolver binds. unitrepo-core keeps
         it test-scope (it consumes only the interface), so seed-master declares it directly —
         runtime scope puts it on the host-seam test classpath today and makes it embeddable in WI-C.
         Same osgi.core:5.0.0 exclusion (it would shadow osgi.core 8.0.0 and break framework.init()). -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.resolver</artifactId>
      <scope>runtime</scope>
      <exclusions>
        <exclusion>
          <groupId>org.osgi</groupId>
          <artifactId>org.osgi.core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The passive fluent-pipeline grammar engine, consumed FLAT on the host classpath (JCL) —
         the same class manifests-core consumes in-bundle. Replaces seed-master's local
         TopicRunner/OnFailure/PipelineStageFailure triplet. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>pipeline-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The neutral launcher core + the OSGi connection contract (JUnitLauncherCore,
         OsgiConnection): runtime code now — HostSeeder/PreflightStage/IncusStage in src/main reach
         OsgiConnection to attach the phases to the world. The dogfooding promotion (parallel to
         jgiven-junit5): the launcher is the runtime engine, not a test tool. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The model bundle: embedded INTACT under META-INF/bundles and installed by OsgiRuntime, NOT
         flattened into the uber-jar (excluded from the shade). runtime scope MACHINE-ENFORCES path
         2: seed-master's main + tests compile only against -port + OsgiRuntime, never against a
         manifests-core impl type (the realgraph fixture that once forced compile scope is gone). The
         stage-embedded-bundles + manifests-d unpack still resolve the reactor artifact at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-core</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The cdk8s carrier bundle: embedded INTACT under META-INF/bundles, the Fragment-Host the
         systemd-cdk8s-manifests fragment attaches to (it exports io.nxmatic.rke2lab.systemd.cdk8s,
         which manifests-core imports). manifests-core depends on it as provided (non-transitive), so
         the staging closure never reaches it transitively — it must be declared here, exactly as the
         manifests-cli exec module declares it. Without it the fragment stages host-less and
         manifests-core fails to resolve. runtime scope: seed-master compiles against flat cdk8s for
         its own host rendering, never against this OSGi carrier. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The ssh-to-age edge: embedded INTACT + installed by OsgiRuntime, NOT flattened (excluded
         from the shade). runtime scope — seed-master never compiles against the edge impl;
         manifests-core's @Reference SshToAgeConverter binds it from the registry. Mandatory
         reference, so the edge MUST be embedded or ManifestSynthesisService never publishes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>ssh-to-age-edge</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The dbus-systemd edge: embedded INTACT under META-INF/bundles and installed by OsgiRuntime,
         NOT flattened into the uber-jar. runtime scope — seed-master never compiles against the edge
         impl; the readiness pipeline resolves SystemdRuntimeProbe from the registry (awaitService).
         The edge MUST be embedded or the runtime-status probe never publishes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>dbus-systemd-edge</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The cluster edge: embedded INTACT under META-INF/bundles and installed by OsgiRuntime, NOT
         flattened into the uber-jar. runtime scope — seed-master never compiles against the edge impl;
         the readiness probe resolves ClusterReadinessContact from the registry (awaitService). The
         edge MUST be embedded or the kubectl contact never publishes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>cluster-edge</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The incus edge: embedded INTACT under META-INF/bundles and installed by OsgiRuntime, NOT
         flattened into the uber-jar. runtime scope — seed-master never compiles against the edge impl.
         Publishes BOTH incus contacts: the readiness gate resolves IncusInstanceContact and
         PulumiIncusImageProvider resolves ImageBuilder, each from the registry (awaitService). The edge
         carries the remote image-build recipe as a bundle resource. MUST be embedded or the contacts
         never publish. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-edge</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The bbox edge: embedded INTACT under META-INF/bundles and installed by OsgiRuntime. runtime
         scope — seed-master never compiles against the edge impl; BboxStage resolves BboxReconciler
         from the registry. The edge imports the (bundled) bbox client + gson, staged as carriers by
         the closure. The edge MUST be embedded or the reconcile contact never publishes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bbox-edge</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The auth edge: embedded INTACT under META-INF/bundles and installed by OsgiRuntime, NOT
         flattened into the uber-jar. runtime scope — seed-master never compiles against the edge impl;
         the launch-secrets updater resolves AuthTokenContact from the registry (singleSpiProvider).
         The edge MUST be embedded or the token contact never publishes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>auth-edge</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>systemd-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The cluster domain's seam: the readiness phase vocabulary the bdd scenario + pipeline stage
         name directly, the typed schema refs, and the ClusterReadinessContact the host composes for
         the kubectl-backed phases. COMPILE scope like the other -port membranes — seed-master's
         staying code references these types directly; the boot system-exports the package (type=seam)
         so the host reads them back TYPED across the embedded-framework boundary. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>cluster-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The incus domain's seam, both contacts: IncusInstanceContact (the instance-reachability
         contact the readiness gate composes) and ImageBuilder + the flat ImageBuildRequest (the
         image-build contact PulumiIncusImageProvider composes — it projects the build coordinates out
         of its config and folds the edge's recipeDigest into its image-cache key; no build mechanism
         lives host-side). COMPILE scope like the other -port membranes; type=seam so the host reads
         them back typed. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The bbox domain's seam: BboxReconciler + its home vocabulary. The host builds
         BboxReservationRequests from the blueprint and reads BboxRowOutcomes back; no
         io.nxmatic.bbox.* library type lives host-side. type=seam. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bbox-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The auth domain's seam: AuthTokenContact + the AuthTokenSource enum. The host launch-secrets
         updater keeps the env-var precedence and the YAML upsert, and composes this contact from the
         registry only when the environment yielded nothing (the auth-edge shells `gh auth token` /
         `flox auth token`). COMPILE scope like the other -port membranes; type=seam so the host reads
         the token back typed. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>auth-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Governance annotations: the controlplane package-info poses REALM_BOUNDARY=WARN so the
         staging gate lists the flat-realm doctor.records references during the Plan 2 migration
         (build-time only, not runtime behaviour). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The seed-broker seam: Document + SeedBroker. The stage sows a checkpoint Document through
         the broker and reads the verdict's action, instead of reasoning on Severity. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The document codec: JSON (de)serialization + validation for Document payloads. Shaded flat
         into the host classpath (binding to the host's flat jackson). The SAME source is nested into
         doctor-core's Bundle-ClassPath OSGi-side, binding to the bundle's jackson — one source, two
         realm-specific copies, no codec type crosses the seam. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The seed-broker mechanism (embed type=runtime): the DefaultSeedBroker @Component that
         collects every SeedHandler by DS and dispatches by coordinate. RUNTIME scope like an
         embedded model bundle — seed-master's code never references DefaultSeedBroker (it resolves
         the SeedBroker seam via awaitService); the bundle is staged under META-INF/bundles and
         installed by OsgiRuntime so SCR publishes the door in-container. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-runtime</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <!-- The doctor diagnostic model: pure operator-runbook types lifted to OSGi. COMPILE scope (not
         runtime like manifests-core): seed-master's staying code — the live registry, the reader,
         the scenarios and pipeline stages — references the model types directly, so it is a shared
         library, not an embedded bundle. Both edges declared explicitly because both are imported in
         code: doctor-port for the value vocabulary + contracts (the membrane), doctor-core for the
         hidden actors still referenced directly (Generalist, HealthSystem, the readers) until Move B
         hides them behind DoctorConsultingService. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- test-only: the host tests that build replies/specialists (LiveMedicalRecordRegistry,
         MedicalRecordDump, RealGraphInjection, …) use the shared fixtures ReferralReplies /
         FakeSpecialist. These now live in package io.nxmatic.rke2lab.doctor.testkit inside the
         doctor-port-test fragment (the old doctor-testkit module dissolved into it); on seed-master's
         flat classpath that fragment jar is just the carrier of those fixture classes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-port-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- test-only: ExactRosterDoctor (the host tests' exact-roster fixture) lives in the
         doctor-core-test fragment now — it reaches doctor-core's sealed internal graph white-box
         (same package, shared host loader), the access a host module cannot have. On seed-master's
         flat classpath the fragment jar is just the carrier of that fixture class; the Fragment-Host
         header is inert out of container. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-core-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic</groupId>
      <artifactId>java-bbox-api-client</artifactId>
      <version>0.2.1</version>
    </dependency>
    <dependency>
      <groupId>com.google.code.findbugs</groupId>
      <artifactId>jsr305</artifactId>
    </dependency>
    <dependency>
      <groupId>com.google.code.gson</groupId>
      <artifactId>gson</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
    </dependency>
    <dependency>
      <groupId>org.cdk8s</groupId>
      <artifactId>cdk8s</artifactId>
    </dependency>
    <dependency>
      <groupId>software.constructs</groupId>
      <artifactId>constructs</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- The host's logback backend: gives slf4j a real LoggerContext, which pax-logging-logback
         REUSES via StaticLogbackContext=true so OSGi (framework/SCR/bundle) logs land in the host
         logs. The src/main/resources/logback.xml configures it. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <!-- jgiven-junit5 (JGivenExtension) is runtime code here: ClusterSeedScenario (src/main)
         declares it as a class-level @ExtendWith, so the extension is a compile dep, not test-only.
         Same dogfooding promotion as scenario-engine. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The Jupiter extension API is runtime code here: HostFactsSeeder (src/main) is a
         TestInstancePostProcessor the scenario declares, so the extension SPI is a compile dep,
         not test-only. Mirrors scenario-engine's dogfooding promotion. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <!-- The Jupiter engine is runtime code here too: the ClusterSeedTopic driver (src/main) hands
         JupiterTestEngine.class to JUnitLauncherCore to play ClusterSeedScenario — the seeding is
         the launcher running jGiven scenarios, so the engine is a compile dep, not test-only. The
         final leg of the same dogfooding promotion. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The two fake fragments: on the TEST classpath so OutOfContainerFrameworkExtension discovers
         them by capability (installFixtureWithHost) and attaches them to their hosts (dbus-systemd-
         edge / doctor-core) in SystemdAdapterStageTest, where the (variant=fake) selector resolves
         the fakes from the real registry. Their Fragment-Host header is inert out of container. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>dbus-systemd-edge-fake</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Declarative Services on the test classpath: felix.scr + the DS-runtime API trio it wires to,
         so the in-container SystemdAdapterStageTest can start SCR (withScr()) and have it activate
         the fragment-contributed @Components. Not inherited (seed-master uses bundle-parent, not
         bundle-test-parent). -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <!-- The jGiven test closure (byte-buddy add-opens, TCP fork-node, per-module
             jgiven.report.dir) is inherited from build-parent's managed surefire — shared by every
             module that plays a scenario. The exec-runtime Add-Opens for `java -jar` lives in the
             shade manifest below (a distinct, exec-only concern). -->
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-antrun-plugin</artifactId>
        <executions>
          <execution>
            <id>clean-unpacked-manifests-generated-resources</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <target>
                <delete dir="${project.build.directory}/generated-resources/META-INF/io.nxmatic/rke2lab/controlplane/incus/manifests" quiet="true"/>
                <delete dir="${project.build.directory}/classes/META-INF/io.nxmatic/rke2lab/controlplane/incus/manifests" quiet="true"/>
              </target>
            </configuration>
          </execution>
          <execution>
            <id>copy-incus-assets-into-generated-resources</id>
            <goals>
              <goal>run</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <target>
                <mkdir dir="${project.build.directory}/generated-resources/META-INF/io.nxmatic/rke2lab/controlplane/incus/assets"/>
                <copy overwrite="true" todir="${project.build.directory}/generated-resources/META-INF/io.nxmatic/rke2lab/controlplane/incus/assets">
                  <fileset dir="${maven.multiModuleProjectDirectory}/assets/incus" erroronmissingdir="false"/>
                </copy>
                <mkdir dir="${project.build.directory}/generated-resources/META-INF/io.nxmatic/rke2lab/controlplane/incus"/>
                <copy overwrite="true" todir="${project.build.directory}/generated-resources/META-INF/io.nxmatic/rke2lab/controlplane/incus">
                  <fileset dir="${project.basedir}/src/main/resources/incus"/>
                </copy>
              </target>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <!-- Flags + artifact filter inherited from build-parent's managed shade
             execution; only the per-module transformer is declared here. -->
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!-- The shade excludes (the jars staged as bundles, kept OUT of the flat uber-jar) are
                   DERIVED and injected by the osgi-staging-extension from what the bundles declare —
                   no hand-list here. The empty artifactSet is the seam the extension fills; see
                   StagingExecutionStrategy. -->
              <artifactSet>
                <excludes/>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.nxmatic.rke2lab.controlplane.Main</mainClass>
                  <manifestEntries>
                    <!-- JGiven generates stage subclasses via byte-buddy, whose reflective class
                         injector needs java.lang opened under JDK module encapsulation. Honored
                         when Pulumi launches the exec jar with `java -jar`. -->
                    <Add-Opens>java.base/java.lang</Add-Opens>
                  </manifestEntries>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.nxmatic.rke2lab.controlplane.Main</mainClass>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Stage the designed-for-OSGi jars INTACT under META-INF/bundles (a <resource> root, so
               they land in the uber-jar AND on the test classpath). OsgiRuntime.embedded* extracts
               them at boot and installs them by file: URL. The artifactItems are DERIVED and injected
               by the osgi-staging-extension (the same closure that fills the shade excludes above),
               so the staged set and the shade-excluded set are single-sourced — no hand-list, no
               drift. destFileName is set by the extension to <artifactId>.jar. -->
          <execution>
            <id>stage-embedded-bundles</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <!-- Same m2e gate as unpack-manifests-bundle: the IDE incremental builder runs this
                   mojo without a full reactor package, so the reactor jar isn't built yet (MDEP-187).
                   The CLI reactor packages manifests-core before seed-master, so it stages fine. -->
              <skip>${rke2lab.staging.skip}</skip>
              <outputDirectory>${project.build.directory}/generated-resources/META-INF/bundles</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <artifactItems/>
            </configuration>
          </execution>
          <execution>
            <id>unpack-manifests-bundle</id>
            <goals>
              <goal>unpack</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <skip>${rke2lab.staging.skip}</skip>
              <artifactItems>
                <artifactItem>
                  <groupId>io.nxmatic.rke2lab</groupId>
                  <artifactId>manifests-core</artifactId>
                  <version>${rke2lab.version}</version>
                  <classifier>manifests-d</classifier>
                  <type>zip</type>
                  <outputDirectory>${project.build.directory}/generated-resources/META-INF/io.nxmatic/rke2lab/controlplane/incus/manifests</outputDirectory>
                  <overWrite>true</overWrite>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <rke2lab.staging.skip>true</rke2lab.staging.skip>
      </properties>
    </profile>
  </profiles>
</project>
