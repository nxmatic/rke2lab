<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-cli</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>exec/manifests-cli</name>
  <description>Manifests CLI: the executable north-adapter that drives the manifests core
    (osgi/manifests/manifests-core) for ad-hoc synthesis (`java -jar … synthesize`). Boots an
    embedded Felix from the bundles staged in its -exec jar (the same boot seam as seed-master) and
    reads ManifestSynthesisService from the registry — no flat ServiceLoader.</description>

  <dependencies>
    <!-- The host-world boot infrastructure: OsgiRuntime + (transitively) the whole boot stack
         (felix.framework + osgi.core compile, felix.scr + felix.resolver + pax-logging + the
         DS-runtime API runtime). The CLI compiles against OsgiRuntime; the felix/pax jars it only
         stages + installs, never compiles against. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The seam contract the CLI consumes, kept flat on the host classpath as the SINGLE exporter
         (manifests-core imports but does not export it); OsgiRuntime mirrors it onto the system
         bundle so the embedded manifests-core resolves against this one copy — typed access. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The model bundle: embedded INTACT under META-INF/bundles (stage-embedded-bundles below) and
         installed by OsgiRuntime, NOT flattened into the uber-jar (excluded from the shade). runtime
         scope MACHINE-ENFORCES path 2: the CLI compiles only against -port + OsgiRuntime, never
         against a manifests-core impl type — the compiler now forbids the host→impl leak. The stage
         execution + manifests-d unpack still resolve the reactor artifact at runtime scope. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-core</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>

    <!-- The ssh-to-age edge: embedded INTACT under META-INF/bundles (staged below) + installed by
         OsgiRuntime, NOT flattened (excluded from the shade). runtime scope — the CLI never compiles
         against the edge impl; manifests-core's @Reference SshToAgeConverter binds it from the
         registry. Mandatory reference, so the edge MUST be embedded or the service never publishes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>ssh-to-age-edge</artifactId>
      <version>${project.version}</version>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>
    <!-- The host LoggerContext pax-logging-logback reuses (StaticLogbackContext=true), as in
         seed-master: stays flat, it is not a bundle. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
    </dependency>
    <!-- The embedded-Felix CLI-scope test boots the same topology as the deployed jar. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <resources>
      <resource>
        <directory>${project.basedir}/src/main/resources</directory>
        <excludes>
          <exclude>logback.xml</exclude>
        </excludes>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated-resources</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>logback.xml</exclude>
          </excludes>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <mainClass>io.nxmatic.rke2lab.manifests.cli.Main</mainClass>
        </configuration>
      </plugin>
      <!-- Flags + artifact filter inherited from build-parent's managed shade
           execution; only the per-module transformers + the embed-exclusions are declared here. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>shade</goal>
            </goals>
            <phase>package</phase>
            <configuration>
              <!-- Shade excludes DERIVED + injected by the osgi-staging-extension from what the
                   bundles declare — no hand-list. The empty artifactSet is the seam it fills. -->
              <artifactSet>
                <excludes/>
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>logback.xml</resource>
                  <file>${project.basedir}/src/main/resources/logback.xml</file>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.nxmatic.rke2lab.manifests.cli.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <!-- Stage the designed-for-OSGi jars INTACT under META-INF/bundles (a <resource> root, so
               they land in the uber-jar AND on the test classpath). OsgiRuntime.embedded* streams
               each into Felix at boot. The artifactItems are DERIVED + injected by the
               osgi-staging-extension (same closure as the shade excludes), single-sourced. -->
          <execution>
            <id>stage-embedded-bundles</id>
            <goals>
              <goal>copy</goal>
            </goals>
            <phase>generate-resources</phase>
            <configuration>
              <skip>${rke2lab.staging.skip}</skip>
              <outputDirectory>${project.build.directory}/generated-resources/META-INF/bundles</outputDirectory>
              <overWriteReleases>true</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <artifactItems/>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <rke2lab.staging.skip>true</rke2lab.staging.skip>
      </properties>
    </profile>
  </profiles>
</project>
