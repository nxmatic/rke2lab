@startuml
left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

title Systemd Adapter - C4 Container

package "rke2lab" {
  rectangle "controlplane\nJava/Pulumi" as controlplane
  rectangle "systemd-adapter\nSpring Boot" as adapter
  rectangle "manifests\ncdk8s/manifests synthesis" as manifests
}

rectangle "Incus seed instance" as seed
rectangle "systemd manager" as systemd

controlplane --> adapter : optional monitor mode\n(endpoint)
adapter --> systemd : state probe commands\n(target/jobs/failed units)
controlplane --> seed : bootstrap + readiness
manifests --> seed : runtime assets consumed by units
@enduml
