@startuml
skinparam shadowing false

title Systemd Adapter - /status/systemd sequence

actor Caller
participant "SystemdStatusController" as Controller
participant "DbusSystemdStatusSnapshotProvider" as Provider
participant "org.freedesktop.systemd1\n(Properties)" as Dbus

Caller -> Controller : GET /status/systemd
Controller -> Provider : currentSnapshot()

Provider -> Dbus : Get(Unit.ActiveState)
Dbus --> Provider : target state

Provider -> Dbus : Get(Manager.NJobs)
Dbus --> Provider : pending jobs

Provider -> Dbus : Get(Manager.NFailedUnits)
Dbus --> Provider : failed units count

Provider --> Controller : SystemdStatusSnapshot
Controller --> Caller : 200 + JSON snapshot
@enduml
