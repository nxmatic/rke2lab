@startuml
top to bottom direction
skinparam shadowing false
skinparam packageStyle rectangle

title Systemd Adapter - Component View

package "systemd-adapter" {
  rectangle "SystemdAdapterApplication\nSpring bootstrap" as app
  rectangle "SystemdStatusController\n/status/systemd\n/healthz/systemd" as controller
  rectangle "SystemdStatusSnapshotProvider\ninterface" as provider
  rectangle "DbusSystemdStatusSnapshotProvider\ncurrent implementation" as dbusProvider
  rectangle "SystemdAdapterProperties\nmandatoryTarget + timeout" as props
}

rectangle "systemd D-Bus\norg.freedesktop.systemd1" as systemdDbus

app --> controller
controller --> provider
provider <|.. dbusProvider
dbusProvider --> props
dbusProvider --> systemdDbus
@enduml
