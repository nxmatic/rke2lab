@startuml
title Controlnode M4 C4 container view (policy-first + Pulumi initial provisioning)

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

actor "Operator" as operator

rectangle "Pulumi Engine\n<<external>>\nOrchestrates resource plan/apply" as pulumiEngine
rectangle "Incus API/Daemon\n<<external>>\nProject/profile/network/image/instance lifecycle" as incusApi
rectangle "Git Worktree\n<<external>>\nPolicy checks: clean worktree + flake lock coherence" as gitWorktree
rectangle "Shim flake worktree\n<<external>>\nShim build inputs and lock/package outputs" as shimFlakes

package "rke2lab controlnode (Stage A)" {
  rectangle "controlplane.Main\n<<Container>>\nJava / Pulumi\nEntry point; policy-first gate; exports deterministic Stage A outputs" as cpMain
  rectangle "ManifestUpdateGate\n<<Container>>\nServiceLoader API\nEnforces manifest synthesis update gate" as manifestGate
  rectangle "ManifestSynthesisService\n<<Container>>\nServiceLoader provider\nSynthesizes and validates manifests for gate smoke checks" as manifestSynth
  rectangle "BootstrapConfig\n<<Container>>\nJava config model\nResolves canonical Stage A runtime config" as bootstrapCfg
  rectangle "IncusResourceBootstrap\n<<Container>>\nJava orchestration\nApplies Stage A bootstrap: provider resources, seed image, seed instance" as incusBootstrap
  rectangle "PulumiIncusImageProvider\n<<Container>>\nJava helper\nEnsures image fingerprint and checksum-aware image lifecycle" as imageProvider
  rectangle "ClusterReadinessResource\n<<Container>>\nPulumi component\nModels readiness gate and exports readiness contract outputs" as readinessResource
  rectangle "BootstrapRegistryResource\n<<Container>>\nPulumi component\nExports bootstrap registry summary from internal contributor registries" as registryResource
  rectangle "SeedImageBuildResource\n<<Container>>\nPulumi component\nExports seed image build metadata summary" as imageBuildResource
  rectangle "SeedSystemdRuntimeStatusResource\n<<Container>>\nPulumi command-backed component\nExports operator-facing systemd jobs/services runtime status" as systemdRuntimeResource
  rectangle "ClusterBootstrapReadinessVerifier\n<<Container>>\nReadiness helper\nPerforms systemd prechecks + kubeconfig/API/controller readiness checks (or skipped mode)" as readinessVerifier
}

operator --> cpMain : Runs preview/up or standalone
operator --> shimFlakes : Runs shim-build + commits lock updates

cpMain --> pulumiEngine : Uses Pulumi.run(...) when monitor is present
cpMain --> bootstrapCfg : Builds effective bootstrap config
cpMain --> manifestGate : Enforces update gate
manifestGate --> manifestSynth : Loads provider + performs synthesis smoke validation
cpMain --> gitWorktree : Enforces clean worktree + flake-lock coherence
cpMain --> incusBootstrap : Invokes apply() after gates pass
cpMain --> readinessResource : Creates component resource for readiness contract
cpMain --> registryResource : Creates component resource for registry summary contract
cpMain --> imageBuildResource : Creates component resource for image metadata contract
cpMain --> systemdRuntimeResource : Creates component resource for runtime status contract
readinessResource --> readinessVerifier : verify(...) / skipped(...)
registryResource --> incusBootstrap : Consumes layer-env registry snapshot from bootstrap result
imageBuildResource --> incusBootstrap : Consumes image build checksum/fingerprint from bootstrap result
systemdRuntimeResource --> incusApi : Runs runtime status probe via incus exec + systemctl

incusBootstrap --> imageProvider : Ensures seed image fingerprint/checksum
imageProvider --> incusApi : Resolves/creates image alias + fingerprint
incusBootstrap --> incusApi : Ensures project/network/profile + creates/replaces seed instance
cpMain --> operator : Exports Stage A outputs\n(apiEndpoint, kubeconfigRef, seed ids, checksums, handoffReady, readiness/registry/image summaries, systemdRuntimeStatusSummary)
@enduml
