<?plantuml 1.2026.1?><svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" contentStyleType="text/css" data-diagram-type="DESCRIPTION" height="1151px" preserveAspectRatio="none" style="width:5248px;height:1151px;background:#FFFFFF;" version="1.1" viewBox="0 0 5248 1151" width="5248px" zoomAndPan="magnify"><title>Controlnode M4 C4 container view (policy-first + Pulumi initial provisioning)</title><defs/><g><g class="title" data-source-line="1"><text fill="#000000" font-family="sans-serif" font-size="14" font-weight="bold" lengthAdjust="spacing" textLength="603.5449" x="2315.3242" y="22.9951">Controlnode M4 C4 container view (policy-first + Pulumi initial provisioning)</text></g><!--cluster rke2lab controlnode (Stage A)--><g class="cluster" data-qualified-name="rke2lab controlnode .Stage A." data-source-line="14" id="ent0007"><rect fill="none" height="825" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:1;" width="3547.95" x="1016.67" y="128.7369"/><text fill="#000000" font-family="sans-serif" font-size="14" font-weight="bold" lengthAdjust="spacing" textLength="238.7109" x="2671.2895" y="143.732">rke2lab controlnode (Stage A)</text></g><!--entity cpMain--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..cpMain" data-source-line="15" id="ent0008"><rect fill="#F1F1F1" height="85.1875" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:0.5;" width="491.5908" x="1032.67" y="552.1469"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="125.5488" x="1042.67" y="575.142">controlplane.Main</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="85.5449" x="1042.67" y="591.4389">&#171;Container&#187;</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="90.7949" x="1042.67" y="607.7357">Java / Pulumi</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="471.5908" x="1042.67" y="624.0326">Entry point; policy-first gate; exports deterministic Stage A outputs</text></g><!--entity manifestGate--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..manifestGate" data-source-line="16" id="ent0009"><rect fill="#F1F1F1" height="85.1875" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:0.5;" width="306.4805" x="2082.01" y="612.1469"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="143.9785" x="2092.01" y="635.142">ManifestUpdateGate</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="85.5449" x="2092.01" y="651.4389">&#171;Container&#187;</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="126.54" x="2092.01" y="667.7357">ServiceLoader API</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="286.4805" x="2092.01" y="684.0326">Enforces manifest synthesis update gate</text></g><!--entity manifestSynth--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..manifestSynth" data-source-line="17" id="ent0010"><rect fill="#F1F1F1" height="85.1875" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:0.5;" width="438.373" x="3110.76" y="612.1469"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="178.9854" x="3120.76" y="635.142">ManifestSynthesisService</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="85.5449" x="3120.76" y="651.4389">&#171;Container&#187;</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="163.0303" x="3120.76" y="667.7357">ServiceLoader provider</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="418.373" x="3120.76" y="684.0326">Synthesizes and validates manifests for gate smoke checks</text></g><!--entity bootstrapCfg--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..bootstrapCfg" data-source-line="18" id="ent0011"><rect fill="#F1F1F1" height="85.1875" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:0.5;" width="319.1816" x="2075.66" y="732.1469"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="113.1484" x="2085.66" y="755.142">BootstrapConfig</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="85.5449" x="2085.66" y="771.4389">&#171;Container&#187;</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="124.9063" x="2085.66" y="787.7357">Java config model</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="299.1816" x="2085.66" y="804.0326">Resolves canonical Stage A runtime config</text></g><!--entity incusBootstrap--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..incusBootstrap" data-source-line="19" id="ent0012"><rect fill="#F1F1F1" height="85.1875" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:0.5;" width="539.0801" x="3060.41" y="316.1469"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="170.2354" x="3070.41" y="339.142">IncusResourceBootstrap</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="85.5449" x="3070.41" y="355.4389">&#171;Container&#187;</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="127.4629" x="3070.41" y="371.7357">Java orchestration</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="519.0801" x="3070.41" y="388.0326">Applies Stage A bootstrap: provider resources, seed image, seed instance</text></g><!--entity imageProvider--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..imageProvider" data-source-line="20" id="ent0013"><rect fill="#F1F1F1" height="85.1875" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:0.5;" width="465.9697" x="4082.65" y="316.1469"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="186.5117" x="4092.65" y="339.142">PulumiIncusImageProvider</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="85.5449" x="4092.65" y="355.4389">&#171;Container&#187;</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="78.6543" x="4092.65" y="371.7357">Java helper</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="445.9697" x="4092.65" y="388.0326">Ensures image fingerprint and checksum-aware image lifecycle</text></g><!--entity readinessResource--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..readinessResource" data-source-line="21" id="ent0014"><rect fill="#F1F1F1" height="85.1875" rx="2.5" ry="2.5" style="stroke:#181818;stroke-width:0.5;" width="458.4912" x="2006.01" y="492.1469"/><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="186.6006" x="2016.01" y="515.142">ClusterReadinessResource</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="85.5449" x="2016.01" y="531.4389">&#171;Container&#187;</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="131.2568" x="2016.01" y="547.7357">Pulumi component</text><text fill="#000000" font-family="sans-serif" font-size="14" lengthAdjust="spacing" textLength="438.4912" x="2016.01" y="564.0326">Models readiness gate and exports readiness contract outputs</text></g><!--entity registryResource--><g class="entity" data-qualified-name="rke2lab controlnode .Stage A..registryResource" data-source-line="22" id="en