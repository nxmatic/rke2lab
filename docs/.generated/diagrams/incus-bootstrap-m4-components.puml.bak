@startuml
title IncusResourceBootstrap M4 C4 component view

left to right direction
skinparam shadowing false
skinparam packageStyle rectangle

rectangle "controlplane.Main\n<<Container>>\nJava / Pulumi\nPolicy-first entry point" as cpMain
rectangle "Incus API/Daemon\n<<external>>\nProject/network/profile/image/instance lifecycle" as incusApi

package "Incus bootstrap orchestration" {
  rectangle "ApplyPipeline\n<<Component>>\nIncusResourceBootstrap\nCoordinates Stage A steps: resolve paths, host prep, provider resources, seed instance" as applyPipeline
  rectangle "ClasspathAssetMaterializer\n<<Component>>\nBootstrap helper\nMaterializes classpath assets/manifests to local runtime tree" as assetMaterializer
  rectangle "RuntimeEnvControlplaneOverlayWriter\n<<Component>>\nBootstrap helper\nWrites env overlay and captures LayerEnv contributor registry snapshot" as overlayWriter
  rectangle "NodeConfigRegenerator\n<<Component>>\nBootstrap helper\nRegenerates cloud-init payload from runtime secrets" as nodeConfigRegenerator
  rectangle "HostMountSourceVerifier\n<<Component>>\nBootstrap helper\nValidates required host mount sources for Incus disk devices" as sourceVerifier
  rectangle "LaunchSecretsUpdater\n<<Component>>\nBootstrap helper\nEnsures launch secrets token before provisioning" as secretsUpdater
  rectangle "IncusProviderContext\n<<Component>>\nBootstrap helper\nBuilds explicit incus.Provider + invoke options" as providerContext
  rectangle "IncusImportLookup\n<<Component>>\nBootstrap helper\nFinds existing project/network/profile IDs for import/adopt" as importLookup
  rectangle "PulumiIncusImageProvider\n<<Component>>\nImage helper\nEnsures seed image alias/fingerprint and image build checksum" as imageProvider
  rectangle "ProvisioningResourceInventory\n<<Component>>\nBootstrap helper\nComputes deterministic provisioning checksum" as inventoryChecksum
  rectangle "LayerEnvContributorRegistry\n<<Component>>\nManifest layer registry\nDiscovers contributors, orders sections, aggregates env variables" as layerEnvRegistry
}

cpMain --> applyPipeline : Invokes apply()

applyPipeline --> assetMaterializer : materializeIncusAssets / manifests / host units
applyPipeline --> overlayWriter : write env overlay + collect registry snapshot
applyPipeline --> nodeConfigRegenerator : regenerateCloudConfigDir
applyPipeline --> sourceVerifier : ensureSources
applyPipeline --> secretsUpdater : ensureGithubTokenPresent (non-dry-run)
applyPipeline --> inventoryChecksum : Compute seed provisioning checksum
overlayWriter --> layerEnvRegistry : orderedContributors / aggregateContributions

applyPipeline --> providerContext : Create provider context
applyPipeline --> importLookup : Resolve import IDs for adoption
applyPipeline --> imageProvider : ensureSeedImageFingerprint

imageProvider --> incusApi : Read/create image alias + fingerprint
applyPipeline --> incusApi : Ensure project/network/profile + create/replace seed instance
@enduml
