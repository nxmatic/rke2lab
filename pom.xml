<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>rke2lab</artifactId>
  <packaging>pom</packaging>
  <name>rke2lab</name>
  <description>Pulumi-based provisioning management cluster bootstrap app — the reactor
    root. This pom only AGGREGATES; all shared configuration is inherited from
    build-parent (its own parent and first module). The two top-level spaces of the
    target layout — osgi/ (pure core) and host/ (adapters) — are aggregated here.</description>

  <modules>
    <module>build-parent</module>
    <module>bom</module>
    <module>netplan</module>
    <module>systemd-contract</module>
    <module>cdk8s-systemd</module>
    <module>seed-master</module>
    <module>osgi</module>
    <module>host</module>
  </modules>
</project>
