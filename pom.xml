<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.nxmatic.rke2lab</groupId>
  <artifactId>parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>parent</name>
  <description>Pulumi-based provisioning management cluster bootstrap app</description>

  <modules>
    <module>bom</module>
    <module>netplan</module>
    <module>systemd-contract</module>
    <module>cdk8s-systemd</module>
    <module>sdks/incus</module>
    <module>seed-master</module>
    <module>manifests</module>
  </modules>

  <properties>
    <rke2lab.version>0.1.0-SNAPSHOT</rke2lab.version>
    <maven.compiler.release>25</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <maven.jar.plugin.version>3.4.1</maven.jar.plugin.version>
    <build.helper.plugin.version>3.6.1</build.helper.plugin.version>
    <maven.shade.plugin.version>3.6.0</maven.shade.plugin.version>
    <exec.maven.plugin.version>3.6.3</exec.maven.plugin.version>
    <maven.toolchains.plugin.version>3.2.0</maven.toolchains.plugin.version>
    <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
    <spotless.version>3.3.0</spotless.version>
    <shellcheck.maven.plugin.version>0.5.1</shellcheck.maven.plugin.version>
    <google-java-format.version>1.35.0</google-java-format.version>
    <!-- Tracks the flake's nixpkgs shfmt (the toolchain source of truth);
         the nix build also passes -Dshfmt.version=${pkgs.shfmt.version} so the
         spotless gate's binary and config always agree. Bump together. -->
    <shfmt.version>3.12.0</shfmt.version>
  </properties>

  <!--
    Repository resolution order: Maven Central first (always), then the
    internal GH Packages repos as a fallback for io.nxmatic artifacts.

    Why explicit Central before GH Packages:
    Maven asks every <repository> for every artifact in declaration order.
    GH Packages returns HTTP 500 (rather than 404) for unknown artifacts,
    and the response is slow.  Putting Central first means the vast majority
    of dependency lookups (transitive third-party trees) succeed at Central
    and never touch GH Packages — only io.nxmatic artifacts (which Central
    misses) fall through.
  -->
  <repositories>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>central</id>
      <url>https://repo.maven.apache.org/maven2</url>
    </repository>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>github-nxmatic-java-systemd</id>
      <url>https://maven.pkg.github.com/nxmatic/java-systemd</url>
    </repository>
    <repository>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
      <id>github-nxmatic-java-bbox-api-client</id>
      <url>https://maven.pkg.github.com/nxmatic/java-bbox-api-client</url>
    </repository>
  </repositories>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven.compiler.plugin.version}</version>
          <configuration>
            <release>${maven.compiler.release}</release>
          </configuration>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven.jar.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>${build.helper.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>${maven.shade.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>${exec.maven.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-toolchains-plugin</artifactId>
          <version>${maven.toolchains.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven.enforcer.plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>com.diffplug.spotless</groupId>
          <artifactId>spotless-maven-plugin</artifactId>
          <version>${spotless.version}</version>
        </plugin>
        <plugin>
          <groupId>dev.dimlight</groupId>
          <artifactId>shellcheck-maven-plugin</artifactId>
          <version>${shellcheck.maven.plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-toolchains-plugin</artifactId>
        <executions>
          <execution>
            <id>select-jdk-toolchain</id>
            <goals>
              <goal>toolchain</goal>
            </goals>
            <configuration>
              <toolchains>
                <jdk>
                  <version>${maven.compiler.release}</version>
                </jdk>
              </toolchains>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>enforce-build-tooling</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <requireJavaVersion>
                  <version>[${maven.compiler.release},)</version>
                </requireJavaVersion>
                <requireMavenVersion>
                  <version>[3.9.0,)</version>
                </requireMavenVersion>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <configuration>
          <java>
            <includes>
              <include>src/main/java/**/*.java</include>
              <include>src/test/java/**/*.java</include>
            </includes>
            <googleJavaFormat>
              <version>${google-java-format.version}</version>
            </googleJavaFormat>
          </java>
          <shell>
            <includes>
              <include>src/main/resources/**/*.sh</include>
              <include>src/test/resources/**/*.sh</include>
            </includes>
            <shfmt>
              <version>${shfmt.version}</version>
            </shfmt>
          </shell>
          <formats>
            <format>
              <includes>
                <include>AGENTS.md</include>
                <include>README.adoc</include>
                <include>docs/**/*.adoc</include>
                <include>docs/**/*.md</include>
              </includes>
              <trimTrailingWhitespace/>
              <endWithNewline/>
            </format>
          </formats>
          <pom>
            <sortPom>
              <expandEmptyElements>false</expandEmptyElements>
            </sortPom>
          </pom>
        </configuration>
        <executions>
          <execution>
            <id>spotless-apply-on-build</id>
            <goals>
              <goal>apply</goal>
            </goals>
            <phase>process-sources</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
