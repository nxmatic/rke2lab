<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>jgiven-testkit</artifactId>
  <name>osgi/jgiven/jgiven-testkit</name>
  <description>The reusable jGiven-in-OSGi assets a host needs to run BDD scenarios in-container,
    factored out so a host writes one bnd line + one builder call. Two deliverables: (1) the shared
    bnd include jgiven-fragment.bnd — the single forced Import-Package (com.tngtech.jgiven.impl.intercept,
    invisible to bnd's bytecode analysis) plus the Fragment-Host comment shape — so a -test fragment
    inherits it instead of re-declaring it; (2) JGivenTestkit.felix(), a FelixFrameworkExtension
    builder pre-loaded with the jGiven boot closure (bootDelegation(sun.misc) + jgiven-wrap + its
    already-OSGi dependency bundles + the slf4j/junit host packages the wrap imports). Not a bundle —
    a plain jar; the .bnd is a build-time resource on the consumer's bnd path, the helper is test-time
    Java that depends on osgi/testkit. jGiven uses the junit testkit; it is not owned by it.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!--
      The non-regression guard (src/test) boots a real Felix via JGivenTestkit.felix() and walks
      palier 2 (jgiven-wrap reaches ACTIVE) + palier 3 (a scenario runs in-container through the
      probe host, via its -test fragment). These bundles must be on the test classpath so the
      testkit locates them by substring; the probe pair is bnd-built, so the guard exercises the
      REAL fragment manifest the shared include produces.
    -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>jgiven-probe</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>jgiven-probe-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- byte-buddy installed as its own OSGi bundle (it is OSGi-enabled); jgiven-wrap imports it. -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
