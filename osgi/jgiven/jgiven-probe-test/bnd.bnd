Bundle-SymbolicName: io.nxmatic.rke2lab.jgiven.probe.test

# THE fragment header: attach to the host POJO bundle by its BSN, sharing its classloader and
# packages. This and the -include below are the ONLY two lines a real host's -test fragment writes;
# everything else (the forced com.tngtech.jgiven.impl.intercept import, the wildcard tail) comes
# from the shared jgiven-fragment.bnd in jgiven-testkit. This module IS the template doctor copies.
Fragment-Host: io.nxmatic.rke2lab.jgiven.probe

# Test fixture, selected by OutOfContainerFrameworkExtension.installFixtureWithHost via an LDAP filter over
# these attributes — never by a Bundle-SymbolicName literal. The host it attaches to (jgiven-probe)
# is found through the Fragment-Host above, so the test names neither. type=fixture, suite=jgiven
# (the in-container jGiven proof), role=probe (the template host's fragment doctor copies).
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=jgiven; role=probe

-include: ${.}/../jgiven-testkit/src/main/resources/jgiven-fragment.bnd
