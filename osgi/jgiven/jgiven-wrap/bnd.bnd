Bundle-SymbolicName: io.nxmatic.rke2lab.jgiven.wrap

# The whole wrap: stamp OSGi headers onto jgiven-core + jgiven-junit5 — the ONLY two jars in
# jgiven's graph that lack a Bundle-SymbolicName. bnd pulls their packages off the classpath and
# exports them; everything they need is imported.
Export-Package: com.tngtech.jgiven.*;version=2.0.3

# Embed NOTHING. Every jgiven dependency is ALREADY a first-class OSGi bundle — guava
# (com.google.guava), gson (com.google.gson), paranamer (com.thoughtworks.paranamer), jansi
# (org.fusesource.jansi), jakarta.annotation-api, byte-buddy (net.bytebuddy.byte-buddy) — and
# slf4j is owned by pax-logging in the framework. So they all stay IMPORTED and install as their
# own bundles. Embedding any of them private would split its classes from the real bundle and
# hide a legitimate dependency inside ours. The not-OSGi-tail problem simply does not exist here.
# bnd computes Import-Package from the bytecode; the only manual touch is making genuinely
# optional, environment-specific packages (appengine, errorprone, jspecify, sun.misc, …) optional
# so resolution never blocks on annotation noise jgiven never executes.
Import-Package: \
    !com.google.appengine.*, \
    !com.google.apphosting.*, \
    !android.os, \
    !sun.misc, \
    org.jspecify.annotations;resolution:=optional, \
    *

-noimportjava: true
