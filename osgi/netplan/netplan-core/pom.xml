<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>netplan-core</artifactId>
  <name>osgi/netplan/netplan-core</name>
  <description>Network configuration synthesis: typed netplan models rendered to the YAML the host
    network layer consumes. The impl facet of the netplan domain — implements the netplan-port
    port and exposes its api/ for the netplan-cli north-adapter (exec/netplan-cli) to drive; carries
    no exec/shade of its own.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.github.seancfoley</groupId>
      <artifactId>ipaddress</artifactId>
    </dependency>
    <!-- The netplan domain contributes its own diagnostician (NetworkSpecialist) to the doctor: it
         implements the Specialist SPI over the doctor's record vocabulary, published as a @Component
         the health system's tier-scoped @Reference collects. The domain owns its specialist. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-records</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- bnd-consumed construction annotations: @Component declares the DS descriptor bnd generates
         (geste A only — the runtime stays on ServiceLoader until a later slice). -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The shared doctor test fixtures (TestReferrals) for the NetworkSpecialist unit test — the
         Referral comes from the one testkit factory, not re-spelled boilerplate. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-port-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <!-- bnd-process (managed by osgi/bundle-parent) generates the OSGi MANIFEST from bnd.bnd +
           the bytecode; the bare reference opts this library bundle in. The jar plugin below picks
           up that manifest via the inherited manifestFile wiring. -->
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
