-include: ../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.worktree
Export-Package: io.nxmatic.rke2lab.worktree
# type=library — the worktree component both realms genuinely consume: locate the root (jgit walks up
# to the .git) and open the repository rooted there, the single findGitDir door the host (Main +
# entry gate) and the incus scion (provenance) rest on. Like incus-contract-host it is staged as a
# bundle OSGi-side AND kept flat host-side, so its exported package legitimately lives in two realms
# and DUPLICATE_REALM_CLASS exempts it. jgit is in the realm intersection (BSN bundle OSGi-side, flat
# classpath host-side), so REALM_BOUNDARY passes the org.eclipse.jgit references — and no jgit type
# ever enters a SeedEnvelope (the seam is String-only), so nothing crosses the broker. Carries no
# @Component, so it does NOT Require the SCR extender.
Provide-Capability: io.nxmatic.rke2lab.embed; type=library
