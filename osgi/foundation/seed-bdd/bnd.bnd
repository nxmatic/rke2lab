Bundle-SymbolicName: io.nxmatic.rke2lab.osgi.foundation.seed.bdd

# Export ONLY the SOW half. seed.bdd.sow (RunbookSower) is REALM-AGNOSTIC by design — it sows a
# RunbookCoordinate through the broker door and reaps the runbook JSON, holding only the neutral
# seam. The host sows today (embedded, one host); a scion could sow another peer's runbook
# in-container tomorrow (remote — same door, same gesture, § REST embedded-today-remote-tomorrow).
# So this package is exportable for that in-realm reuse.
Export-Package: \
    io.nxmatic.rke2lab.seed.bdd.sow

# The base package io.nxmatic.rke2lab.seed.bdd is NOT exported: it holds the GRAFT half
# (SowAndGraftStage composing ScenarioGraft), the world opening, the Cellar stages, the preflight
# gate. The graft is LOCAL to whoever owns the runbook tree (ScenarioGraft is host-side by
# construction — one jGiven engine, only JSON crosses), so these run on the flat host classpath,
# never wired in-container. Exporting a host-side stage would let a bundle load a second copy of a
# seam class (the DUPLICATE_REALM_CLASS collision the engine's bnd guards against). The split is the
# scenario-engine pattern: export by PACKAGE, not by module — the reusable half travels, the
# tree-local half stays home. See docs/architecture/osgi/seed-bdd-module-spec.adoc.

# jGiven + the framework-launch API are on the flat host classpath where the graft half runs; marking
# the OSGi-facing imports optional keeps the bundle RESOLVABLE when installed in-container to provide
# the exported sow package — exactly the scenario-engine pattern.
# JSpecify annotations are compile-only null metadata, runtime-retained → drop from computed imports.
Import-Package: \
    !org.jspecify.annotations, \
    org.osgi.framework;resolution:=optional, \
    io.nxmatic.rke2lab.osgi.runtime.framework;resolution:=optional, \
    com.tngtech.jgiven.*;resolution:=optional, \
    *

-noimportjava: true
