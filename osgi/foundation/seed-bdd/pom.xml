<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>seed-bdd</artifactId>
  <name>osgi/foundation/seed-bdd</name>
  <description>The common gardening spine every seed exec rebuilds on — the host-side runbook stages
    spoken in the gardening register: the world opening (OsgiConnection), the preflight gate, the
    Cellar fetch/store stages, and the sow-and-graft caller (broker.sow(RunbookCoordinate) + the
    neutral ScenarioGraft). An exec adds only its own root composition (which scions, in what order);
    the stages are shared here. Consumed FLAT by the host: its base package sits on the flat
    classpath, never wired in-container (nothing here plays in Felix — the scions do, in their own
    -bdd bundles). A bundle-parent module so it is a superset of a plain jar (like scenario-engine),
    but it exports nothing today: it has no in-realm half. See
    docs/architecture/osgi/seed-bdd-module-spec.adoc.</description>

  <dependencies>
    <!-- The one door + the neutral coordinate: the sow-and-graft caller resolves SeedBroker and sows
         a RunbookCoordinate(soil); the Cellar stages carry a Parcel/SeedEnvelope. The arrow runs
         FROM seed-bdd TO the seam — depending on it, never entering it. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The host's own codec: the sow-and-graft caller reads the reaped RunbookEnvelope
         GENERICALLY (JsonNode → the "runbook" field), never a domain wire-record. Shaded flat into
         the host classpath, binding to the host's flat jackson. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- The flirt-level mechanics the stages compose: ScenarioGraft (rebuild + graftUnder) and the
         OsgiConnection socle the world-opening stage attaches to. seed-bdd SPEAKS gardening in its
         step titles and calls the engine's neutral mechanics underneath. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- The launcher boot the world-opening stage drives (OsgiConnection.embedded() →
         FrameworkLaunch.embedded()). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
    </dependency>

    <!-- jGiven: the stages ARE jGiven Stages, and ScenarioGraft rebuilds a host-realm ReportModel
         the graft folds. Compile deps; on the flat host classpath at runtime. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The Jupiter API the root scenario declares its extensions with. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>

    <!-- osgi.core: the world-opening stage reads the BundleContext off the connection to resolve the
         SeedBroker. provided — the framework carries it at runtime. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
