-include: ../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.domain.annotations
Export-Package: \
    io.nxmatic.rke2lab.domain.annotations
# Cross-cutting domain annotations, dependency-free so even the type=record leaf may target them and
# no domain couples to another's annotation module. @Transitional (a type still on the OLD model
# while a spec describes its successor) + @GovernedBy(StagingGate, EnforcementLevel) (per-gate reporting
# level for the build-time staging laws). Both read by the staging extension in bytecode. NOT a
# domain itself — carries no model=.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model
