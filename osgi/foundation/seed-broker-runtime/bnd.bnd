-include: ../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.seed.broker.runtime
# Exports NOTHING: the door contract (SeedBroker, SeedHandler) is the seed-broker seam; this
# bundle only IMPLEMENTS it. io.nxmatic.rke2lab.seed.broker.internal (DefaultSeedBroker) is sealed —
# reached only through the seam service the @Component publishes.
Provide-Capability: io.nxmatic.rke2lab.embed; type=runtime
# type=runtime: a neutral runtime MECHANISM — installed AND activated in-framework like a model
# (staged, resolves at the bundle start level so SCR instantiates DefaultSeedBroker and injects the
# @Reference(MULTIPLE) List<SeedHandler>), but belonging to no domain. It exports nothing, so it is
# not a seam and not subject to the leak guard. See maven-embed-staging-ext EmbedCapability#isRuntime.
Service-Component: OSGI-INF/*.xml
