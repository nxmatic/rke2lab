<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>
  <artifactId>gateway-document-codec</artifactId>
  <name>osgi/foundation/gateway-document-codec</name>
  <description>The Document payload codec (DocumentCodec), written once and loaded per realm — our own
    dual-realm library (embed; type=library, jackson's treatment for our code): staged as a bundle
    OSGi-side (importing the OSGi jackson + world-gateway seam, exporting world.gateway.codec) AND
    shaded flat host-side (binding the host jackson). No codec type crosses the String-only seam;
    each realm holds its own copy. See docs/architecture/osgi/world-gateway-spec.adoc.</description>
  <dependencies>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <!-- The wire-records + WireEnum the codec (de)serializes. provided: the world-gateway seam is
         system-exported OSGi-side and flat host-side in BOTH realms, so the codec compiles against
         it and bnd emits an Import-Package for it, but it must NOT be embedded (that would duplicate
         the seam class → a realm collision). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>world-gateway</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
