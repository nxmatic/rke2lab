<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>
  <artifactId>seed-broker-shape</artifactId>
  <name>osgi/foundation/seed-broker-shape</name>
  <description>The amont introspection engine — RecordSchemaProjector, which projects a wire-record's
    JSON Schema (Draft 2020-12) from its RecordComponents via victools. The foundation-generic half
    of the shape meta-coordinate: a domain's ShapeReflector holds the @SeedContract-indexed
    wire-record class and drives this projector, reaping an opaque JSON-Schema String across the
    door. OSGi-ONLY (unlike seed-broker-codec, this is NOT dual-realm): only in-container reflectors
    project; the host reaps the String and never binds victools. So this bundle carries victools (via
    victools-wrap) and stays out of the host uber-jar.</description>
  <dependencies>
    <!-- @Amendment: the binder maps a {role → value} map onto a wire-record's @Amendment components. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- victools as compile deps: the projector IS a SchemaGenerator call. At runtime these packages
         resolve to the victools-wrap bundle, pulled into the live world by this bundle's import
         closure — exactly jGiven's compile-against-artifact / resolve-to-wrap arrangement. -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
    </dependency>
    <!-- victools' generateSchema returns a jackson ObjectNode; we serialize it to the wire String.
         Imported bundle-to-bundle (the OSGi jackson), never embedded. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
