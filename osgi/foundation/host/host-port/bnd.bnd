Bundle-SymbolicName: io.nxmatic.rke2lab.host.port
Export-Package: io.nxmatic.rke2lab.host.port
# The seam: the OSGi world reads these host-access services back out of the embedded framework TYPED
# (or the host composes them), so the system bundle must be the SOLE exporter of this package (one
# exporter = one class, no split). type=seam declares that boot face — the boot system-exports it
# instead of installing it as a bundle, and the leak guard never flags it. A discovery marker, not a
# resolution capability (no Require side).
# See docs/architecture/patterns/port-edge-domain-ownership.adoc § "The boot face".
Provide-Capability: io.nxmatic.rke2lab.embed; type=seam
# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
