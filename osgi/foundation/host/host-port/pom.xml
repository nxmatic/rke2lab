<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>host-port</artifactId>
  <name>osgi/foundation/host/host-port</name>
  <description>The host-access seams: neutral, flat-in/flat-out contracts by which the OSGi world reads
    and writes the host it runs on — GitFactsReader (jgit worktree facts), SecretsSource (the worktree
    .secrets bytes), HostPathResolver (the NFS-automount path topology), ArtifactSink (rendered-artifact
    writes). Each answers or acts on flat values; none carries a Pulumi or host type. type=seam:
    system-exported, one shared copy across the host↔bundle boundary, like every -port.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <!-- bnd execution + jar manifestFile inherited from osgi/bundle-parent; the bare
       reference activates the managed bnd-process goal for this library bundle. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
