Bundle-SymbolicName: io.nxmatic.rke2lab.junit.testkit

# Exported, importable by a host -test fragment: the in-container runner, and the diagnostic helpers
# (ScrDiagnostics & siblings) a test calls to explain a wiring failure. The JVM-side extension half
# stays unexported (it is used on surefire's flat classpath, never imported as a bundle package).
Export-Package: \
    io.nxmatic.rke2lab.junit.testkit.container, \
    io.nxmatic.rke2lab.junit.testkit.diagnostic

# The JVM-side half (OutOfContainerFrameworkExtension) pulls the framework-launch API + felix + the shared
# boot-discovery model + slf4j (the resolution-failure diagnostic logger), none of which exist inside
# the framework. The SCR runtime API (ScrDiagnostics) is present only when a test boots SCR. They are
# needed only when this jar runs on surefire's flat classpath (where they are present); marking them
# optional lets the bundle still RESOLVE when installed in-container to provide the runner package —
# a consumer that has no slf4j provider (e.g. a non-jGiven in-container test) still wires. A bundle is
# a superset of a plain jar — this keeps both uses true from one artifact.
Import-Package: \
    org.osgi.framework.launch;resolution:=optional, \
    org.apache.felix.framework.util;resolution:=optional, \
    org.osgi.service.component.runtime;resolution:=optional, \
    org.osgi.service.component.runtime.dto;resolution:=optional, \
    io.nxmatic.rke2lab.osgi.boot.discovery;resolution:=optional, \
    io.nxmatic.rke2lab.osgi.bnd;resolution:=optional, \
    org.slf4j;resolution:=optional, \
    *

-noimportjava: true
