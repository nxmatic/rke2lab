<!-- @codebase -->
<!--
  Ships systemd assets to seed-master.

  The cdk8s-synthesized k8s manifests (e.g. manifests.d/networking/kdns/*.yml)
  are produced at pulumi-up time via ManifestSynthesisService, not here. This
  zip carries only the host-systemd assets (units + scripts) that systemd
  consumes from /srv/host/systemd-{units,scripts,libexec}.d/ and that don't
  go through cdk8s synthesis.

  Layer-side classpath resources (e.g. runtime/flox/**) ride along on the
  manifests jar itself; FloxRuntimeAssets and friends read them via
  Class.getResourceAsStream from seed-master's classpath.
-->
<assembly xmlns="http://maven.apache.org/ASSEMBLY/2.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/ASSEMBLY/2.2.0 https://maven.apache.org/xsd/assembly-2.2.0.xsd">
  <id>manifests-d</id>
  <formats>
    <format>zip</format>
  </formats>
  <includeBaseDirectory>false</includeBaseDirectory>

  <fileSets>
    <fileSet>
      <directory>${project.basedir}/src/main/resources/systemd</directory>
      <outputDirectory>systemd</outputDirectory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>
    <fileSet>
      <directory>${project.build.directory}/generated-resources/systemd</directory>
      <outputDirectory>systemd</outputDirectory>
      <includes>
        <include>**/*</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
