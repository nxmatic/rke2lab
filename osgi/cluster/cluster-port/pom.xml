<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cluster-port</artifactId>
  <name>osgi/cluster/cluster-port</name>
  <description>The cluster domain's seam: the readiness vocabulary and the neutral cluster-contact
    contract the edge satisfies. It carries the canonical readiness phases, the typed schema refs the
    cluster specialist reasons with, the neutral controller reference, and the ClusterReadinessContact
    — point-in-time cluster facts (API readiness, controller effectiveness) the host composes and the
    cluster-edge provides by shelling kubectl. type=seam: system-exported, one shared copy across the
    host↔bundle boundary, like every -port.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The doctor's value vocabulary: ClusterSchemaRef yields SchemaRef, the shape an Assessment
         carries. The port speaks the doctor's records, the natural cross-domain value dependency. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-records</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <!-- bnd execution + jar manifestFile inherited from osgi/bundle-parent; the bare
       reference activates the managed bnd-process goal for this library bundle. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
