Bundle-SymbolicName: io.nxmatic.rke2lab.cluster.edge
# Self-declares this jar as an embeddable EDGE bundle (scanned + installed under META-INF/bundles by
# the same io.nxmatic.rke2lab.embed capability as the other carriers). See dbus-systemd-edge.
Provide-Capability: io.nxmatic.rke2lab.embed; type=edge; edge=cluster

# No -includeresource: this edge embeds NOTHING. The kubectl contact is pure ProcessBuilder over the
# JDK — no transport ServiceLoader, no nested jars (the dbus-systemd edge needed three; this one none).
-noimportjava: true
