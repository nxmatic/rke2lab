<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cluster-core</artifactId>
  <name>osgi/cluster/cluster-core</name>
  <description>The cluster domain's in-world model facet: it contributes the cluster diagnostician
    (ClusterSpecialist) to the doctor as a Declarative Services @Component over the doctor's
    Specialist SPI. The cluster domain owns its specialist — it reasons about kubeconfig /
    control-plane readiness — so it lives here, not in doctor-core. A type=model embeddable bundle;
    its impl package is non-exported (the specialist crosses as the Specialist service).</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The cluster domain's own port: ClusterSchemaRef single-sources the "cluster/*/v1" schema refs
         the specialist carries on its assessments. The natural direction — the domain depends on its
         own seam. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>cluster-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The doctor's inter-domain SPI (Specialist + ClinicianProperties) and its record vocabulary:
         the cluster domain implements the SPI to plug its diagnostician into the doctor. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-records</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- bnd-consumed DS annotations: @Component declares the SCR descriptor bnd generates. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The shared doctor test fixtures (TestReferrals) for the ClusterSpecialist unit test — the
         Referral comes from the one testkit factory, not re-spelled boilerplate. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-port-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
