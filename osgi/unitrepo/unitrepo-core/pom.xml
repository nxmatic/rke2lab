<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>unitrepo-core</artifactId>
  <name>osgi/unitrepo/unitrepo-core</name>
  <description>The unit resolution oracle: resolves UnitResource capability graphs through an
    injected OSGi Resolver service over the org.osgi.service.resolver interface.</description>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <!-- felix.resolver is the org.osgi.service.resolver.Resolver PROVIDER: at runtime its bundle
         activator registers the service that UnitResolver consumes, so production imports only the
         OSGi interface (carried by osgi.core 8.0.0) — felix.resolver is needed only on the TEST
         classpath, where tests construct their own ResolverImpl to inject. It drags
         org.osgi.core:5.0.0 (a pre-R6 org.osgi.framework whose FrameworkUtil lacks
         asDictionary(Map)) which would shadow osgi.core:8.0.0 and break framework.init(); excluded. -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.resolver</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.osgi</groupId>
          <artifactId>org.osgi.core</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <!-- bnd execution + jar manifestFile inherited from osgi/bundle-parent; the bare
       reference activates the managed bnd-process goal. -->
  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
