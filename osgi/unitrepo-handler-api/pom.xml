<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>unitrepo-handler-api</artifactId>
  <name>osgi/unitrepo-handler-api</name>
  <description>The handler SPI bundle: the UnitHandler contract a unit binds to via its constitutive
    osgi.extender requirement; provides the unitrepo.handler extender capability.</description>

  <dependencies>
    <!-- bnd-consumed construction annotation: @Capability declares the Provide bnd generates -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.annotation.bundle</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <!-- bnd execution + jar manifestFile inherited from osgi/bundle-parent; the bare
       reference activates the managed bnd-process goal. -->
  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
