<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>dbus-systemd-edge</artifactId>
  <name>osgi/systemd/dbus-systemd-edge</name>
  <description>The dbus-systemd external edge: the single door toward the systemd dbus-on-TCP endpoint
    of the running master node. It @Component-provides the systemd domain's SystemdRuntimeProbe seam
    (systemd-port) by speaking dbus over TCP. TCP is playable in OSGi, so this edge lives in the OSGi
    world (the first edge both extracted and migrated). It EMBEDS dbus-java-core + transport-tcp +
    java-systemd on its private classpath so the transport ServiceLoader resolves inside one bundle
    classloader, with no SPI-Fly and no leak onto the system bundle.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>systemd-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- Embedded INTACT into the bundle (see bnd.bnd -includeresource): used ONLY by this edge,
         so the transport ServiceLoader lookup and the TcpTransportProvider share one classloader. -->
    <dependency>
      <groupId>com.github.thjomnx</groupId>
      <artifactId>java-systemd</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.hypfvieh</groupId>
      <artifactId>dbus-java-transport-tcp</artifactId>
    </dependency>

    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The boot test: OutOfContainerFrameworkExtension boots a real Felix, runs SCR, installs THIS
         edge by its embed capability, and exercises the published probe. Out-of-container, no
         fragment (the seam type is exported; no white-box access needed). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- junit-jupiter (test) is inherited from build-parent. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- withScr(): felix.scr + the DS-API trio it wires to, bundle-to-bundle, on the test classpath. -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
