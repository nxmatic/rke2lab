Bundle-SymbolicName: io.nxmatic.rke2lab.systemd.cdk8s.manifests

# Role inversion: systemd OWNS the cdk8s rendering of its own units (SystemdChart/Service/Unit/…) —
# its classes live under the systemd root package (io.nxmatic.rke2lab.systemd.cdk8s), so no split
# package with the manifests host can ever arise — but it CONTRIBUTES that rendering to the manifests
# domain by attaching to its cdk8s carrier. The Fragment-Host is manifests-cdk8s, so this fragment
# shares that carrier's classloader and reaches org.cdk8s/software.constructs straight off its
# Bundle-ClassPath — no Import-Package for the flat cdk8s closure. Its vocabulary
# (io.nxmatic.rke2lab.systemd.cdk8s) is contributed to the host's exports, where manifests-core
# imports it.
Fragment-Host: io.nxmatic.rke2lab.manifests.cdk8s
Export-Package: io.nxmatic.rke2lab.systemd.cdk8s

-noimportjava: true
