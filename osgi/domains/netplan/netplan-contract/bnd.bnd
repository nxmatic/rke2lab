-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.netplan.contract
Export-Package: io.seedmatic.rke2lab.netplan.contract
# type=contract — the netplan domain's vocabulary (the network blueprint + its value types, and the
# synthesis service verb + its request/result, fused from the former netplan.port + netplan.api into
# one package). Installed bundle-side and wired bundle-to-bundle, NOT a seam: the host no longer
# reads a blueprint back TYPED — it speaks only to the broker. netplan-core provides the synthesis
# impl. It carries no @Component, so it does NOT Require the SCR extender. The contract-purity guard
# fails the build if this bundle exports a concrete class. Supersedes the dissolved netplan-port
# seam (both its packages).
Provide-Capability: io.seedmatic.rke2lab.embed; type=contract
