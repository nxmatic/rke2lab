Bundle-SymbolicName: io.nxmatic.rke2lab.netplan.port
Export-Package: \
    io.nxmatic.rke2lab.netplan.port,\
    io.nxmatic.rke2lab.netplan.api
# The seam: the flat host reads these -port services back out of the embedded framework TYPED, so the
# system bundle must be the SOLE exporter of these packages (one exporter = one class, no split).
# type=seam declares that boot face — the boot system-exports it instead of installing it as a bundle,
# and the leak guard never flags it. A discovery marker, not a resolution capability (no Require side).
# See docs/architecture/patterns/port-edge-domain-ownership.adoc § "The boot face".
Provide-Capability: io.nxmatic.rke2lab.embed; type=seam
# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
