<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>ghapp-contract</artifactId>
  <name>osgi/domains/ghapp/ghapp-contract</name>
  <description>The ghapp domain's contract: the sealed GitHubApp credentials cellar case
    (GithubAppCredentials + GhAppCoordinate), the GithubAppMinter verb (mint a scoped installation
    token from those credentials), and its TokenScope / MintedToken vocabulary. The ghapp-edge
    satisfies the minter by signing a JWT and calling the GitHub installation-token API. type=contract:
    installed bundle-side and wired bundle-to-bundle, not system-exported.</description>

  <dependencies>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- SeedContract / SeedCoordinate for the sealed GitHubApp cellar case the registration seals
         and the writer + reader render consume. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
