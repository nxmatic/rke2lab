-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.ghapp.contract
Export-Package: io.seedmatic.rke2lab.ghapp.contract
# type=contract — the ghapp domain's vocabulary (the GithubAppMinter verb + the sealed
# GithubAppCredentials cellar case + TokenScope / MintedToken). Installed bundle-side and wired
# bundle-to-bundle, NOT a seam. The ghapp-edge satisfies the minter by signing a JWT and calling the
# GitHub installation-token API. It carries no @Component, so it does NOT Require the SCR extender.
# The contract-purity guard fails the build if this bundle exports a concrete class.
Provide-Capability: io.seedmatic.rke2lab.embed; type=contract
