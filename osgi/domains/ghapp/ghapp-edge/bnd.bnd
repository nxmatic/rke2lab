-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.ghapp.edge
# An embeddable EDGE bundle (scanned + installed under META-INF/bundles by the io.seedmatic.rke2lab.embed
# capability). The GitHub-API contact: signs the App JWT (BouncyCastle reads the PEM, the JDK signs) and
# mints scoped installation tokens, and drives the manifest-flow conversion over a raw loopback
# ServerSocket. jackson + org.bouncycastle.* are plain Import-Package (their own first-class bundles,
# staged beside this one — the guava/gson treatment), never embedded. HttpClient / ServerSocket are
# java.* / boot-delegated, so no system.packages.extra cost.
Provide-Capability: io.seedmatic.rke2lab.embed; type=edge; edge=ghapp
