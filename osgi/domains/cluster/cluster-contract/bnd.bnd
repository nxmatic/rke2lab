Bundle-SymbolicName: io.nxmatic.rke2lab.cluster.contract
Export-Package: io.nxmatic.rke2lab.cluster.contract
# type=contract — the cluster domain's readiness vocabulary + the neutral ClusterReadinessContact the
# edge satisfies. Installed bundle-side and wired bundle-to-bundle, NOT a seam: the host no longer
# reads the contact back TYPED — it speaks only to the broker. The cluster-edge provides the contact
# by shelling kubectl. It carries no @Component, so it does NOT Require the SCR extender. The
# contract-purity guard fails the build if this bundle exports a concrete class. Supersedes the
# dissolved cluster-port seam.
Provide-Capability: io.nxmatic.rke2lab.embed; type=contract
# JSpecify annotations are compile-only null metadata, runtime-retained → drop from computed imports.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
