Bundle-SymbolicName: io.nxmatic.rke2lab.cluster.bdd.test

# THE fragment header: attach to the cluster-bdd bundle by its BSN, sharing its classloader and
# package (io.nxmatic.rke2lab.cluster.bdd). The passenger, authored in that same package, thus
# registers its mock ClusterReadinessContact + doctor ConsultingService on the SAME loader the
# scenario resolves against — the mock IS the same Class, so no seam and no system-export are needed
# (the whole point of testing in-container).
Fragment-Host: io.nxmatic.rke2lab.cluster.bdd

# Test fixture, selected by OutOfContainerFrameworkExtension via an LDAP filter over these attributes
# — never by a Bundle-SymbolicName literal. Its host (cluster-bdd) is found through the Fragment-Host
# above. type=fixture, suite=cluster, role=bdd (the in-container passenger that plays the scenario).
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=cluster; role=bdd

# jGiven runs in-container (the scenario is a jGiven ScenarioTest played through the front-door): the
# shared include carries the one forced com.tngtech.jgiven.impl.intercept import + the
# com.tngtech.jgiven.* tail + the trailing * wildcard. Everything else this fragment needs is computed
# by bnd from bytecode and captured by that wildcard: org.junit.jupiter.engine (ClusterBddTests names
# JupiterTestEngine.class), the scenario-engine runner, the cluster/doctor/seed-broker contracts. So
# no manual Import-Package here — the include's wildcard suffices.
-include: ${.}/../../../runtime/scenario-testkit/src/main/resources/jgiven-fragment.bnd

-noimportjava: true
