-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.cluster.edge.test

# THE fragment header: attach to the cluster-edge bundle by its BSN, sharing its classloader and
# package (io.nxmatic.rke2lab.cluster.edge). The passenger, authored in that same package, resolves
# the edge's SCR-published ClusterReadinessContact from the SAME realm it lives in and calls it TYPED
# — no seam, no system-export of cluster.contract (which would legitimize doing the same in the live
# boot). The test posture matches the live posture: in-container, wired bundle-to-bundle.
Fragment-Host: io.nxmatic.rke2lab.cluster.edge

# Test fixture, selected by OutOfContainerFrameworkExtension via an LDAP filter over these attributes
# — never by a Bundle-SymbolicName literal. Its host (cluster-edge) is found through the Fragment-Host
# above. type=fixture, suite=cluster, role=edge (the in-container passenger that resolves + exercises
# the SCR-published contact).
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=cluster; role=edge

# No jGiven here (this is a plain Jupiter passenger, not a ScenarioTest). Everything the fragment
# needs — org.junit.jupiter.engine (ClusterEdgeTests names JupiterTestEngine.class), jupiter.api, the
# scenario-engine runner, cluster.contract (the contact it calls, resolved through the host) — is
# computed by bnd from bytecode and captured by the trailing * wildcard.
