<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-test-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-test-parent/pom.xml</relativePath>
  </parent>

  <artifactId>cluster-edge-test</artifactId>
  <name>osgi/domains/cluster/cluster-edge-test</name>
  <description>The -test fragment of cluster-edge: a Fragment-Host attached to the cluster-edge bundle,
    sharing its classloader so its passenger resolves the SCR-published ClusterReadinessContact from
    the edge's OWN realm and calls it TYPED — no seam, no system-export of cluster.contract. Proves
    the edge activates and behaves in-container, the posture the live boot uses. The src/test
    @OsgiWorld proxy boots Felix, installs the edge + this fragment + the contract closure, resolves,
    and drives the passenger from inside.</description>

  <dependencies>
    <!-- The host under test: the edge @Component. provided — the fragment is pure test bytecode that
         resolves against the cluster-edge host at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>cluster-edge</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The contact the passenger resolves + calls typed (ClusterReadinessContact + ControllerRef).
         DE-SEAMED (installed bundle): pulled through the host closure at runtime, provided here. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>cluster-contract</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The generic in-container runner the fragment's entry delegates to (InContainerJUnitRunner).
         provided — resolved through the cluster-edge host at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- fabric8-wrap + its hard import closure, on the TEST classpath so installImportClosureOf can
         install them into the boot Felix: cluster-edge now imports io.fabric8.* (exported by the
         wrap), and the wrap itself imports jackson + BouncyCastle + snakeyaml-engine. Without them
         the edge does not RESOLVE in-container and its @Component never publishes the contact.
         snakeyaml-engine rides in transitively via the wrap; jackson + BC are declared explicitly
         (the wrap embeds the fabric8 jars provided, so they are not transitive from it). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>fabric8-wrap</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.datatype</groupId>
      <artifactId>jackson-datatype-jsr310</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcprov-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.bouncycastle</groupId>
      <artifactId>bcpkix-jdk18on</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- osgi.core (test): the passenger + proxy name framework types (FrameworkUtil, BundleContext). -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- the src/test @OsgiWorld proxy boots Felix + installs the JUnit bundle world (via withScr +
         the runner), and SCR must run so the edge @Component publishes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
