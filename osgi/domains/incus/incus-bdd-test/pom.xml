<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-test-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-test-parent/pom.xml</relativePath>
  </parent>

  <artifactId>incus-bdd-test</artifactId>
  <name>osgi/domains/incus/incus-bdd-test</name>
  <description>The -test fragment of incus-bdd: a Fragment-Host attached to the incus-bdd bundle,
    sharing its classloader so its passenger runs IN-CONTAINER and the mocks it registers (ImageBuilder
    + IncusInstanceContact + RunGate + a doctor ConsultingService) are the SAME Class the scenario
    resolves — no seam, no system-export. The passenger registers the mocks in the shared registry,
    plays the scenario through IncusBddScenarios.run() (the production front-door), and asserts on the
    harvested RunbookEnvelope. The src/test @OsgiWorld proxy boots Felix, attaches this fragment, and
    drives the passenger from inside.</description>

  <dependencies>
    <!-- The host under test: the scenario + the front-door. provided — the fragment is pure test
         bytecode that resolves against the incus-bdd host at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-bdd</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The vocabulary the mocks + assertions speak: both incus contacts + their request records,
         the RunGate, the doctor's ConsultingService, the SeedEnvelope the consult rides. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-contract</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The netplan synthesis service + blueprint the mock NetplanSynthesisService delegates to
         (the scion resolves it for the_network_is_resolved). provided — resolved through the host. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- IncusAmendReflectorTest names IncusAmendReflector directly (@Component), so javac must read
         the @Component annotation off its class file to compile the reference. provided — SCR
         supplies it at runtime; the test only needs it on the compile classpath. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- the passenger decodes the harvested RunbookEnvelope + the consultation payloads with jackson. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The generic in-container runner the fragment's entry delegates to (JUnitLauncherCore /
         InContainerJUnitRunner). Provided — resolved through the incus-bdd host at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- the fragment's src/main entry names framework types + the in-container runner directly, drives
         the incus-core host white-box, and asserts on the doctor's wire contract; provided — all
         resolved through the incus-bdd host at runtime. -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-launcher</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-contract</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Jupiter, the engine, jgiven-junit5, junit-platform-launcher are inherited from
         bundle-test-parent. osgi.core (test): the passenger + proxy name framework types directly. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- the src/test @OsgiWorld proxy boots Felix via JGivenTestkit.felix() and installs the JUnit +
         jGiven bundle worlds by classpath substring, so they must be on the TEST classpath. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
