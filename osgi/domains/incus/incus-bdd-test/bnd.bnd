-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.incus.bdd.test

# THE fragment header: attach to the incus-bdd bundle by its BSN, sharing its classloader and package
# (io.nxmatic.rke2lab.incus.bdd). The passenger, authored in that same package, registers its mock
# ImageBuilder + IncusInstanceContact + RunGate on the SAME loader the scenario resolves against —
# the mock IS the same Class, so no seam and no system-export are needed (the whole point of testing
# in-container).
Fragment-Host: io.nxmatic.rke2lab.incus.bdd

# Test fixture, selected by OutOfContainerFrameworkExtension via an LDAP filter over these attributes
# — never by a Bundle-SymbolicName literal. Its host (incus-bdd) is found through the Fragment-Host
# above. type=fixture, suite=incus, role=bdd (the in-container passenger that plays the scenario).
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=incus; role=bdd

# jGiven runs in-container (the scenario is a jGiven ScenarioTest played through the front-door): the
# shared include carries the one forced com.tngtech.jgiven.impl.intercept import + the
# com.tngtech.jgiven.* tail + the trailing * wildcard. Everything else this fragment needs is computed
# by bnd from bytecode and captured by that wildcard: org.junit.jupiter.engine (IncusBddTests names
# JupiterTestEngine.class), the scenario-engine runner, the incus/doctor/seed-broker contracts. So no
# manual Import-Package here — the include's wildcard suffices.
-include: ${.}/../../../runtime/scenario-testkit/src/main/resources/jgiven-fragment.bnd

