-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.incus.core

Export-Package: io.seedmatic.rke2lab.incus.core
# type=model — the incus domain's in-container LOGIC: the grow-view projectors (GrowNetworkResolver /
# GrowIdentityResolver / GrowPlanAssembler the provision scion assembles the InstanceGrowPlan from)
# and the launch-secrets writer. Driven by the incus scenarios in-container — nothing crosses to the
# host. No @Component (the rendered-branch refactor retired the host-tree promotion that held them).
Provide-Capability: io.seedmatic.rke2lab.embed; type=model; model=incus-core
