<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>incus-core</artifactId>
  <name>osgi/domains/incus/incus-core</name>
  <description>The incus domain's host-tree logic: the tree incus mounts is incus's (rke2-manifests.d
    is one folder among many), so the slot rotation (HostSlotSelector), the cellar-timeline fold
    (HostTreeHead), the two deltas (HostTreeDiffer / HostTreeDelta / HostTreeDeltaRenderer) and the
    per-file checksum (HostTreeChecksummer) live here — pure Java driven by the incus scenarios.
    type=model — installed as a bundle, wired bundle-to-bundle to the scion. The host-tree
    vocabulary (Host*Entry) lives in incus-contract; this module holds only the logic.</description>

  <dependencies>
    <!-- The host-tree wire-records the fold decodes + the entries the CRUD writes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-contract</artifactId>
    </dependency>
    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header. incus-core
         declares its FIRST services here — the HostTreePromoter cultivating/surveying pair — because
         the jsync ACT is embedded in this bundle, so the live door lives where jsync does. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The flat grow views the scion projects (GrowNetworkView): GrowNetworkResolver assembles it. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-ingress-contract</artifactId>
    </dependency>
    <!-- The netplan blueprint + synthesis service GrowNetworkResolver reads to project the NIC hwaddrs
         and the dnsmasq config the per-cluster bridge carries. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
    </dependency>
    <!-- The codec the fold uses to decode the cellar-timeline envelopes. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- SeedEnvelope is imported directly (not only via seed-broker-codec) — declare the port. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- The auth port LaunchSecretsWriter asks for the gh/flox token (§ provisioning-slice #10):
         the value crosses via AuthTokenContact, realised by auth-edge (gh/flox CLI). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>auth-contract</artifactId>
    </dependency>
    <!-- OBSERVE: the per-file line-level unified diff of a modified text file (HostTreeDiffer). -->
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
    </dependency>
    <!-- ACT: HostTreePromoter jsyncs a staging into host.live.d. jsync ships a nu manifest (no BSN),
         so it cannot be imported as a bundle — it is EMBEDDED in this bundle's Bundle-ClassPath
         (bnd -includeresource;lib:=true), one consumer, no *-wrap module. -->
    <dependency>
      <groupId>com.fizzed</groupId>
      <artifactId>jsync-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.fizzed</groupId>
      <artifactId>jsync-vfs</artifactId>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- InMemoryCellar: the test double HostSlotSelectorTest seeds host-staging / host-live cases
         into (the cellar is the selector's state now, not the filesystem). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
