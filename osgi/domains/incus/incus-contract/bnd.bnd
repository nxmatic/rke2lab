Bundle-SymbolicName: io.nxmatic.rke2lab.incus.contract
Export-Package: io.nxmatic.rke2lab.incus.contract
# type=contract — the incus domain's vocabulary (the instance-contact + image-builder verbs and their
# request/exception value types). Installed bundle-side and wired bundle-to-bundle, NOT a seam: the
# host no longer reads a probe result back TYPED — it speaks only to the broker. The incus-edge
# satisfies the verbs by shelling incus/distrobuilder. It carries no @Component, so it does NOT
# Require the SCR extender. The contract-purity guard fails the build if this bundle exports a
# concrete class. Supersedes the dissolved incus-port seam.
Provide-Capability: io.nxmatic.rke2lab.embed; type=contract
# JSpecify annotations are compile-only null metadata, runtime-retained → drop from computed imports.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
