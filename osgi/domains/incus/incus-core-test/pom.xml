<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-test-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-test-parent/pom.xml</relativePath>
  </parent>

  <artifactId>incus-core-test</artifactId>
  <name>osgi/domains/incus/incus-core-test</name>
  <description>The -test fragment of incus-core: a Fragment-Host attached to the incus-core bundle,
    sharing its classloader so its actor tests run IN-CONTAINER. This is the CROSS-DOMAIN integration
    home of the host-asset seam — the ONE place both worlds meet in a single Felix: incus-core (the
    BootstrapHostAssetMaterializer @Component, driver) AND manifests-core with its whole synthesis
    graph (the three HostAssetProvider @Components, contributors). It proves what neither domain's own
    tests can: that the materializer's @Reference(MULTIPLE) actually binds the manifests providers SCR
    publishes (the wiring that broke before), and that a real contribute→materialize round-trip places
    the synthesised slices into the instance's staging tree. incus-bdd-test deliberately EXCLUDES
    manifests-core to keep the scion pure; this module is its reciprocal.</description>

  <dependencies>
    <!-- The host under test: the materializer + BootstrapPaths logic. provided — the fragment is
         pure test bytecode that resolves against the incus-core host at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The vocabulary the actor test speaks: BootstrapPaths (the slot roots it asserts on). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-ingress-contract</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The seam face: HostAssetProvider + the contribution vocabulary the test names. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-contract</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The seed-broker seam incus-core + manifests-core import (SeedHandler reflectors, codec). On
         the classpath so installImportClosureOf can stage the providers of seed.broker.port. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The src/test harness boots Felix via ScenarioTestkit.felix() and installs the JUnit + jGiven
         bundle worlds by classpath substring, so they must be on the TEST classpath. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- osgi.core (test): the harness names framework types (Bundle, BundleContext) directly. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- incus-core's own runtime graph, installed as bundles in-container by the probe so the host
         resolves: the sibling contracts + the third-party libraries incus-core imports (jsync is
         embedded in incus-core, so it is NOT listed here). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>incus-contract</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>auth-contract</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.java-diff-utils</groupId>
      <artifactId>java-diff-utils</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- The CONTRIBUTOR graph: manifests-core + everything it needs to resolve, installed as bundles
         in-container so SCR activates the three HostAssetProvider @Components the materializer binds.
         The same closure manifests-core-test stages (the cdk8s carrier + its systemd fragment, the
         sibling ports, the pipeline engine, unitrepo-core, the third-party OSGi bundles). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>systemd-cdk8s-manifests</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>systemd-contract</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>unitrepo-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>victools-wrap</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-annotations</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.dataformat</groupId>
      <artifactId>jackson-dataformat-yaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.yaml</groupId>
      <artifactId>snakeyaml</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.commons</groupId>
      <artifactId>commons-compress</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.github.seancfoley</groupId>
      <artifactId>ipaddress</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
