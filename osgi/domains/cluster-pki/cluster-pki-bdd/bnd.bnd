-include: ../../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.nxmatic.rke2lab.clusterpki.bdd

# A type=model embeddable bundle (scanned + installed under META-INF/bundles by the
# io.nxmatic.rke2lab.embed capability, like the other domain carriers). isDomain, so StagingClosure
# stages its import closure — this is how jgiven-wrap and its tail, plus the cluster-pki-core /
# contract / manifests-contract / scenario-engine bundles it imports, enter the LIVE world.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=cluster-pki-bdd

# No Export-Package: the scenario class is bundle-private, played by class-selection; the handler is
# resolved through the SeedHandler seam. Nothing crosses a realm boundary.

# ClusterPkiRunbookHandler (@Component) publishes the runbook SeedHandler serving
# RunbookCoordinate("cluster-pki") — the broker's host-to-scion door whose handle() plays THIS
# bundle's scenario in-container. SCR reads Service-Component; the wildcard picks up the descriptor.
Service-Component: OSGI-INF/*.xml

# jGiven's runtime-woven packages, invisible to bnd's bytecode analysis (byte-buddy DEFINES the
# stage proxies into these at runtime), forced exactly as incus-bdd / the -test fragments do.
Import-Package: \
    ${annotation-noimports}, \
    com.tngtech.jgiven.impl, \
    com.tngtech.jgiven.impl.intercept, \
    com.tngtech.jgiven.*, \
    *
