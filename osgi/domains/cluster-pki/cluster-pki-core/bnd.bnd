-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.clusterpki.core

# The CA-hierarchy generator, the only export — the seal scion (cluster-pki-bdd) imports it and
# drives it bundle-to-bundle.
Export-Package: io.nxmatic.rke2lab.clusterpki.core

# type=model — the cluster-pki domain's CA logic, installed as a native bundle beside the scion.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=cluster-pki-core

# BouncyCastle is NOT embedded: it carries its own Bundle-SymbolicName + OSGi headers (1.85), so it
# installs as its OWN bundle in the runtime (the third-party-BSN path, provided scope in the pom).
# org.bouncycastle.* is therefore a plain Import-Package, computed from the bytecode by the `*`
# above — the guava/gson treatment, not the header-less cdk8s/jsync lib:=true embed.
