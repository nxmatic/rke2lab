-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.systemd.cdk8s.manifests

# Role inversion: systemd OWNS the cdk8s rendering of its own units (SystemdChart/Service/Unit/…) —
# its classes live under the systemd root package (io.nxmatic.rke2lab.systemd.cdk8s), so no split
# package with the manifests host can ever arise — but it CONTRIBUTES that rendering to the manifests
# domain by attaching to its cdk8s carrier. The Fragment-Host is manifests-cdk8s, so this fragment
# shares that carrier's classloader and reaches org.cdk8s/software.constructs straight off its
# Bundle-ClassPath — no Import-Package for the flat cdk8s closure. Its vocabulary
# (io.nxmatic.rke2lab.systemd.cdk8s) is contributed to the host's exports, where manifests-core
# imports it.
Fragment-Host: io.nxmatic.rke2lab.manifests.cdk8s
Export-Package: io.nxmatic.rke2lab.systemd.cdk8s

# Self-declares this fragment as embeddable so the staging closure stages it under META-INF/bundles
# (seeded on the embed capability, like every domain carrier) and the shade excludes its classes from
# the flat uber-jar — without this it resolved host-flat, the very leak the carrier model kills.
# type=model: it loads on the BUNDLE side of the seam (isDomain), so its exported package
# io.nxmatic.rke2lab.systemd.cdk8s is wired bundle-to-bundle (merged into the manifests-cdk8s host it
# attaches to), never system-exported. A fragment has no lifecycle, so the boot installs it without
# start()ing it (FrameworkLauncher skips start for a Fragment-Host bundle) and the host merges it on
# resolve.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=systemd-cdk8s-manifests

