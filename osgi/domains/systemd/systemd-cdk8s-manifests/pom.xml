<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>systemd-cdk8s-manifests</artifactId>
  <name>osgi/domains/systemd/systemd-cdk8s-manifests</name>
  <description>Role inversion: the systemd domain OWNS the cdk8s rendering of its own units
    (SystemdChart/Service/Unit/Target/DropIn, under the systemd root package), and CONTRIBUTES it to
    the manifests domain as a fragment of the manifests-cdk8s carrier. Reading systemd → cdk8s →
    manifests: systemd renders its units via cdk8s into the manifests synthesis. Attaching to the
    carrier, it shares its classloader and reaches org.cdk8s/software.constructs with no import to
    wire; its vocabulary (io.nxmatic.rke2lab.systemd.cdk8s) is exported through the host, where
    manifests-core imports it.</description>

  <dependencies>
    <!-- The cdk8s carrier this fragment attaches to. provided: at runtime the fragment shares the
         host's classloader (cdk8s + software.constructs come from the host's Bundle-ClassPath), so
         nothing is bundled here; at build time this gives the compiler the constructs API
         transitively. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>manifests-cdk8s</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <!-- bnd execution + jar manifestFile inherited from osgi/bundle-parent; the bare reference
       activates the managed bnd-process goal for this fragment. -->
  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
