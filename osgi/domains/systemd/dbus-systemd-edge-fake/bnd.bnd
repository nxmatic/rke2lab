Bundle-SymbolicName: io.nxmatic.rke2lab.dbus.systemd.edge.fake

# A FRAGMENT of the dbus-systemd edge: it attaches to the edge by BSN, sharing its classloader. Its
# classes and OSGI-INF/*.xml become EXTRA RESOURCES of the host. SCR scans the host AND its attached
# fragments (DS 112.4.1), so the @Component below activates in the edge's context when the edge
# starts — publishing a fake SystemdRuntimeProbe next to the live DbusSystemdProbe. The edge declares
# Service-Component: OSGI-INF/*.xml (findEntries spans fragments) so this descriptor is scanned.
Fragment-Host: io.nxmatic.rke2lab.dbus.systemd.edge

# Selected by OutOfContainerFrameworkExtension via an LDAP filter over these attributes — never by a
# Bundle-SymbolicName literal. Its host (the edge) is found through the Fragment-Host above.
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=systemd; role=probe-fake

# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
