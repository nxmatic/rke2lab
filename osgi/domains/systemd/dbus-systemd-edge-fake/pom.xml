<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>dbus-systemd-edge-fake</artifactId>
  <name>osgi/domains/systemd/dbus-systemd-edge-fake</name>
  <description>The fake fragment of dbus-systemd-edge: a Fragment-Host attached to the edge, carrying
    a @Component that publishes SystemdRuntimeProbe with property variant=fake. It contributes NO
    lifecycle — SCR scans the edge's fragments (DS 112.4.1) and activates the fake in the edge's
    context, alongside the live DbusSystemdProbe; the two are told apart by the variant property a
    test connection selects on. It lets a host-agnostic pipeline stage resolve a reachable systemd
    endpoint from the registry without a real dbus-on-TCP host — the test twin of the edge.</description>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <!-- the SystemdRuntimeProbe seam + its request/snapshot value types; provided — it resolves
         through the dbus-systemd-edge host the fragment attaches to at runtime, compile-time only. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>systemd-port</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
