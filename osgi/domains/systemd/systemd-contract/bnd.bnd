Bundle-SymbolicName: io.nxmatic.rke2lab.systemd.contract
Export-Package: io.nxmatic.rke2lab.systemd.contract
# type=contract — the systemd domain's vocabulary (the runtime probe verb + its snapshot/request, the
# typed unit id, the adapter api paths). Installed bundle-side and wired bundle-to-bundle, NOT a seam:
# the host no longer reads a probe back TYPED — it speaks only to the broker. The dbus-systemd-edge
# satisfies the probe verb. It carries no @Component, so it does NOT Require the SCR extender. The
# contract-purity guard fails the build if this bundle exports a concrete class. Supersedes the
# dissolved systemd-port seam.
Provide-Capability: io.nxmatic.rke2lab.embed; type=contract
# JSpecify annotations are compile-only null metadata, runtime-retained → drop from computed imports.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
