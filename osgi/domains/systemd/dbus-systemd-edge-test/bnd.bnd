-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.dbus.systemd.edge.test

# THE fragment header: attach to the dbus-systemd-edge bundle by its BSN, sharing its classloader and
# package (io.nxmatic.rke2lab.dbus.systemd.edge). The passenger, authored in that same package,
# resolves the edge's SCR-published SystemdRuntimeProbe from the SAME realm and calls probe() TYPED —
# so systemd.contract need NOT be system-exported (which would legitimize the host reading a de-seamed
# contract typed in the live boot). Calling probe() in-container also runs the dbus-java transport
# ServiceLoader inside the edge's OWN classloader — the very thing this test proves.
Fragment-Host: io.nxmatic.rke2lab.dbus.systemd.edge

# Test fixture, selected by OutOfContainerFrameworkExtension via an LDAP filter over these attributes
# — never by a Bundle-SymbolicName literal. Its host (dbus-systemd-edge) is found through the
# Fragment-Host above. type=fixture, suite=systemd, role=dbus-edge.
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=systemd; role=dbus-edge

# No jGiven (a plain Jupiter passenger). Everything the fragment needs — org.junit.jupiter.engine
# (DbusSystemdEdgeTests names JupiterTestEngine.class), jupiter.api, the scenario-engine runner,
# systemd.contract (the probe + request, resolved through the host) — is computed by bnd from bytecode
# and captured by the trailing * wildcard.
