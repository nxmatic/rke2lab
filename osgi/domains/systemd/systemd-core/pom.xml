<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>systemd-core</artifactId>
  <name>osgi/systemd/systemd-core</name>
  <description>The systemd domain's in-world model facet: it contributes the systemd diagnostician
    (DbusTcpSpecialist) to the doctor as a Declarative Services @Component over the doctor's
    Specialist SPI. The specialist owns the systemd unit it remediates (the typed SystemdUnitId from
    systemd-port), so it lives here, in its domain — not in doctor-core. A type=model embeddable
    bundle; its impl package is non-exported (the specialist crosses as the Specialist service).</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The doctor's inter-domain SPI (Specialist + ClinicianProperties) and its record vocabulary:
         the systemd domain implements the SPI to plug its diagnostician into the doctor. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-spi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-records</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The systemd domain's own unit vocabulary: the specialist names the unit it remediates via
         the typed SystemdUnitId, not a literal. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>systemd-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- bnd-consumed DS annotations: @Component declares the SCR descriptor bnd generates. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The shared doctor test fixtures (TestReferrals) — the specialist unit test builds its
         Referral from the one testkit factory, not re-spelled boilerplate. doctor-port-test carries
         the io.nxmatic.rke2lab.doctor.testkit package (the old doctor-testkit module dissolved into
         it); consumed here as a plain test jar (this is a JVM unit test, no OSGi boot). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-port-test</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
