Bundle-SymbolicName: io.nxmatic.rke2lab.systemd.core
# No Export-Package: this bundle's only content is the systemd diagnostician in the non-exported
# io.nxmatic.rke2lab.systemd.internal package. It is SEALED — it crosses to the doctor as the
# Specialist SERVICE (published by SCR), never as a shared package. bnd exports nothing by default;
# the absence of Export-Package IS the seal.

# Embeddable model bundle (installed under META-INF/bundles/ by the capability scan, like
# netplan-core / doctor-core). The DbusTcpSpecialist @Component activates here and registers itself
# as a Specialist for the health system's tier-scoped @Reference to collect.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=systemd
# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
