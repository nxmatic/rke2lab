Bundle-SymbolicName: io.nxmatic.rke2lab.dbus.systemd.edge
# Self-declares this jar as an embeddable EDGE bundle (scanned + installed under META-INF/bundles by
# the same io.nxmatic.rke2lab.embed capability as the other carriers). See ssh-to-age-edge.
Provide-Capability: io.nxmatic.rke2lab.embed; type=edge; edge=dbus-systemd

# Embed the dbus-java stack as WHOLE nested jars (no @ — the jars stay intact); the lib:=true
# directive nests each jar AND adds it to this bundle's Bundle-ClassPath. The transport ServiceLoader
# and the TcpTransportProvider it discovers then resolve through THIS bundle's classloader, each jar
# keeping its own META-INF/services intact — no SPI-Fly, no system leak, no merged service files.
-includeresource: \
  dbus-java-core-*.jar;lib:=true, \
  dbus-java-transport-tcp-*.jar;lib:=true, \
  java-systemd-*.jar;lib:=true

# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
