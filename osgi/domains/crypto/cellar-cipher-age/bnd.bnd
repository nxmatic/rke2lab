-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.cellar.cipher.age
# Exports NOTHING: the seam it fills (CellarCipher) is seed-broker-port's; this bundle only
# IMPLEMENTS it. io.seedmatic.rke2lab.osgi.runtime.cellar.age (AgeCellarCipher) is sealed — reached
# only through the CellarCipher service the @Component publishes.
Provide-Capability: io.seedmatic.rke2lab.embed; type=runtime
# type=runtime: a neutral runtime MECHANISM — installed AND activated in-framework (it resolves at
# the bundle start level so SCR instantiates AgeCellarCipher and registers the CellarCipher service),
# belonging to no domain. Exports nothing, so it is not a seam and not subject to the leak guard.
Service-Component: OSGI-INF/*.xml
