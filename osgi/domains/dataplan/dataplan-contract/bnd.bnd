-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.dataplan.contract
Export-Package: io.seedmatic.rke2lab.dataplan.contract
# type=contract — the dataplan domain's cluster-ZFS-layout vocabulary (DataplanLayout + its Dataset
# entries, the runbook-input wire-record, the domain coordinates). Installed bundle-side and wired
# bundle-to-bundle, NOT system-exported: the host speaks only to the broker, and a consumer
# (OpenebsZfsManifestsUnit, FunnelStatePersistenceManifestsUnit) imports the package in-container.
# Without this bnd the package fell to Private-Package (never exported) and the bundle carried no
# embed capability, so manifests-core could not resolve its dataplan.contract import in ANY closure.
# The contract-purity guard fails the build if this bundle exports a concrete class.
Provide-Capability: io.seedmatic.rke2lab.embed; type=contract
