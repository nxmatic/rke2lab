-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.manifests.core.test

# THE fragment header: attach to the manifests-core bundle by its BSN, sharing its classloader and
# package (io.nxmatic.rke2lab.manifests). The actor tests, authored in that same package, run
# in-container and acquire manifests-core's DS @Components (YamlMapper, ManifestExplodeService) from
# the registry through the host's BundleContext — without manifests-core exporting any internals.
Fragment-Host: io.nxmatic.rke2lab.manifests.core

# Test fixture, selected by OutOfContainerFrameworkExtension via an LDAP filter over these attributes,
# never by a Bundle-SymbolicName literal. Its host (manifests-core) is found through the Fragment-Host
# above. type=fixture, suite=manifests, role=core.
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=manifests; role=core

# jGiven runs in-container for any scenario tests: the shared include carries the forced
# com.tngtech.jgiven.impl.intercept import + the com.tngtech.jgiven.* tail + the trailing * wildcard.
# Everything else this fragment needs is computed by bnd from bytecode and captured by that wildcard
# (org.junit.jupiter.engine since ManifestsCoreTests names JupiterTestEngine.class, jupiter.api, the
# manifests.port value types). So no manual Import-Package here — the include's wildcard suffices.
-include: ${.}/../../../runtime/scenario-testkit/src/main/resources/jgiven-fragment.bnd

