-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.manifests.bdd.test

# THE fragment header: attach to the manifests-bdd bundle by its BSN, sharing its classloader and
# package (io.seedmatic.rke2lab.manifests.bdd). The passenger, authored in that same package, thus
# registers its mock RunGate on the SAME loader the scenario resolves against — the mock IS the same
# Class, so no seam and no system-export are needed (the whole point of testing in-container).
Fragment-Host: io.seedmatic.rke2lab.manifests.bdd

# Test fixture, selected by OutOfContainerFrameworkExtension via an LDAP filter over these
# attributes — never by a Bundle-SymbolicName literal. Its host (manifests-bdd) is found through the
# Fragment-Host above. type=fixture, suite=manifests, role=bdd.
Provide-Capability: io.seedmatic.rke2lab.embed; type=fixture; suite=manifests; role=bdd

# jGiven runs in-container (the scenario is a jGiven ScenarioTest played through the front-door):
# the shared include carries the forced com.tngtech.jgiven.impl.intercept import + the
# com.tngtech.jgiven.* tail + the trailing * wildcard. Everything else this fragment needs is
# computed by bnd from bytecode and captured by that wildcard (org.junit.jupiter.engine since
# ManifestsBddTests names JupiterTestEngine.class, the scenario-engine runner, the manifests +
# seed-broker ports). So no manual Import-Package here — the include's wildcard suffices.
-include: ${.}/../../../runtime/scenario-testkit/src/main/resources/jgiven-fragment.bnd

