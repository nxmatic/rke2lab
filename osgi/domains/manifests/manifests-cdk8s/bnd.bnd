Bundle-SymbolicName: io.nxmatic.rke2lab.manifests.cdk8s

# Export the cdk8s vocabulary to the OSGi world. cdk8s is a manifests-domain concern, so it loads on
# the BUNDLE side of the two-world boundary: this carrier is the sole exporter, wired bundle-to-bundle
# to manifests-core and the manifests-cdk8s-systemd fragment — never leaked host-flat through the
# system bundle. The internal closure (software.amazon.jsii.*, org.jetbrains.annotations) stays
# private to this bundle's classpath; only the two packages consumers actually import are exported.
Export-Package: \
    org.cdk8s, \
    software.constructs, \
    io.nxmatic.rke2lab.manifests.cdk8s

# Embed the flat (non-OSGi) cdk8s closure as WHOLE nested jars (no @ — the jars stay intact); the
# lib:=true directive nests each jar AND adds it to this bundle's Bundle-ClassPath. cdk8s/constructs/
# annotations carry no Bundle-SymbolicName, so they could never resolve as bundles; nesting them here
# gives the exported packages a real classloader.
#
# jackson-datatype-jsr310 IS a genuine OSGi bundle, yet it is nested here too — and that is the subtle
# part. jsii drives a ServiceLoader<com.fasterxml.jackson.databind.Module> (ObjectMapper
# .findAndRegisterModules) to discover JavaTimeModule at runtime; ServiceLoader reads the
# META-INF/services resource off a CLASSLOADER, not through OSGi package wiring. With databind now a
# separate bundle, jsr310 must sit on the SAME classloader that sees the databind bundle's Module —
# this carrier's classpath — or its JavaTimeModule extends a different Module copy and jsii fails with
# "JavaTimeModule not a subtype". Nesting puts its classes AND its META-INF/services on this carrier's
# loader; databind is wired in by Import-Package, so there is one Module view. Cdk8sApps.create pins
# the thread context classloader to this carrier so the ServiceLoader resolves here. (Before databind
# was staged it was host-flat + system-exported — one shared Module view — so jsr310 needed no
# nesting; staging databind broke that premise.)
-includeresource: \
  cdk8s-*.jar;lib:=true, \
  constructs-*.jar;lib:=true, \
  jsii-runtime-*.jar;lib:=true, \
  annotations-*.jar;lib:=true, \
  jackson-datatype-jsr310-*.jar;lib:=true

# Self-declares this jar as an embeddable model carrier (scanned + installed under META-INF/bundles
# by the io.nxmatic.rke2lab.embed capability, like the other domain carriers). model=manifests-cdk8s:
# the cdk8s runtime the manifests domain owns.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=manifests-cdk8s

# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
