<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>manifests-cdk8s</artifactId>
  <name>osgi/domains/manifests/manifests-cdk8s</name>
  <description>The cdk8s carrier bundle for the manifests domain: it embeds the flat (non-OSGi) cdk8s
    closure — cdk8s, software.constructs, jsii-runtime and the jetbrains annotations — INTACT into
    its Bundle-ClassPath (-includeresource …;lib:=true), then exports org.cdk8s and
    software.constructs to the OSGi world. cdk8s is a manifests concern, not a host seam: this keeps
    it on the BUNDLE side of the two-world boundary (a real Export-Package wired bundle-to-bundle),
    so manifests-core and the contributed cdk8s-rendering fragments (e.g. systemd-cdk8s-manifests)
    resolve cdk8s without the host-flat system-packages leak. One bundle owns the embedding; everyone
    else attaches or imports.</description>

  <dependencies>
    <!-- The flat cdk8s closure, embedded INTACT into the Bundle-ClassPath (see bnd.bnd
         -includeresource): these jars carry no Bundle-SymbolicName, so they cannot resolve in the
         OSGi world on their own — this carrier nests them and re-exports their packages. cdk8s pulls
         jsii-runtime; constructs pulls the jetbrains annotations transitively. -->
    <dependency>
      <groupId>org.cdk8s</groupId>
      <artifactId>cdk8s</artifactId>
    </dependency>
    <dependency>
      <groupId>software.constructs</groupId>
      <artifactId>constructs</artifactId>
    </dependency>
  </dependencies>

  <!-- bnd execution + jar manifestFile inherited from osgi/bundle-parent; the bare reference
       activates the managed bnd-process goal. Beyond the embedded flat jars, this carrier owns one
       source class, Cdk8sApps — the App factory that pins the thread context classloader to this
       bundle so jsii's ServiceLoader<Module> resolves the nested jsr310 here (see bnd.bnd). -->
  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <!-- -includeresource nests the cdk8s closure INTACT into the Bundle-ClassPath, so analyze sees
           cdk8s's transitive tail (jackson core/databind, jsii-runtime, jetbrains annotations) as
           "used undeclared". This module's own source imports none of them (they arrive through the
           cdk8s/constructs umbrellas declared above); the carrier embeds and re-exports them. Silence
           the closure here; append keeps the parent's global ignores. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUsedUndeclaredDependencies combine.children="append">
            <dep>com.fasterxml.jackson.core:jackson-core</dep>
            <dep>com.fasterxml.jackson.core:jackson-databind</dep>
            <dep>software.amazon.jsii:jsii-runtime</dep>
            <dep>org.jetbrains:annotations</dep>
          </ignoredUsedUndeclaredDependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
