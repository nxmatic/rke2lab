-include: ../../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.seedmatic.rke2lab.manifests.bdd

# A type=model embeddable bundle (scanned + installed under META-INF/bundles by the
# io.seedmatic.rke2lab.embed capability, like the other domain carriers). It is isDomain, so
# StagingClosure stages its import closure — this is how jgiven-wrap (com.tngtech.jgiven.*) and its
# tail enter the LIVE world: pulled by THIS bundle's imports, not by a hand-listed staging entry.
Provide-Capability: io.seedmatic.rke2lab.embed; type=model; model=manifests-bdd

# No Export-Package: the scenario class is not shared. The launcher plays it by class-selection; the
# host grafts its serialized ScenarioModel. The class never crosses a realm boundary.

# ManifestsRunbookHandler (@Component) publishes the runbook SeedHandler serving
# RunbookCoordinate("manifests"): the broker's ONE host→scion door, whose handle() plays THIS
# bundle's scenario in-container (same loader). SCR reads Service-Component off the manifest; the
# wildcard picks up the generated descriptor.
Service-Component: OSGI-INF/*.xml

# jGiven's runtime-woven packages, invisible to bnd's bytecode analysis, forced exactly as bbox-bdd
# does (byte-buddy DEFINES stage-proxy classes into these at runtime). JSpecify is compile-only.
Import-Package: \
    ${annotation-noimports}, \
    com.tngtech.jgiven.impl, \
    com.tngtech.jgiven.impl.intercept, \
    com.tngtech.jgiven.*, \
    *

