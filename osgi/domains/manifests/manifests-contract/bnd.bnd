-include: ../../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.nxmatic.rke2lab.manifests.contract
Import-Package: ${annotation-noimports}, *
Export-Package: \
    io.nxmatic.rke2lab.manifests.contract,\
    io.nxmatic.rke2lab.manifests.contract.hostasset,\
    io.nxmatic.rke2lab.manifests.contract.node,\
    io.nxmatic.rke2lab.manifests.contract.profiles
# type=contract — the manifests domain's vocabulary (the synthesis/explode/document service verbs,
# the node-env + profile value types, the domain catalog). Installed bundle-side and wired
# bundle-to-bundle, NOT a seam: the host no longer reads these services back TYPED — it speaks only
# to the broker. manifests-core provides the impls. It carries no @Component, so it does NOT Require
# the SCR extender. The contract-purity guard fails the build if this bundle exports a concrete
# class. Supersedes the dissolved manifests-port seam (all three packages).
Provide-Capability: io.nxmatic.rke2lab.embed; type=contract
