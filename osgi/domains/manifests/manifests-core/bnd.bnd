-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.manifests.core
Export-Package: \
    io.seedmatic.rke2lab.manifests,\
    io.seedmatic.rke2lab.manifests.domain,\
    io.seedmatic.rke2lab.manifests.node,\
    io.seedmatic.rke2lab.manifests.profiles,\
    io.seedmatic.rke2lab.manifests.units.runtime.flox
# Self-declares this jar as an embeddable bundle to install under META-INF/bundles/. OsgiRuntime
# scans the staged jars for the NAMESPACE (io.seedmatic.rke2lab.embed) and installs every carrier; the
# boot-stack jars (pax/scr/resolver) do not carry it, so they are excluded objectively — no
# hand-list of names. The type attribute qualifies the carrier's NATURE (model | edge) and
# <type>=<id> names which one — read by humans, not by the scan or the resolver (no matching
# Require-Capability). This jar is a model: in-domain manifest logic.
Provide-Capability: io.seedmatic.rke2lab.embed; type=model; model=manifests
