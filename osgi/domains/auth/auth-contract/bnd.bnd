Bundle-SymbolicName: io.nxmatic.rke2lab.auth.contract
Export-Package: io.nxmatic.rke2lab.auth.contract
# type=contract — the auth domain's consumer-side vocabulary (the AuthTokenContact verb + the flat
# AuthTokenSource enum). Installed bundle-side and wired bundle-to-bundle, NOT a seam: the host no
# longer reads a resolved token back TYPED — it speaks only to the broker. The auth-edge satisfies
# the contract by shelling `gh auth token` / `flox auth token`. It carries no @Component, so it does
# NOT Require the SCR extender. The contract-purity guard fails the build if this bundle exports a
# concrete class. Supersedes the dissolved auth-port seam.
Provide-Capability: io.nxmatic.rke2lab.embed; type=contract
# JSpecify annotations are compile-only null metadata, runtime-retained → drop from computed imports.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
