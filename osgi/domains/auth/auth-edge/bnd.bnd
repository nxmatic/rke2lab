-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.auth.edge
# Self-declares this jar as an embeddable EDGE bundle (scanned + installed under META-INF/bundles by
# the same io.seedmatic.rke2lab.embed capability as the other carriers). See incus-edge.
Provide-Capability: io.seedmatic.rke2lab.embed; type=edge; edge=auth

