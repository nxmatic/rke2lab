<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>auth-bdd</artifactId>
  <name>osgi/domains/auth/auth-bdd</name>
  <description>The auth-seal scion: the in-container @SeedScenario the host sows (after the ghapp
    registration) to file the short-lived GitHub push token SEALED — the ONE place auth DELEGATES its
    GitHub sourcing to ghapp. It reveals the sealed GithubAppCredentials at GhAppCoordinate.GITHUB_APP,
    mints a WRITER installation token via GithubAppMinter, and files it as a GithubToken at
    AuthCoordinate.GITHUB_TOKEN for the rendered-branch push to reveal. The `gh auth token` edge is
    retired for GitHub. AuthRunbookHandler is the broker's host-to-scion door; the scion takes NO
    input, so the handler's seedFrom is a no-op.</description>

  <dependencies>
    <!-- GithubToken / AuthCoordinate (the sealed cellar case this scion files). -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>auth-contract</artifactId>
    </dependency>
    <!-- The delegation target: GithubAppMinter + GithubAppCredentials + GhAppCoordinate + TokenScope +
         MintedToken. auth-seal reveals the sealed App credentials and mints a WRITER token from them,
         replacing the retired `gh auth token` edge — the ONE place auth sources GitHub from ghapp. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>ghapp-contract</artifactId>
    </dependency>
    <!-- Cellar / Parcel / SeedCoordinate / RunbookCoordinate / SeedHandler / Sensitivity / SeedEnvelope. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- GenericRunbookHandler, ScenarioPlayer, @SeedScenario, CellarReceiver, ScenarioCellar, OsgiService. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
