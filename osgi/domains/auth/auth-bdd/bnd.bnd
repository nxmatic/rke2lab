-include: ../../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.nxmatic.rke2lab.auth.bdd

# A type=model embeddable bundle (scanned + installed under META-INF/bundles by the
# io.nxmatic.rke2lab.embed capability, like the other domain carriers). isDomain, so StagingClosure
# stages its import closure — this is how jgiven-wrap and its tail, plus the auth-contract /
# seed-broker-port / scenario-engine bundles it imports, enter the LIVE world.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=auth-bdd

# No Export-Package: the scenario class is bundle-private, played by class-selection; the handler is
# resolved through the SeedHandler seam. Nothing crosses a realm boundary.

# AuthRunbookHandler (@Component) publishes the runbook SeedHandler serving RunbookCoordinate("auth")
# — the broker's host-to-scion door whose handle() plays THIS bundle's scenario in-container. SCR
# reads Service-Component; the wildcard picks up the descriptor.
Service-Component: OSGI-INF/*.xml

# jGiven's runtime-woven packages, invisible to bnd's bytecode analysis (byte-buddy DEFINES the
# stage proxies into these at runtime), forced exactly as cluster-pki-bdd / incus-bdd do.
Import-Package: \
    ${annotation-noimports}, \
    com.tngtech.jgiven.impl, \
    com.tngtech.jgiven.impl.intercept, \
    com.tngtech.jgiven.*, \
    *
