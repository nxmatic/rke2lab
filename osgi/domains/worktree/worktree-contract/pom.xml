<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>worktree-contract</artifactId>
  <name>osgi/domains/worktree/worktree-contract</name>
  <description>The worktree domain's OSGi contract — the jgit-free Worktree service interface the
    incus scion @References, plus the facts records (Provenance / WorkingState / WorktreeFacts /
    WorktreeCoordinate) the interface returns and the soil harvests into the cellar. type=contract,
    consumed bundle-to-bundle OSGi-side; jgit lives behind worktree-core's impl and never
    crosses.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- The runbook trigger contract (WorktreeRunbookInput / GatePolicy) uses @SeedContract +
         @Amendment, the same way incus-contract carries IncusRunbookInput. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
