-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.worktree.contract
Export-Package: io.seedmatic.rke2lab.worktree
# type=contract — the worktree domain's OSGi vocabulary: the jgit-free Worktree service interface an
# OSGi scion @References (the incus scion). Installed bundle-side and wired bundle-to-bundle, NOT a
# seam and NOT flat host-side (the host reads the facts through the cellar, never this interface).
# worktree-core's JgitWorktree satisfies it, jgit sealed behind the impl. It carries no @Component,
# so it does NOT Require the SCR extender; the contract-purity guard fails the build if it exports a
# concrete service impl (it exports the interface plus its jgit-free value records:
# Provenance / WorkingState / WorktreeFacts / WorktreeCoordinate).
Provide-Capability: io.seedmatic.rke2lab.embed; type=contract
