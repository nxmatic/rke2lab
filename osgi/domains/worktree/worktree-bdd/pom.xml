<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>worktree-bdd</artifactId>
  <name>osgi/domains/worktree/worktree-bdd</name>
  <description>The worktree domain's soil SCENARIO — a production jGiven scenario played IN-CONTAINER
    by the seeding engine, not a test. It reads the Worktree @Component's git facts (root, HEAD
    provenance, working state) and harvests a WorktreeFacts into the cellar at the WorktreeCoordinate,
    which the flat host fetches back for the GROW root and the entry gate — fetch-not-push, zero
    host/Pulumi type. A type=model embeddable bundle whose scenario class is non-exported: the
    launcher plays it by class-selection, the host grafts its ScenarioModel — the class never crosses
    a realm.</description>

  <dependencies>
    <!-- The Worktree service the soil reads the facts off (OSGi-side @Reference via the injector). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>worktree-contract</artifactId>
    </dependency>
    <!-- WorktreeFacts + WorktreeCoordinate: the harvest record and the cellar coordinate. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>worktree-contract-host</artifactId>
    </dependency>
    <!-- The frontier vocabulary: Cellar + Parcel the harvest is stored through, RunbookCoordinate +
         SeedHandler the runbook handler serves. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <!-- jGiven as compile deps: the scenario IS jGiven Stages. At runtime these packages resolve to
         the jgiven-wrap bundle, pulled into the live world by this bundle's import closure. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <!-- The scenario's main code declares its Jupiter test method directly (bdd-as-engine). -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The neutral in-container runner (JUnitLauncherCore/InContainerJUnitRunner) the front-door
         calls to play the scenario inside Felix. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
    </dependency>
    <!-- bnd-consumed construction annotations: WorktreeRunbookHandler (@Component) publishes the
         runbook SeedHandler that plays this bundle's scenario in-container. provided — SCR supplies
         the runtime, bnd only needs them to emit the descriptor + the extender requirement. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
