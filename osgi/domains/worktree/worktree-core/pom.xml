<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>worktree-core</artifactId>
  <name>osgi/domains/worktree/worktree-core</name>
  <description>The worktree domain's jgit-backed core: JgitWorktree (@Component service = Worktree)
    locates the process's own worktree and reads its git facts (root, HEAD provenance, working
    state). jgit is a BSN bundle imported not embedded, sealed in the internal package and never
    exported — the exported Worktree view lives in worktree-contract, its facts records in
    worktree-contract-host. Exports NOTHING: consumers reach the SERVICE (Worktree), never the impl.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>worktree-contract</artifactId>
    </dependency>
    <!-- Provenance / WorkingState: the facts records JgitWorktree returns. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>worktree-contract-host</artifactId>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- @Component / @Activate for the impl. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- jgit: sealed behind the internal impl (BSN bundle, imported not embedded), never exported. -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
