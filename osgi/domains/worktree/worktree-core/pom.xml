<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>worktree-core</artifactId>
  <name>osgi/domains/worktree/worktree-core</name>
  <description>The worktree domain's jgit-backed core: JgitWorktree (@Component service = Worktree)
    locates the process's own worktree and reads its git facts (root, HEAD provenance, working
    state). jgit is a BSN bundle imported not embedded, sealed in the internal package and never
    exported — the exported Worktree view and its facts records live in worktree-contract. Exports
    NOTHING: consumers reach the SERVICE (Worktree), never the impl.</description>

  <dependencies>
    <!-- The Worktree interface and the facts records (Provenance / WorkingState) JgitWorktree returns. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>worktree-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- @Component / @Activate for the impl. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- jgit: sealed behind the internal impl (BSN bundle, imported not embedded), never exported. -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit</artifactId>
    </dependency>
    <!-- jgit's smart-HTTP test server (AppServer + GitServlet): the rendered-branch test pushes over
         HTTP, the ONLY transport jgit push does not deadlock — file:// and git:// are duplex and
         hang (push waits for the status while receive-pack waits for the pack), HTTP is half-duplex
         like production HTTPS. Test-only. -->
    <dependency>
      <groupId>org.eclipse.jgit</groupId>
      <artifactId>org.eclipse.jgit.junit.http</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- jgit's AppServer declares junit (4) as `provided`; supply it so the http test server runs.
         Third-party need of the test server only — our own tests are Jupiter. -->
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
