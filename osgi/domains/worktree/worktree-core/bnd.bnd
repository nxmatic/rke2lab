-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.worktree.core
# Exports NOTHING: the Worktree view is the worktree-contract; this bundle only IMPLEMENTS it (the
# JgitWorktree @Component, service = Worktree) and serves it across the broker (the WorktreeSeedHandler
# @Component, service = SeedHandler). io.nxmatic.rke2lab.worktree.internal is sealed — reached only
# through the services the @Components publish. jgit (org.eclipse.jgit, a BSN bundle) is imported and
# sealed here, never exported, so no jgit type crosses to a consumer.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=worktree-core
Service-Component: OSGI-INF/*.xml
