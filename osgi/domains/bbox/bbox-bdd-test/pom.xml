<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-test-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-test-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bbox-bdd-test</artifactId>
  <name>osgi/domains/bbox/bbox-bdd-test</name>
  <description>The -test fragment of bbox-bdd: a Fragment-Host attached to the bbox-bdd bundle,
    sharing its classloader so its passenger runs IN-CONTAINER and the mocks it registers
    (BboxReconciler + RunGate + a doctor ConsultingService) are the SAME Class the scenario resolves
    — no seam, no system-export. The passenger registers the mocks in the shared registry, plays the
    scenario through BboxBddScenarios.run() (the production front-door), and asserts on the harvested
    RunbookEnvelope. jGiven runs in-container via the shared jgiven-fragment.bnd include; the JUnit
    lifecycle via the generic in-container runner (scenario-engine). The src/test @OsgiWorld proxy
    boots Felix, attaches this fragment, and drives the passenger from inside.</description>

  <dependencies>
    <!-- The host under test: the scenario + the front-door. provided — the fragment is pure test
         bytecode that resolves against the bbox-bdd host at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bbox-bdd</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- The vocabulary the mocks + assertions speak: the reconciler + its reservation/outcome/action
         types, the RunGate, the doctor's ConsultingService, the SeedEnvelope the consult rides. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bbox-core</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-port</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>
    <!-- the passenger decodes the harvested RunbookEnvelope + the consultation payloads with jackson,
         the same way the cluster in-container proof reads its envelope. -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-core</artifactId>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The generic in-container runner the fragment's entry delegates to (JUnitLauncherCore /
         InContainerJUnitRunner). Provided — resolved through the bbox-bdd host at runtime. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <version>${project.version}</version>
      <scope>provided</scope>
    </dependency>

    <!-- Jupiter, the engine, jgiven-junit5, junit-platform-launcher are inherited from
         bundle-test-parent. osgi.core (test): the passenger + proxy name framework types directly. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- the src/test @OsgiWorld proxy boots Felix via JGivenTestkit.felix() and installs the JUnit +
         jGiven bundle worlds by classpath substring, so they must be on the TEST classpath. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>pipeline-testkit</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>jgiven-wrap</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
