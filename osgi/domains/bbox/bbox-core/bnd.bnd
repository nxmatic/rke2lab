-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.bbox.core

Export-Package: io.nxmatic.rke2lab.bbox.core
# type=model — the bbox domain's LOGIC: the pure BlueprintRowEnumerator (canonical RKE2 reservations
# from the netplan blueprint, producing bbox-contract's BboxReservationRequests). Installed as a
# bundle and wired bundle-to-bundle to the scion that drives it, in-container — nothing crosses to
# the host, no seam. The reservation vocabulary and the BboxReconciler interface live in
# bbox-contract (type=contract); this module holds only the enumerator, so the contract-purity guard
# on bbox-contract stays clean.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=bbox-core
