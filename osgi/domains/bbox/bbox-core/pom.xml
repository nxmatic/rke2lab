<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bbox-core</artifactId>
  <name>osgi/domains/bbox/bbox-core</name>
  <description>The bbox domain's logic: the pure BlueprintRowEnumerator that derives the canonical
    RKE2 reservations from the netplan blueprint (producing bbox-contract's BboxReservationRequests).
    type=model — installed as a bundle and wired bundle-to-bundle to the scion that drives it,
    in-container. The reservation vocabulary and the BboxReconciler interface live in bbox-contract;
    this module holds only the enumerator logic. No java-bbox-api-client type crosses; no seam.</description>

  <dependencies>
    <!-- The enumerator produces bbox-contract's BboxReservationRequest vocabulary. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bbox-contract</artifactId>
    </dependency>
    <!-- BlueprintRowEnumerator derives each reservation from the netplan blueprint. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>netplan-contract</artifactId>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
    </dependency>
    <!-- The amend door: BboxAmendReflector serves BboxCoordinate.AMEND and binds the host's router
         FACET onto BboxRunbookInput. seed-broker-port carries the SeedHandler/AmendmentAssembler
         ports; seed-broker-codec the SeedCodec + AmendmentBinder it reconciles with. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>
    <!-- @Component on the reflector: bnd emits the SCR descriptor + extender requirement. provided —
         SCR supplies the runtime. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- BboxAmendReflectorTest drives the reflector with a stub AmendmentAssembler + RefusingCellar
         (pure-JSON, no container). junit-jupiter is inherited from the parent. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-testkit</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
