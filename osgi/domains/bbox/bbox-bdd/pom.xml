<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bbox-bdd</artifactId>
  <name>osgi/domains/bbox/bbox-bdd</name>
  <description>The bbox domain's reconciliation SCENARIO — a production jGiven scenario played
    IN-CONTAINER by the seeding engine, not a test. It reconciles the run's desired DHCP reservations
    (enumerated from the netplan blueprint) through BboxReconciler (bbox-core), consulting the ambient
    RunGate to decide live-apply vs dry-run, and consults the doctor (ConsultingService, doctor-contract)
    on a refused row — all domain vocabulary, zero host/Pulumi type. It lives here, not in a bbox-core,
    because it needs no sealed internal (only ports); its BlueprintRowEnumerator is pure and its one
    consumer. A type=model embeddable bundle whose scenario class is non-exported: the launcher plays
    it by class-selection, the host grafts its ScenarioModel — the class never crosses a realm.</description>

  <dependencies>
    <!-- The bbox domain's data + contract: the reservation/outcome/action contract and the
         BboxReconciler the scenario's DSL speaks, plus the BlueprintRowEnumerator (in core) that
         derives the canonical reservations. netplan-contract comes transitively through bbox-core. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bbox-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The doctor's consult seam: the scenario consults the doctor itself on a refused row. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The frontier vocabulary: the RunGate the scion consults, the SeedEnvelope it consults the
         doctor with and carries the consultation back on. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- jGiven as compile deps: the scenario IS jGiven Stages. At runtime these packages resolve to
         the jgiven-wrap bundle, pulled into the live world by this bundle's import closure
         (type=model isDomain → StagingClosure stages its imports). -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-core</artifactId>
    </dependency>
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>
    <!-- The neutral in-container runner (JUnitLauncherCore/InContainerJUnitRunner) the front-door
         calls to play the scenario inside Felix. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- The launcher engine the front-door hands to InContainerJUnitRunner. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>

    <!-- osgi.core: the scenario resolves its collaborators from the BundleContext (the reconciler,
         the RunGate, the doctor), the connection carrying the registry. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- The in-container proof lives in the bbox-bdd-test FRAGMENT (Fragment-Host: bbox-bdd), which
         shares this bundle's loader so its mock BboxReconciler + RunGate are the same Class the
         scenario resolves — no seam, no system-export. So this main bundle carries NO test-scope
         boot deps; they belong to the fragment + its @OsgiWorld proxy. -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
