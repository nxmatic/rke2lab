-include: ../../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.nxmatic.rke2lab.bbox.bdd

# A type=model embeddable bundle (scanned + installed under META-INF/bundles by the
# io.nxmatic.rke2lab.embed capability, like the other domain carriers). It is isDomain, so
# StagingClosure stages its import closure — this is how jgiven-wrap (com.tngtech.jgiven.*) and
# its tail enter the LIVE world: pulled by THIS bundle's imports, not by a hand-listed staging entry.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=bbox-bdd

# No Export-Package: the scenario class is not shared. The launcher plays it by class-selection
# (InContainerJUnitRunner enumerates it on the bundle's own wiring); the host grafts its serialized
# ScenarioModel. The class never crosses a realm boundary, so nothing is exported.

# BboxRunbookHandler (@Component) publishes the runbook SeedHandler serving RunbookCoordinate("bbox"):
# the broker's ONE host→scion door, whose handle() plays THIS bundle's scenario in-container (same
# loader). SCR reads Service-Component off the bundle manifest; the wildcard picks up the generated
# descriptor (and any fragment-contributed one, findEntries spanning attached fragments). The
# osgi.component extender Require-Capability is emitted by bnd from the @Component itself.
Service-Component: OSGI-INF/*.xml

# jGiven's runtime-woven packages, invisible to bnd's bytecode analysis, forced exactly as
# jgiven-fragment.bnd does for -test fragments (byte-buddy DEFINES stage-proxy classes into these at
# runtime; the com.tngtech.jgiven.* wildcard only emits imports for statically REFERENCED packages):
#   - com.tngtech.jgiven.impl.intercept — the stage proxy implements StageInterceptorInternal
#   - com.tngtech.jgiven.impl — byte-buddy defines the proxy of a state-carrying Stage here
# JSpecify annotations are compile-only null metadata, runtime-retained → drop from computed imports.
Import-Package: \
    ${annotation-noimports}, \
    com.tngtech.jgiven.impl, \
    com.tngtech.jgiven.impl.intercept, \
    com.tngtech.jgiven.*, \
    *

