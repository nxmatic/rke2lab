-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.seedmatic.rke2lab.bbox.contract

Export-Package: io.seedmatic.rke2lab.bbox.contract
# type=contract — the bbox domain's flat reservation vocabulary (BboxReservationRequest /
# BboxRowOutcome / BboxAction) AND its consumer-side service interface (BboxReconciler, the reconcile
# verb the edge @Component provides and the scion resolves). Installed and wired bundle-to-bundle,
# NOT a seam (a domain contract is consumed inside OSGi, never host-side). It carries no @Component,
# so it does NOT Require the SCR extender: the scion that needs only BboxReconciler imports THIS, not
# bbox-core (whose BlueprintRowEnumerator is domain logic). The live impl is the bbox-edge; a test
# mocks the interface via registerService. The contract-purity guard fails the build if this bundle
# exports a concrete class — BlueprintRowEnumerator stays in bbox-core for exactly that reason.
Provide-Capability: io.seedmatic.rke2lab.embed; type=contract
