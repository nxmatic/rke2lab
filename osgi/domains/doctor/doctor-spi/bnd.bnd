Bundle-SymbolicName: io.nxmatic.rke2lab.doctor.spi
Export-Package: \
    io.nxmatic.rke2lab.doctor.spi
# The inter-domain SPI: another OSGi domain (e.g. cluster) implements Specialist to plug into the
# doctor. Exported OSGi-side, installed as a bundle (type=model) — NOT a host seam: the host never
# calls these. See docs/architecture/osgi/seed-broker-spec.adoc.
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=doctor
# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
