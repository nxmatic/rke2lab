<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>doctor-port</artifactId>
  <name>osgi/domains/doctor/doctor-port</name>
  <description>The doctor observation port — the seam the diagnostic model depends on and the host
    implements (DIP). Pure POJO model: the SnapshotSource interface and the pure gateway records
    (SnapshotEntry, SnapshotView) that replace the host StackSnapshot/StackHistory at the boundary,
    plus the port's failure-mode exceptions. Zero pulumi, zero osgi runtime — host-loaded and
    system-exported at runtime so both worlds share one copy. Per-package @Version (starts 1.0.0).</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-records</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Governance annotations: this seam's package-info poses REALM_BOUNDARY=WARN so the staging
         gate lists its doctor.records import as the boundary leak during the Plan 2 migration
         (build-time only, not runtime behaviour). -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>domain-annotations</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- test only: the serialization fixtures name the dbus-tcp unit via the typed SystemdUnitId so
         no literal drifts from the systemd domain's single source. Not a runtime/compile coupling —
         the port itself stays a pure leaf. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>systemd-port</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
