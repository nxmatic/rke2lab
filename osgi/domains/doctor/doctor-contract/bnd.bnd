Bundle-SymbolicName: io.nxmatic.rke2lab.doctor.contract

Export-Package: io.nxmatic.rke2lab.doctor.contract
# type=contract — the doctor domain's data vocabulary AND its consumer-side service interfaces, in
# one bundle: the records/enums/sealed-ADT (io.nxmatic.rke2lab.doctor.records — the diagnostic DAG a
# domain reasons over) plus the two service interfaces a consulting domain resolves from the registry
# (io.nxmatic.rke2lab.doctor — ConsultingService, HealthSystem). Installed bundle-side and wired
# bundle-to-bundle, NOT a seam (a domain contract is consumed inside OSGi, never host-side — the host
# speaks only to the broker). It carries no @Component, so it does NOT Require the SCR extender: a
# scion that needs only ConsultingService imports THIS, not doctor-core (whose DefaultHealthSystem
# @Component pulls SCR into resolution). The live impl lives in doctor-core; a test mocks the
# interface via registerService. The contract-purity guard fails the build if this bundle exports a
# concrete class. Supersedes the dissolved doctor-port seam AND the former doctor-records bundle
# (they fused: a record bundle is a contract with no interface).
Provide-Capability: io.nxmatic.rke2lab.embed; type=contract
# JSpecify annotations are compile-only null metadata, runtime-retained → drop from computed imports.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
