Bundle-SymbolicName: io.nxmatic.rke2lab.doctor.core
# Export ONLY the facade package. io.nxmatic.rke2lab.doctor.internal (Generalist, HealthSystem,
# ClinicalAccess, the specialists, ConsultationDag, ...) is NOT listed → bnd does not export it → the impl
# is SEALED: no other bundle can import it. The .internal name makes "framework-internal, never
# exported" structural, not inferred. The DAG is reached only through the doctor-port contracts
# (ConsultingService/HealthSystem) a @Component publishes; the exact-roster fixture that drives it
# white-box lives in the doctor-core-test fragment (which shares this loader), not in this prod bundle.
Export-Package: \
    io.nxmatic.rke2lab.doctor
# Embeddable model bundle (installed under META-INF/bundles/ by the capability scan, like
# manifests-core / netplan-core).
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=doctor

# doctor-core is a HOST OF CONTRIBUTIONS: DefaultHealthSystem collects domain-contributed Specialist
# @Components by @Reference. Felix SCR reads Service-Component off the HOST bundle's own manifest
# (bundle.getHeaders() does NOT merge fragment headers), so the literal value bnd would generate
# (only DefaultHealthSystem.xml) makes a fragment-contributed @Component invisible. The wildcard
# resolves against the bundle's ENTRIES, and findEntries spans attached fragments — so OSGI-INF/*.xml
# picks up BOTH doctor-core's own descriptor AND any fragment-contributed ones. Same rationale as
# bench-fragment-host. (The osgi.component extender Require-Capability is still emitted by bnd from
# the @Component, so it is not hand-declared here.)
Service-Component: OSGI-INF/*.xml
# Nest document-codec as a Bundle-ClassPath jar: the codec's classes ride doctor-core's classpath,
# binding to the bundle's jackson. The SAME source is shaded flat into seed-master, binding to the
# host's jackson — one source, two realm-specific copies, no codec type crosses the seam.
-includeresource: document-codec-*.jar;lib:=true
-noimportjava: true
