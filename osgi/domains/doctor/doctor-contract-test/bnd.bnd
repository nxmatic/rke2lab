-include: ../../../bundle-parent/annotations.bnd
Import-Package: ${annotation-noimports}, *
Bundle-SymbolicName: io.nxmatic.rke2lab.doctor.contract.test

# THE fragment header: attach to the doctor-records bundle by its BSN, sharing its classloader and
# the doctor.records package, so the value-type tests reach the record vocabulary white-box through
# the host loader. Replaces doctor-port-test (doctor-port is gone — de-seamed into doctor-core).
Fragment-Host: io.nxmatic.rke2lab.doctor.contract

# Test fixture, selected by OutOfContainerFrameworkExtension via an LDAP filter over these attributes
# — never by a Bundle-SymbolicName literal. Its host (doctor-contract) is found through Fragment-Host.
# type=fixture, suite=doctor, role=contract (the record value-type tests + the shared testkit).
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=doctor; role=contract

# The shared model fixtures package, EXPORTED so sibling test fragments + domain -core tests import
# it through the doctor-records host (the way doctor-port-test used to export it).
Export-Package: io.nxmatic.rke2lab.doctor.testkit

