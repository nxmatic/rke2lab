Bundle-SymbolicName: io.nxmatic.rke2lab.jagged.wrap

# The whole wrap: stamp OSGi headers onto the jagged jars (jagged-x25519 + its jagged-framework /
# jagged-api / jagged-bech32 closure) — none of which carry a Bundle-SymbolicName. bnd pulls their
# packages off the classpath and exports them from this one bundle.
Export-Package: com.exceptionfactory.jagged.*;version=1.0.0

# Embed NOTHING and import only the JDK. jagged has NO external runtime dependency on JDK 21+: its
# crypto is the platform JCA (X25519 — JEP 324; ChaCha20-Poly1305 — JEP 329), reached via
# Cipher/KeyAgreement from the boot classpath, so there is no bundle to import and no ServiceLoader
# across bundles (no Aries SpiFly). bnd computes Import-Package from the bytecode; it resolves to
# java.* / javax.crypto.* only, all served by the framework/system bundle.
Import-Package: *
