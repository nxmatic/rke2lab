<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>jagged-wrap</artifactId>
  <name>osgi/runtime/jagged-wrap</name>
  <description>jagged (1.0.0) — the pure-Java age encryption library — wrapped as a first-class OSGi
    bundle, the single age-in-OSGi carrier that backs the age CellarCipher (the multi-recipient seal
    of the seed-broker cellar). jagged ships PLAIN jars with NO Bundle-SymbolicName, so it needs a
    wrap; but UNLIKE fabric8 it is maximally clean — it has NO external runtime dependencies on JDK
    21+ (X25519 via JEP 324, ChaCha20-Poly1305 via JEP 329 are JDK-built-in JCA), no split-package,
    and no ServiceLoader across bundles, so NO Aries SpiFly and no embedded tail. The wrap is the
    jgiven-wrap shape: put jagged-x25519 (which pulls jagged-framework/api/bech32 via jagged-bom) on
    the bnd classpath, export com.exceptionfactory.jagged.* — bnd copies jagged's own bytecode into
    this one bundle — and Import-Package only the JDK (java.*, javax.crypto.*), resolved from the
    framework/boot. The x25519 recipient type AND the ssh-ed25519 recipient type are carried (the
    cellar seals to / reveals with the rke2-cluster OpenSSH key directly, jagged converting it
    internally); scrypt is not pulled.</description>

  <dependencies>
    <!-- jagged-x25519 on the bnd classpath so Export-Package sees its packages; its transitive
         jagged-framework / jagged-api / jagged-bech32 (managed by jagged-bom) ride in too and are
         copied into this bundle by the com.exceptionfactory.jagged.* export. No external tail: on
         JDK 21+ jagged needs no dependency beyond the platform JCA. -->
    <dependency>
      <groupId>com.exceptionfactory.jagged</groupId>
      <artifactId>jagged-x25519</artifactId>
    </dependency>
    <!-- jagged-ssh on the bnd classpath so Export-Package sees com.exceptionfactory.jagged.ssh.* —
         the SSH-recipient stanzas (ssh-ed25519) the cellar seals to / reveals with, using the
         rke2-cluster OpenSSH key directly. Pulls jagged-x25519 (its internal ed25519→X25519). -->
    <dependency>
      <groupId>com.exceptionfactory.jagged</groupId>
      <artifactId>jagged-ssh</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <!-- Export-Package pulls jagged's bytecode into this bundle jar, so analyze sees the
           transitive jagged-framework / jagged-api / jagged-bech32 as "used undeclared". The wrap
           deliberately declares only the jagged-x25519 umbrella and embeds its closure by the
           export; the sibling jars are not direct dependencies of this module. append keeps the
           parent's global ignores. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUsedUndeclaredDependencies combine.children="append">
            <dep>com.exceptionfactory.jagged:jagged-api</dep>
            <dep>com.exceptionfactory.jagged:jagged-framework</dep>
            <dep>com.exceptionfactory.jagged:jagged-bech32</dep>
          </ignoredUsedUndeclaredDependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
