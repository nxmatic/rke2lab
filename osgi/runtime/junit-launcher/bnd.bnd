-include: ../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.seedmatic.rke2lab.osgi.runtime.junit.launcher

# The jGiven-FREE runner: export ONLY the runner package. No jGiven import exists here by
# construction (the 4 classes touch only the JUnit platform + boot-discovery), so a runner-only
# world installs this and resolves without jgiven-wrap — the whole reason the runner was pulled out
# of scenario-engine (whose exported package genuinely needs com.tngtech.jgiven.junit5 via
# SeedScenario).
Export-Package: io.seedmatic.rke2lab.osgi.runtime.junit.launcher

# boot.discovery is MANDATORY: JUnitLauncherCore.wiringOf → ClassRealm.of loads it unconditionally,
# so a consumer must wire it (system-exported by the in-container harness via withJUnitRunner) or
# fail at resolution rather than with a late NoClassDefFoundError. slf4j is optional (the failure
# diagnostic logger only) — the same façade the consuming world already provides. The JUnit platform
# + osgi.framework.wiring fall through to * (mandatory), provided by the runner bundles + the system
# bundle.
Import-Package: \
    ${annotation-noimports}, \
    org.slf4j;resolution:=optional, \
    *

