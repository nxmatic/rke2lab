<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>victools-wrap</artifactId>
  <name>osgi/runtime/victools-wrap</name>
  <description>victools jsonschema-generator + jsonschema-module-jackson (4.38.0) wrapped as a
    first-class OSGi bundle — the JSON-Schema projection engine the RecordSchemaProjector drives
    (the amont introspection operator, shape). Both victools jars ship without a Bundle-SymbolicName
    (bare MANIFEST, not even an Automatic-Module-Name), so — on the exact jgiven-wrap pattern — bnd
    stamps OSGi headers onto them: export com.github.victools.*, Import-Package everything else,
    embed nothing. Its whole transitive tail is ALREADY a first-class OSGi bundle — classmate
    (com.fasterxml.classmate) carries a BSN, jackson-core/databind/annotations are bundled — so
    every dependency stays IMPORTED and installs as its own bundle; there is no not-OSGi tail to
    embed. Kept a SEPARATE wrap (not folded into seed-broker-codec) so the schema engine rides only
    where a domain reflector needs it, not into every world that binds the codec.</description>

  <dependencies>
    <!--
      victools on the bnd classpath so Export-Package can see its packages. Its transitive tail
      (classmate, jackson-core/databind/annotations) rides in too; the bnd.bnd imports everything,
      embeds nothing (each dependency is a pre-existing OSGi bundle).
    -->
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-generator</artifactId>
    </dependency>
    <dependency>
      <groupId>com.github.victools</groupId>
      <artifactId>jsonschema-module-jackson</artifactId>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <!-- Export-Package pulls victools' bytecode into this bundle jar, so analyze sees its
           transitive tail (classmate, jackson core/databind/annotations, slf4j) as "used
           undeclared". The wrap declares only the victools umbrella and imports the tail as
           pre-existing bundles — not direct dependencies. append keeps the parent's global ignores. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <configuration>
          <ignoredUsedUndeclaredDependencies combine.children="append">
            <dep>com.fasterxml.jackson.core:jackson-core</dep>
            <dep>com.fasterxml.jackson.core:jackson-databind</dep>
            <dep>com.fasterxml.jackson.core:jackson-annotations</dep>
            <dep>com.fasterxml:classmate</dep>
            <dep>org.slf4j:slf4j-api</dep>
          </ignoredUsedUndeclaredDependencies>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
