Bundle-SymbolicName: io.nxmatic.rke2lab.victools.wrap

# The whole wrap: stamp OSGi headers onto victools jsonschema-generator + jsonschema-module-jackson
# — the two jars in victools' graph that lack a Bundle-SymbolicName. bnd pulls their packages off
# the classpath and exports them; everything they need is imported.
Export-Package: com.github.victools.*;version=4.38.0

# Embed NOTHING. Every victools dependency is ALREADY a first-class OSGi bundle — classmate
# (com.fasterxml.classmate has a BSN) and jackson-core/databind/annotations are bundled — so they
# all stay IMPORTED and install as their own bundles. Embedding any private would split its classes
# from the real bundle and hide a legitimate dependency inside ours. bnd computes Import-Package
# from the bytecode; the only manual touch is dropping compile-only annotation packages (jspecify,
# findbugs) that no bundle resolves at runtime.
Import-Package: \
    !org.jspecify.annotations, \
    !edu.umd.cs.findbugs.annotations, \
    *

-noimportjava: true
