-include: ../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.seedmatic.rke2lab.fabric8.wrap

# The wrap owns io.fabric8.* — exported ONCE from this single bundle. The ~21 kubernetes-model-*
# jars each re-export io.fabric8.kubernetes.api.builder / io.fabric8.kubernetes.model.annotation
# (a 17x / 11x split-package the Felix resolver cannot wire); embedding them below collapses those
# copies into this one classloader, and this single Export-Package is the clean surface.
Export-Package: io.fabric8.*;version=7.8.0

# lib:=true nests each jar WHOLE onto this bundle's Bundle-ClassPath (the incus-core/jsync pattern),
# so every fabric8 class loads from within the bundle and nothing fabric8 is an OSGi import. The
# glob covers the header-less core (client / client-api / httpclient-jdk) AND the model bundles
# (BSN present, but embedded to erase the split-package); zjsonpatch rides too. The vertx backend is
# excluded in the pom, so it never matches here.
-includeresource: \
  kubernetes-*.jar;lib:=true, \
  zjsonpatch-*.jar;lib:=true

# Everything fabric8 needs that is ALREADY a first-class bundle stays imported: jackson + snakeyaml-
# engine (the kubeconfig parser) + BouncyCastle (already staged for cluster-pki) as HARD imports;
# slf4j owned by pax-logging. commons-compress (fabric8's tar helper for pod file-copy) is off the
# readiness path, so its import is OPTIONAL — resolution never blocks on it — and lombok
# (compile-only, CLASS-retention) is dropped. bnd found awaitility / io.sundr unreferenced by the
# embedded classes, so they need no instruction.
Import-Package: \
    ${annotation-noimports}, \
    !lombok.*, \
    org.apache.commons.compress.*;resolution:=optional, \
    *
