<?xml version="1.0" encoding="UTF-8"?>
<!--
  Shared backend config for the out-of-container OSGi harness. Ships in the junit-testkit jar, so
  every -test fragment that carries junit-testkit (provided scope, via bundle-test-parent) picks it
  up on its HOST test classpath. Honored only where logback is the active slf4j provider — i.e.
  host-side, around the framework; in-container slf4j is served as a flat systemPackage with no
  backend, so this file is never read there.

  Root at WARN keeps the run quiet; OutOfContainerFrameworkExtension.resolve()'s unsatisfied-
  requirements diagnostic logs at ERROR, so a resolution failure prints its reason. Raise the harness
  logger to DEBUG with -Dlogback.testkit.level=DEBUG when chasing a wiring problem.
-->
<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <logger name="io.nxmatic.rke2lab.junit.testkit"
          level="${logback.testkit.level:-INFO}"/>

  <root level="WARN">
    <appender-ref ref="STDOUT"/>
  </root>
</configuration>
