<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>scenario-engine</artifactId>
  <name>osgi/runtime/scenario-engine</name>
  <description>The runtime home of the jGiven SCENARIO machinery played on the OSGi framework: the
    @SeedScenario extensions (the transactional ScenarioCellar, the ScenarioOutcome channel, the
    OsgiService bridge), the cross-world graft (ScenarioGraft), the out-of-container framework
    envelope (OutOfContainerFrameworkExtension + FrameworkLog), the SCR diagnostic (ScrDiagnostics),
    and the engine-lifecycle socle (OsgiConnection, StartLevelLever, the @IsolatedWorld/@SeedRuntime
    disciplines). The jGiven-FREE JUnit-Platform runner (JUnitLauncherCore + strategies +
    InContainerJUnitRunner) lives in osgi/runtime/junit-launcher, which this depends on — so a
    runner-only world installs the runner alone while this bundle, whose exported package genuinely
    needs jGiven, is installed only where a @SeedScenario plays (jgiven-wrap staged). jGiven is
    runtime-scope here (the dogfooding promotion): the seeding is a tree of jGiven scenarios. A
    bundle — the in-container half is a real bundle export; it degrades to a plain jar on the flat
    host classpath for the out-of-container half.</description>

  <dependencies>
    <!-- Dogfooding promotion: the JUnit/jGiven machinery is runtime code now, so the launcher +
         engine + Jupiter API are compile deps here (they were provided/test in junit-testkit). The
         in-container runner drives a real JUnit Platform Launcher; the out-of-container envelope is a
         Jupiter extension. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-api</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-launcher</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.platform</groupId>
      <artifactId>junit-platform-engine</artifactId>
    </dependency>
    <!-- The Jupiter engine ScenarioPlayer names (JupiterTestEngine.class) so bnd wires the engine
         bundle into whoever plays a scenario. The launcher machinery lives here now, so a domain
         no longer carries this dep just to feed a front-door; the engine owns it. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-engine</artifactId>
    </dependency>
    <!-- jGiven — the runbook model a pipeline yields (ReportModel); a compile dep since a runtime
         pipeline played on this engine is a jGiven scenario. Not referenced by the src/main
         machinery yet (bnd computes no import for it until a class touches it), so it stays off the
         bundle's Import-Package until the seed vertical lands. -->
    <dependency>
      <groupId>com.tngtech.jgiven</groupId>
      <artifactId>jgiven-junit5</artifactId>
    </dependency>

    <!-- The transactional cellar (ScenarioCellar) lives here (dual-realm, jGiven-aware): the neutral
         Cellar/OpaqueCellar/SeedEnvelope seam it decorates, and the codec it encodes tags with. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-port</artifactId>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>seed-broker-codec</artifactId>
    </dependency>

    <!-- The framework the envelopes boot + drive: Felix (embedded) + the OSGi core API
         (BundleWiring/BundleReference for in-container discovery, FrameworkStartLevel for the
         lever). -->
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.framework</artifactId>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>

    <!-- The connection/lever build on the boot: FrameworkLaunchPipeline.embedded().launch() +
         BootedFramework, and the BootPlan.START_LEVEL_* role->level authority. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>framework-launcher</artifactId>
    </dependency>
    <!-- The jGiven-free JUnit-Platform runner (JUnitLauncherCore + its strategies): ScenarioPlayer
         plays a scenario THROUGH it. Extracted so a runner-only world installs the runner bundle
         alone (no jGiven); scenario-engine keeps only the jGiven-bearing scenario machinery. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-launcher</artifactId>
    </dependency>
    <!-- The shared boot-discovery model the out-of-container envelope reads (ClasspathBundleIndex:
         locate / embeddableBundles / exportsForImportsOf) so test and prod agree on boot discovery
         from one source. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>boot-discovery</artifactId>
    </dependency>

    <!-- slf4j-api for the resolution-failure diagnostic (OutOfContainerFrameworkExtension.resolve()
         logs the unsatisfied requirements rather than returning a blind false). API façade only —
         the backend is the consuming module's. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <!-- The SCR runtime API (ServiceComponentRuntime + the *.dto types): ScrDiagnostics reads
         component states / unsatisfied references to explain why a @Component is or isn't published.
         provided — felix.scr provides these packages at runtime; the helper only needs them to
         compile (the bnd import below is optional, out-of-container only). -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- The socle's own regression proof (src/test): the test-only tags (@OsgiWorld/@Pipeline),
         felix.scr + the DS-runtime trio to boot a real world at level 4, and the logback backend so
         the resolution diagnostic surfaces. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
