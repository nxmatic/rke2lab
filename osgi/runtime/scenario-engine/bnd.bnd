Bundle-SymbolicName: io.nxmatic.rke2lab.osgi.runtime.scenario.engine

# Exported = the IN-REALM halves only, importable by a host -test fragment: the in-container runner
# and the diagnostic helpers (ScrDiagnostics & siblings). The base package is NOT exported — it holds
# the SEAM/host-side classes (OutOfContainerFrameworkExtension, FrameworkLog, and the socle:
# OsgiConnection, StartLevelLever, the disciplines), used only on the flat host classpath, never
# wired in-container. Exporting them would let a bundle load a second copy of a seam class — the
# DUPLICATE_REALM_CLASS collision. One owner per package, no cross-realm duplication.
Export-Package: \
    io.nxmatic.rke2lab.osgi.runtime.scenario.engine.container, \
    io.nxmatic.rke2lab.osgi.runtime.scenario.engine.diagnostic

# The seam half (OutOfContainerFrameworkExtension) pulls the framework-launch API + felix + slf4j
# (the resolution-failure diagnostic logger), needed only on the flat host classpath; marking them
# optional lets the bundle still RESOLVE when installed in-container to provide the runner package.
# jgiven.report.* is the same case: ScenarioGraft (base package, host-side only, never wired
# in-container) rebuilds/grafts a ReportModel via ScenarioJsonReader — jGiven is on the flat host
# classpath where the graft runs, but absent from an in-container world that only installs this
# bundle for its runner package. Optional keeps that in-container resolution green.
# boot.discovery is NOT optional: the IN-CONTAINER runner path (JUnitLauncherCore.wiringOf →
# ClassRealm.of) loads it unconditionally, so a consumer must wire it or fail at resolution rather
# than with a late NoClassDefFoundError — its package is system-exported by the in-container test
# harness (withJUnitRunner). A bundle is a superset of a plain jar — this keeps both uses true.
Import-Package: \
    !org.jspecify.annotations, \
    !org.checkerframework.checker.nullness.qual, \
    org.osgi.framework.launch;resolution:=optional, \
    org.osgi.service.component.runtime;resolution:=optional, \
    org.osgi.service.component.runtime.dto;resolution:=optional, \
    io.nxmatic.rke2lab.osgi.runtime.framework;resolution:=optional, \
    io.nxmatic.rke2lab.osgi.bnd;resolution:=optional, \
    org.slf4j;resolution:=optional, \
    com.tngtech.jgiven.report.*;resolution:=optional, \
    *

-noimportjava: true
