Bundle-SymbolicName: io.nxmatic.rke2lab.osgi.runtime.scenario.engine

# Exported = the IN-REALM halves only, importable by a host -test fragment: the in-container runner
# and the diagnostic helpers (ScrDiagnostics & siblings). The base package is NOT exported — it holds
# the SEAM/host-side classes (OutOfContainerFrameworkExtension, FrameworkLog, and the socle:
# OsgiConnection, StartLevelLever, the disciplines), used only on the flat host classpath, never
# wired in-container. Exporting them would let a bundle load a second copy of a seam class — the
# DUPLICATE_REALM_CLASS collision. One owner per package, no cross-realm duplication.
Export-Package: \
    io.nxmatic.rke2lab.osgi.runtime.scenario.engine.container, \
    io.nxmatic.rke2lab.osgi.runtime.scenario.engine.diagnostic

# The seam half (the base package) is used ONLY on the flat host classpath, never wired
# in-container. Its imports are therefore optional, so the bundle still RESOLVES when installed
# in-container to provide only the scenario machinery (.container + .diagnostic). They fall in three
# host-only concerns:
#   - the framework-launch API + the io.nxmatic framework-launcher/bnd packages: booting Felix
#     (OutOfContainerFrameworkExtension, OsgiConnection, FrameworkLaunch);
#   - org.osgi.service.log: the OSGi LogLevel — a boot-CONSTRUCTION parameter (@FrameworkLog and the
#     logging:level knob, read by LogLevelSeed/BaseWorldExtension before Felix exists). osgi.core
#     carries the package; Felix's system bundle does NOT export it, so mandatory would fail a
#     runner world — but no in-container code ever reads it, so optional is honest, not a dodge;
#   - org.slf4j: the resolution-failure diagnostic logger; component.runtime*: ScrDiagnostics.
# jGiven (report.* AND impl) + jupiter.engine are MANDATORY (not optional): the jGiven-free
# JUnit-Platform runner (JUnitLauncherCore + strategies) moved OUT to the io.nxmatic...junit.launcher
# bundle, so a runner-only world (a *ContractInContainerTest / *EdgeBootTest via withJUnitRunner)
# installs THAT bundle, never this one. scenario-engine is now installed ONLY in a world that plays a
# @SeedScenario — which stages jgiven-wrap + the jupiter engine — so its jGiven/jupiter imports are
# honestly required. The former optional markers were the smell (an exported package that genuinely
# needs jGiven declaring it optional); erased with the extraction. boot.discovery is MANDATORY too:
# OutOfContainerFrameworkExtension reads ClasspathBundleIndex from it (system-exported by the
# in-container harness), so a consumer wires it or fails at resolution.
Import-Package: \
    !org.jspecify.annotations, \
    !org.checkerframework.checker.nullness.qual, \
    org.osgi.framework.launch;resolution:=optional, \
    org.osgi.service.component.runtime*;resolution:=optional, \
    org.osgi.service.log;resolution:=optional, \
    io.nxmatic.rke2lab.osgi.runtime.framework;resolution:=optional, \
    io.nxmatic.rke2lab.osgi.bnd;resolution:=optional, \
    org.slf4j;resolution:=optional, \
    *

-noimportjava: true
