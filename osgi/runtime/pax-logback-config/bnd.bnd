-include: ../../bundle-parent/annotations.bnd
Bundle-SymbolicName: io.seedmatic.rke2lab.osgi.runtime.logback

# THE fragment header: attach to pax-logging-logback by its BSN, sharing its classloader. pax embeds
# logback and its own internals but EXPORTS NO PACKAGE (its manifest carries no Export-Package), so a
# normal bundle could never reach the real LoggerContext — only a fragment, reading logback + the
# internal PaxLoggingServiceImpl straight off the host's Bundle-ClassPath, can. Installed without
# start() (a fragment has no lifecycle) and merged into the host when it resolves (OSGi Core §3.14).
Fragment-Host: org.ops4j.pax.logging.pax-logging-logback

# logback lives on the HOST's Bundle-ClassPath (embedded, unexported), reached through the attachment
# above — NOT via an import wire. So negate ch.qos.logback.*: otherwise bnd, seeing the compile-time
# references, would emit an Import-Package no bundle exports and the fragment would fail to attach.
# org.osgi.framework stays imported (the * tail) and is satisfied by the system bundle.
Import-Package: !ch.qos.logback.*, ${annotation-noimports}, *

# Self-declares this fragment as embeddable so the staging closure stages it under META-INF/bundles
# (seeded on the embed capability, like every carrier) and the shade excludes it from the flat
# uber-jar. type=model (isDomain): a fragment loads on the BUNDLE side of the seam; it exports nothing,
# so the leak-guard is moot — the classification only routes staging + install. Same shape as the
# systemd-cdk8s-manifests fragment.
Provide-Capability: io.seedmatic.rke2lab.embed; type=model; model=pax-logback-config
