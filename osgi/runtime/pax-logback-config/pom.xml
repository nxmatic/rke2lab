<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>pax-logback-config</artifactId>
  <name>osgi/runtime/pax-logback-config</name>
  <description>A FRAGMENT attached to org.ops4j.pax.logging.pax-logging-logback carrying the logback
    policy coded in Java (PaxLogbackConfigurer) instead of an inlined XML string. pax embeds logback
    and exports no package, so only a fragment — sharing pax's classloader off its Bundle-ClassPath —
    can link against the real LoggerContext. The flat host cannot reach logback, so the framework
    launcher invokes the configurer reflectively across the realm seam (paxBundle.loadClass) once,
    right after framework.start() returns. The minimal bootstrap logback XML the launcher still writes
    wires only the FILE appender + root (so boot noise never reaches the console); THIS fragment holds
    the noise-suppression policy — the per-tree levels + the root level from the launch config.</description>

  <dependencies>
    <!-- The logback Java API the policy is written against (LoggerContext / Logger / Level). provided:
         at runtime the fragment links against pax's embedded logback via the Fragment-Host attachment,
         never its own copy — this jar is compile-only, and bnd must NOT emit an Import-Package for it
         (pax exports no logback package), hence the negation in bnd.bnd. -->
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- Bundle / BundleContext / ServiceReference: the configurer reaches pax's live context through
         the bundle. provided — the framework's system bundle exports org.osgi.framework at runtime. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- LoggerFactory: the configurer logs its own progress through slf4j. provided — at runtime the
         fragment links against pax-logging-api's org.slf4j, never its own copy. -->
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
