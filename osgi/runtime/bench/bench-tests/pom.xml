<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../../../../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bench-tests</artifactId>
  <version>0.0.0-SNAPSHOT</version>
  <name>osgi/runtime/bench/bench-tests</name>
  <description>Bench proof harness: P1 (extender resolve/refuse on the real Felix engine) and P2
    (typed OCD introspection by PID). Not a bundle.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>junit-testkit</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The out-of-container framework envelope moved to the runtime engine module (JUnit/jGiven are
         runtime-scope now); the @Osgi tag stays in junit-testkit above. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>scenario-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-config</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-host</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-scr-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-scr-consumer</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the fragment-contribution proof: the host exports ContributedService, the fragment carries
         the @Component that provides it. Both located on the test classpath by their embed
         capability (installFixtureWithHost), not named in the test. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-fragment-host</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-fragment-contribution</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- the start-level ordering proof: growers pinned at BUNDLES(4), a contributor at level 5.
         The api is a test dep so its package is system-exported (shared class for a typed
         awaitService); the grower/contributor bundles are located by their embed capability. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-startlevel-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-startlevel-grower</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bench-startlevel-contributor</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.scr</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- DS runtime API on the test classpath so the system bundle can export it to felix.scr -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.promise</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.util.function</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.metatype</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.log</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The OSGi logging stack the inverted-flow probe boots out-of-container: pax-logging-api
         installs a JdkHandler that captures the JDK java.util.logging bus, and pax-logging-logback
         is the single sink. The probe configures pax-logging-logback FILE-only via configadmin (no
         console) and proves a java.util.logging record reaches that sink, never a ConsoleAppender.
         Located on the test classpath by Bundle-SymbolicName, installed in the test body. -->
    <dependency>
      <groupId>org.ops4j.pax.logging</groupId>
      <artifactId>pax-logging-api</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.ops4j.pax.logging</groupId>
      <artifactId>pax-logging-logback</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.apache.felix</groupId>
      <artifactId>org.apache.felix.configadmin</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.metatype</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
