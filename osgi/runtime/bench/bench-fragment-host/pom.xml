<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bench-fragment-host</artifactId>
  <name>osgi/bench/bench-fragment-host</name>
  <description>The host bundle of the fragment-contribution proof: it exports the ContributedService
    type but carries no @Component of its own. A fragment attaches to it and adds a @Component as a
    host resource; SCR must then activate that component in this host's context (DS 112.4.1). The
    proof the whole fragment-contribution mediation model rests on.</description>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <!-- bnd-consumed: @Component / @Reference on the host-side collector generate OSGI-INF/*.xml +
         the Service-Component header. The host owns this collector component (the roster), so it
         carries the DS annotations like any other component module. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
