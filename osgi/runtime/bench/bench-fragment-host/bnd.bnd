Bundle-SymbolicName: io.seedmatic.rke2lab.osgibench.fragment.host

# The host a fragment attaches to. It exports the service TYPE and owns the ContributionCollector
# @Component (the roster). SCR scans the host AND its attached fragments (DS 112.4.1).
Export-Package: io.seedmatic.rke2lab.osgibench.fragment

# THE host-of-contributions header. Felix SCR reads Service-Component off the HOST bundle's own
# manifest (bundle.getHeaders() does NOT merge fragment headers), so a fragment's own
# Service-Component is never seen. The wildcard resolves against the bundle's ENTRIES, and
# findEntries spans attached fragments — so OSGI-INF/*.xml picks up BOTH the host's own collector
# descriptor AND the fragment-contributed ones. Explicit (overriding bnd's auto value) precisely so
# the fragment descriptors are caught, not only the host's. (The extender Require-Capability is
# emitted by bnd from the collector @Component, so it is not hand-declared here.)
Service-Component: OSGI-INF/*.xml

# Installed by what it declares, never by a Bundle-SymbolicName literal.
Provide-Capability: io.seedmatic.rke2lab.embed; type=fixture; suite=fragment; role=host
