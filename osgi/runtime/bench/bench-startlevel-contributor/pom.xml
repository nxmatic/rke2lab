<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bench-startlevel-contributor</artifactId>
  <name>osgi/runtime/bench/bench-startlevel-contributor</name>
  <description>A @Component(service=GrowerCensus) whose @Reference(MULTIPLE) List&lt;Grower&gt; is bound
    at its own activation, pinned to the contributor level (5) above the growers. It publishes the
    count it saw — the proof that a contributor binds seeing every grower ACTIVE, at boot or when
    installed at runtime.</description>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>bench-startlevel-api</artifactId>
    </dependency>
    <!-- bnd-consumed: @Component / @Reference generate OSGI-INF/*.xml + the Service-Component header -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
