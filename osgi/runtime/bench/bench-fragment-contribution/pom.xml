<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.seedmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>bench-fragment-contribution</artifactId>
  <name>osgi/runtime/bench/bench-fragment-contribution</name>
  <description>The fragment of the fragment-contribution proof: it attaches to bench-fragment-host
    and carries a @Component implementing ContributedService. The component is a host RESOURCE, not
    a started bundle; the proof is that SCR activates it in the host's context when the host starts.</description>

  <dependencies>
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <!-- the service TYPE the component implements; provided — it resolves through the host the
         fragment attaches to at runtime, this is only the compile-time view. -->
    <dependency>
      <groupId>io.seedmatic.rke2lab</groupId>
      <artifactId>bench-fragment-host</artifactId>
      <scope>provided</scope>
    </dependency>
    <!-- bnd-consumed: @Component generates OSGI-INF/*.xml + the Service-Component header -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>org.osgi.service.component.annotations</artifactId>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
