Bundle-SymbolicName: io.nxmatic.rke2lab.osgibench.host
Export-Package: io.nxmatic.rke2lab.osgibench.host
# Test fixture, selected by OutOfContainerFrameworkExtension.installMatching via an LDAP filter over these
# attributes — never by a Bundle-SymbolicName literal a test keeps in sync. The extender suite's
# host: it provides the osgi.extender the config fixture requires. (Merged with the osgi.extender
# capability bnd generates from @Component — both coexist in the manifest.)
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=extender; role=host
-noimportjava: true
