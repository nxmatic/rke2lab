Bundle-SymbolicName: io.nxmatic.rke2lab.osgibench.config
Export-Package: io.nxmatic.rke2lab.osgibench.config
# Test fixture, selected by OutOfContainerFrameworkExtension.installMatching via an LDAP filter over these
# attributes — never by a Bundle-SymbolicName literal a test keeps in sync. The extender suite's
# consumer: it requires the osgi.extender the host fixture provides, so the resolve-vs-refuse proof
# installs them together (resolves) or the config alone (refuses, loudly).
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=extender; role=config
# JSpecify annotations are compile-only null-safety metadata (@NullMarked/@Nullable), yet
# RUNTIME-retained, so bnd would emit an Import-Package for org.jspecify.annotations — a package
# nothing resolves at runtime (no JSpecify bundle is staged in either realm). Drop it from the
# computed imports; the annotations do their job at compile/analysis time only.
Import-Package: !org.jspecify.annotations, *
-noimportjava: true
