Bundle-SymbolicName: io.nxmatic.rke2lab.osgibench.fragment.contribution

# A FRAGMENT: it attaches to the host by BSN, sharing its classloader. It has no lifecycle of its
# own — its classes, its OSGI-INF/*.xml, and the Service-Component header bnd generates from the
# @Component below become EXTRA RESOURCES of the host. SCR scans the host AND its fragments
# (DS 112.4.1), so the component activates in the host's context when the host starts.
Fragment-Host: io.nxmatic.rke2lab.osgibench.fragment.host

# Installed by what it declares, then attached to its host (found via Fragment-Host) and resolved.
Provide-Capability: io.nxmatic.rke2lab.embed; type=fixture; suite=fragment; role=contribution
-noimportjava: true
