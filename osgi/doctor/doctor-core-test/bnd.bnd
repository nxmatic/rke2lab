Bundle-SymbolicName: io.nxmatic.rke2lab.doctor.core.test

# THE fragment header: attach to the doctor-core bundle by its BSN, sharing its classloader and
# package (io.nxmatic.rke2lab.doctor). The actor tests, authored in that same package, thus reach
# doctor-core's sealed package-private final-class actors (Generalist, HealthSystem, ClinicalAccess,
# GrantPolicy, DriftSpecialist, the core Specialists) WHITE-BOX through the host loader — without
# doctor-core exporting any of them (its OSGi exports are unchanged; only the Java package barrier
# is crossed, by sharing the package).
Fragment-Host: io.nxmatic.rke2lab.doctor.core

# jGiven runs in-container for the 2 scenario tests (DoctorScenario(Test)): the shared include
# carries the one forced com.tngtech.jgiven.impl.intercept import + the com.tngtech.jgiven.* tail +
# the trailing * wildcard. Everything else this fragment needs is computed by bnd from bytecode and
# captured by that wildcard: org.junit.jupiter.engine (DoctorCoreTests names JupiterTestEngine.class),
# jupiter.api, and io.nxmatic.rke2lab.doctor.testkit (the tests reference FakeSpecialist/Referral
# Replies). So no manual Import-Package here — the include's wildcard suffices.
-include: ${.}/../../jgiven/jgiven-testkit/src/main/resources/jgiven-fragment.bnd

-noimportjava: true
