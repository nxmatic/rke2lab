Bundle-SymbolicName: io.nxmatic.rke2lab.doctor.core
Export-Package: \
    io.nxmatic.rke2lab.doctor
# Self-declares doctor-core as an embeddable model bundle (installed under META-INF/bundles/ by the
# capability scan, like manifests-core / netplan-core). The step that puts the doctor INTO the OSGi
# world — prerequisite to it becoming the SCR contribution host (the @Reference List<Specialist>
# roster the cluster fragment binds into).
Provide-Capability: io.nxmatic.rke2lab.embed; type=model; model=doctor
-noimportjava: true
