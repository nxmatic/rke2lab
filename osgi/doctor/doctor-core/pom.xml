<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>doctor-core</artifactId>
  <name>osgi/doctor/doctor-core</name>
  <description>The doctor diagnostic model: the pure operator-runbook types (symptom, observation,
    assessment, prescription, remediation plan, medical record, health system, the specialists and
    the clinical-access model) lifted from exec/seed-master into the OSGi world. Consumes the
    doctor-port observation seam; the host implements it (DIP). Zero pulumi — the rendering engine and
    the live-observation adapters stay host.</description>

  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>doctor-port</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
