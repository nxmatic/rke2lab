<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>bundle-parent</artifactId>
    <version>0.0.0-SNAPSHOT</version>
    <relativePath>../../bundle-parent/pom.xml</relativePath>
  </parent>

  <artifactId>boot-discovery</artifactId>
  <name>osgi/boot/boot-discovery</name>
  <description>The embedded-OSGi boot MODEL, shared by the prod executor (osgi/runtime) and the
    test-world OutOfContainerFrameworkExtension so both agree on the boot topology instead of re-implementing
    it. Declares the embed capability namespace bundles self-mark with, the BootStackJar registry of
    the third-party boot stack (pax-logging, felix.scr/resolver — not ours, so named not scanned),
    and ClasspathBundleIndex: an instance that scans java.class.path ONCE and answers locate /
    embeddable-bundles / mirror-imports queries. Depends only on the JDK jar/manifest API — NO felix,
    NO pax — so a consumer that only needs to FIND bundles never drags the boot runtime's closure
    (notably pax-logging-api, a second org.slf4j provider) onto its classpath.</description>

  <dependencies>
    <!-- The shared bnd-header reading (OsgiHeader / Clause / EmbedCapability), extracted into the
         maven-embed-staging-ext lifecycle so the build-time extension and this runtime model parse
         identically. A RELEASE coordinate (1.0.0, not a reactor SNAPSHOT), so it is a stable
         foundation like the BOM — resolved from the local repo, no masking, the no-snapshot-install
         guard untouched. "bnd" stays an implementation detail: boot-discovery exports none of it. -->
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>bnd-read</artifactId>
    </dependency>
    <!-- DiscoveryPolicy / BundleIndex / BundleLocation compile against org.osgi.framework (Filter,
         FrameworkUtil, the manifest-header semantics). Declared directly: it would arrive via
         bnd-read, but a type we compile against is a direct dependency, never a transitive lean. -->
    <dependency>
      <groupId>org.osgi</groupId>
      <artifactId>osgi.core</artifactId>
    </dependency>
    <!-- junit-jupiter (test) is inherited from build-parent. -->
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>biz.aQute.bnd</groupId>
        <artifactId>bnd-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
