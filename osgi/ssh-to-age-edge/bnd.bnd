Bundle-SymbolicName: io.nxmatic.rke2lab.sshtoage.edge
# Self-declares this jar as an embeddable bundle to install under META-INF/bundles/. OsgiRuntime
# scans the staged jars for the NAMESPACE (io.nxmatic.rke2lab.embed) and installs every carrier;
# the type attribute qualifies the carrier's NATURE (model | edge) and <type>=<id> names which one
# — read by humans, not by the scan, and not by the resolver (no matching Require-Capability). This
# is the first carrier whose nature is edge, not model: a model is in-domain logic; an edge is the
# system's door toward an external tool.
Provide-Capability: io.nxmatic.rke2lab.embed; type=edge; edge=ssh-to-age
-noimportjava: true
