# RKE2Lab filesystem paths
RKE2LAB_ROOT=/srv/host
RKE2LAB_ENV_DIR=/srv/host/rke2lab-environment.d
RKE2LAB_SCRIPTS_DIR=/srv/host/systemd-scripts.d
RKE2LAB_SYSTEMD_DIR=/srv/host/systemd-units.d
RKE2LAB_CONFIG_DIR=/srv/host/rke2-config.d
RKE2LAB_CLOUDCONFIG_NO_CLOUD_DIR=/srv/host/cloudconfig-nocloud.d
RKE2LAB_MANIFESTS_DIR=/srv/host/rke2-manifests.d
RKE2LAB_SHARED_DIR=/srv/host/rke2lab-share.d
RKE2LAB_KUBECONFIG_DIR=/srv/host/rke2lab-kube.d
