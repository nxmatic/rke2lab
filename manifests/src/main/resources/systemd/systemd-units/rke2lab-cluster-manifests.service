[Unit]
Description=Install RKE2Lab cluster manifests from host share (post-server)
RequiresMountsFor=/srv/host/systemd-units.d /srv/host
After=local-fs.target
After=rke2-server.service
Requires=rke2-server.service
ConditionPathExists=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh
ConditionPathExists=/srv/host/rke2-manifests.d/cluster

[Service]
Type=oneshot
ExecStart=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh cluster
ExecStartPost=/srv/host/systemd-scripts.d/rke2lab-layer-ready.sh cluster
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab.target
