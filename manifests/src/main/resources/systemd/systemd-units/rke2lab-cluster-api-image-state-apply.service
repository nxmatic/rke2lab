[Unit]
Description=Install Cluster API staged image-state manifest (via RKE2 auto-deploy)
Documentation=file:///srv/host/docs/staged-post-cluster-resources.adoc
Documentation=file:///srv/host/docs/manifest-apply-flow.adoc
RequiresMountsFor=/srv/host/systemd-units.d /srv/host
After=local-fs.target
After=rke2-server.service
Requires=rke2-server.service
After=rke2lab-clusterapi-manifests.service
Requires=rke2lab-clusterapi-manifests.service
ConditionPathExists=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh
ConditionPathExists=/srv/host/rke2-manifests.d/clusterapi/staged

[Service]
Type=oneshot
ExecStart=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh clusterapi/staged
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab.target
