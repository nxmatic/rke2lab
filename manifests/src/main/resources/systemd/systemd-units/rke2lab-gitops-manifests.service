[Unit]
Description=Install RKE2Lab gitops manifests from host share (post-server)
RequiresMountsFor=/srv/host/systemd-units.d /srv/host
After=local-fs.target
After=rke2lab-tekton-pipelines-manifests.service
Requires=rke2lab-tekton-pipelines-manifests.service
After=rke2lab-replication-manifests.service
Requires=rke2lab-replication-manifests.service
After=rke2lab-gitops-secrets.service
Requires=rke2lab-gitops-secrets.service
ConditionPathExists=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh
ConditionPathExists=/srv/host/rke2-manifests.d/gitops

[Service]
Type=oneshot
ExecStart=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh gitops
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab.target