[Unit]
Description=Install Cluster API Provider Incus (CAPN) via clusterctl
RequiresMountsFor=/srv/host/systemd-units.d /srv/host
After=local-fs.target
After=rke2lab-cluster-api-install.service
Requires=rke2lab-cluster-api-install.service
ConditionPathExists=/srv/host/systemd-scripts.d/rke2lab-capn-provider-install.sh

[Service]
Type=oneshot
ExecStart=/srv/host/systemd-scripts.d/rke2lab-capn-provider-install.sh
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab.target
