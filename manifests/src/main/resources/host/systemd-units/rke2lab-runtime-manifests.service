[Unit]
Description=Install RKE2Lab runtime manifests from host share (post-server)
RequiresMountsFor=/srv/host/systemd-units.d /srv/host
After=local-fs.target
After=rke2-server.service
Requires=rke2-server.service
After=rke2lab-runtime-secrets.service
Requires=rke2lab-runtime-secrets.service
ConditionPathExists=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh
ConditionPathExists=/srv/host/manifests.d/runtime/flox-containerd-shim

[Service]
Type=oneshot
ExecStart=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh runtime/flox-containerd-shim
ExecStartPost=/srv/host/systemd-scripts.d/rke2lab-layer-ready.sh runtime
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab.target