[Unit]
Description=Install RKE2Lab replication manifests from host share (post-server)
RequiresMountsFor=/srv/host/systemd-units.d /srv/host
After=local-fs.target
After=rke2-server.service
Requires=rke2-server.service
ConditionPathExists=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh
ConditionPathExists=/srv/host/manifests.d/replication

[Service]
Type=oneshot
ExecStart=/srv/host/systemd-scripts.d/rke2lab-manifests-install.sh replication
ExecStartPost=/srv/host/systemd-scripts.d/rke2lab-replicator-ready.sh
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab.target