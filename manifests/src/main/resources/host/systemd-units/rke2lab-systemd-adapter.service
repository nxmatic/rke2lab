[Unit]
Description=RKE2Lab systemd adapter service
Documentation=https://github.com/nxmatic/rke2lab
RequiresMountsFor=/srv/host /srv/host/systemd-scripts.d /srv/host/systemd-libexec.d
After=local-fs.target network-online.target rke2lab-install.service
Wants=network-online.target
ConditionPathExists=/srv/host/systemd-scripts.d/rke2lab-systemd-adapter-install.sh

[Service]
Type=simple
ExecStartPre=/usr/bin/env sh /srv/host/systemd-scripts.d/rke2lab-systemd-adapter-install.sh
ExecStart=/usr/bin/env sh -lc 'source <(flox activate --dir /var/lib/rancher/rke2) && exec java -jar /srv/host/rke2lab-systemd-adapter.d/current/rke2lab-systemd-adapter-exec.jar --server.port=18080'
WorkingDirectory=/srv/host
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab.target
