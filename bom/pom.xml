<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Standalone third-party version catalog. The BOM has its own lifecycle and
    version, independent of the project: it pins the EXTERNAL dependency versions
    the modules build against. The rke2lab inter-module versions are NOT here —
    they share the project's lifecycle and are managed by the parent at
    ${project.version}. Having no <parent> is deliberate: it breaks the cycle that
    would otherwise arise from the parent importing this BOM.
  -->
  <groupId>io.nxmatic.rke2lab</groupId>
  <artifactId>bom</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>bom</name>
  <description>Standalone third-party version catalogue: pins the external dependency versions the
    modules build against. Own lifecycle, no parent (breaks the parent-imports-BOM cycle).</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <dbus.java.version>5.2.0</dbus.java.version>
    <java-systemd.version>3.0.0-SNAPSHOT</java-systemd.version>
    <grpc.version>1.82.0</grpc.version>
    <pulumi.version>1.30.0</pulumi.version>
    <pulumi.command.version>1.2.1</pulumi.command.version>
    <spring.boot.version>4.1.0</spring.boot.version>
    <jsr305.version>3.0.2</jsr305.version>
    <jspecify.version>1.0.0</jspecify.version>
    <gson.version>2.14.0</gson.version>
    <jackson.version>2.22.0</jackson.version>
    <networknt.json-schema.version>1.5.6</networknt.json-schema.version>
    <jgit.version>7.7.0.202606012155-r</jgit.version>
    <software.constructs.version>10.6.0</software.constructs.version>
    <cdk8s.version>2.70.76</cdk8s.version>
    <cdk8s.plus33.version>2.5.28</cdk8s.plus33.version>
    <slf4j.version>2.0.18</slf4j.version>
    <!-- Aligned with the logback pax-logging-logback ${pax.logging.version} pulls (2.3.4 → 1.5.34):
         StaticLogbackContext shares ONE LoggerContext between the host and pax, so both must be the
         same logback. On a pax bump, re-check `mvn -pl :runtime dependency:tree -Dincludes=ch.qos.logback`. -->
    <logback.version>1.5.34</logback.version>
    <ipaddress.version>5.6.2</ipaddress.version>
    <commons.compress.version>1.28.0</commons.compress.version>
    <jgiven.version>2.0.3</jgiven.version>
    <felix.resolver.version>2.0.4</felix.resolver.version>
    <osgi.core.version>8.0.0</osgi.core.version>
    <felix.framework.version>7.0.5</felix.framework.version>
    <felix.metatype.version>1.2.4</felix.metatype.version>
    <felix.log.version>1.3.0</felix.log.version>
    <felix.configadmin.version>1.9.26</felix.configadmin.version>
    <felix.scr.version>2.2.18</felix.scr.version>
    <!--
      Pax Logging: the OSGi logging backend the launched framework drains to. pax-logging-api
      replaces org.slf4j for bundles; pax-logging-logback registers the OSGi LogService and, with
      StaticLogbackContext=true, reuses the HOST's logback context so framework/SCR/bundle logs all
      land in the host logs. 2.3.x targets OSGi R8 (matches felix.framework 7.0.5) and pulls
      logback 1.5.x — keep logback.version aligned with what pax pulls (below).
    -->
    <pax.logging.version>2.3.4</pax.logging.version>
    <osgi.metatype.version>1.4.1</osgi.metatype.version>
    <!--
      OSGi CONSTRUCTION annotations (compile-only, scope provided): bnd reads
      them to GENERATE the manifest headers + Metatype XML — the Java is the
      source of truth. Pinned individually because org.osgi:osgi.cmpn:8.1.0
      (which would bundle all three) is absent from Maven Central.
    -->
    <osgi.ds.annotations.version>1.5.1</osgi.ds.annotations.version>
    <osgi.metatype.annotations.version>1.4.1</osgi.metatype.annotations.version>
    <osgi.bundle.annotations.version>2.0.0</osgi.bundle.annotations.version>
    <osgi.versioning.annotations.version>1.1.2</osgi.versioning.annotations.version>
    <!--
      DS runtime API packages (org.osgi.service.component[.runtime], util.promise/function):
      felix.scr imports them as MANDATORY but osgi.core's system bundle does not carry them, so a
      launched SCR must get them from somewhere. The bench exports them from the system bundle via
      system.packages.extra (the typed-access trick), so these jars sit on the test classpath.
    -->
    <osgi.component.version>1.5.1</osgi.component.version>
    <osgi.util.promise.version>1.3.0</osgi.util.promise.version>
    <osgi.util.function.version>1.2.0</osgi.util.function.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.networknt</groupId>
        <artifactId>json-schema-validator</artifactId>
        <version>${networknt.json-schema.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-bom</artifactId>
        <version>${slf4j.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!--
        spring-boot-dependencies manages JUnit, Mockito and byte-buddy in a
        mutually consistent set (mockito 5.11.0 / byte-buddy 1.14.19 — the same
        byte-buddy JGiven uses), so the test toolchain needs no explicit versions.
      -->
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>com.github.hypfvieh</groupId>
        <artifactId>dbus-java-bom</artifactId>
        <version>${dbus.java.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-bom</artifactId>
        <version>${grpc.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- third-party dependencies -->
      <dependency>
        <groupId>com.github.thjomnx</groupId>
        <artifactId>java-systemd</artifactId>
        <version>${java-systemd.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulumi</groupId>
        <artifactId>pulumi</artifactId>
        <version>${pulumi.version}</version>
      </dependency>
      <dependency>
        <groupId>com.pulumi</groupId>
        <artifactId>command</artifactId>
        <version>${pulumi.command.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.findbugs</groupId>
        <artifactId>jsr305</artifactId>
        <version>${jsr305.version}</version>
      </dependency>
      <dependency>
        <groupId>org.jspecify</groupId>
        <artifactId>jspecify</artifactId>
        <version>${jspecify.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.code.gson</groupId>
        <artifactId>gson</artifactId>
        <version>${gson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.eclipse.jgit</groupId>
        <artifactId>org.eclipse.jgit</artifactId>
        <version>${jgit.version}</version>
      </dependency>
      <dependency>
        <groupId>software.constructs</groupId>
        <artifactId>constructs</artifactId>
        <version>${software.constructs.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cdk8s</groupId>
        <artifactId>cdk8s</artifactId>
        <version>${cdk8s.version}</version>
      </dependency>
      <dependency>
        <groupId>org.cdk8s</groupId>
        <artifactId>cdk8s-plus-33</artifactId>
        <version>${cdk8s.plus33.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.commons</groupId>
        <artifactId>commons-compress</artifactId>
        <version>${commons.compress.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.jgiven</groupId>
        <artifactId>jgiven-core</artifactId>
        <version>${jgiven.version}</version>
      </dependency>
      <dependency>
        <groupId>com.tngtech.jgiven</groupId>
        <artifactId>jgiven-junit5</artifactId>
        <version>${jgiven.version}</version>
      </dependency>
      <dependency>
        <groupId>com.github.seancfoley</groupId>
        <artifactId>ipaddress</artifactId>
        <version>${ipaddress.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.resolver</artifactId>
        <version>${felix.resolver.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>osgi.core</artifactId>
        <version>${osgi.core.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.framework</artifactId>
        <version>${felix.framework.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.metatype</artifactId>
        <version>${felix.metatype.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.log</artifactId>
        <version>${felix.log.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.configadmin</artifactId>
        <version>${felix.configadmin.version}</version>
      </dependency>
      <dependency>
        <groupId>org.apache.felix</groupId>
        <artifactId>org.apache.felix.scr</artifactId>
        <version>${felix.scr.version}</version>
      </dependency>
      <!-- Pax Logging: api (replaces org.slf4j for bundles) + logback backend (LogService impl,
           reuses the host logback context via StaticLogbackContext) -->
      <!--
        Both pax-logging jars drag osgi.cmpn (the OSGi compendium aggregate: a real bundle exporting
        137 packages, incl. org.osgi.service.component / util.promise / util.function). Nothing here
        compiles against the compendium, and those DS-API packages are owned by their dedicated spec
        jars (staged as bundles). Left in, osgi.cmpn flattens into the exec uber-jar and the system
        bundle re-exports its 137 packages, splitting the staged trio's packages. Excluded HERE in the
        BOM so the cut applies on every transitive path, once — the enforcer bans it globally too.
      -->
      <dependency>
        <groupId>org.ops4j.pax.logging</groupId>
        <artifactId>pax-logging-api</artifactId>
        <version>${pax.logging.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.ops4j.pax.logging</groupId>
        <artifactId>pax-logging-logback</artifactId>
        <version>${pax.logging.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.osgi</groupId>
            <artifactId>osgi.cmpn</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.metatype</artifactId>
        <version>${osgi.metatype.version}</version>
      </dependency>
      <!-- OSGi construction annotations — bnd-consumed, scope provided at use site -->
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.component.annotations</artifactId>
        <version>${osgi.ds.annotations.version}</version>
      </dependency>
      <!-- DS runtime API (service.component + .runtime + .runtime.dto) felix.scr requires at run -->
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.component</artifactId>
        <version>${osgi.component.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.util.promise</artifactId>
        <version>${osgi.util.promise.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.util.function</artifactId>
        <version>${osgi.util.function.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.service.metatype.annotations</artifactId>
        <version>${osgi.metatype.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.annotation.bundle</artifactId>
        <version>${osgi.bundle.annotations.version}</version>
      </dependency>
      <dependency>
        <groupId>org.osgi</groupId>
        <artifactId>org.osgi.annotation.versioning</artifactId>
        <version>${osgi.versioning.annotations.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
