<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Inherits build-parent (resolved from disk via relativePath, NOT from ~/.m2 and NOT as a reactor
    module) so plugin versions, the BOM import, the common test deps, toolchain and enforcer are all
    single-sourced there — no divergence. The hard rule is "not in the reactor's <modules>" (a core
    extension loads BEFORE the reactor, which would be the self-loading chicken-egg); a <parent> is
    read at model-building from the filesystem, so it does not trip that rule. Unlike the BOM (which
    is deliberately no-parent to break the parent-imports-BOM cycle), this aggregator has no such
    cycle, so it takes the parent and the single source of truth that comes with it.

    Own version 1.0.0 (RELEASE, overrides the parent's SNAPSHOT): its lifecycle is the artifact
    VERSION, not the parent ref. Built and installed before the reactor:
      1. ./mvnw -f maven-embed-staging-ext/pom.xml install   (release -> ~/.m2)
      2. ./mvnw -am clean package                             (the reactor)
  -->
  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.0.0</version>
    <relativePath>../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>maven-embed-staging-ext</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>
  <name>maven-embed-staging-ext</name>
  <description>Build-time tooling that single-sources the OSGi bundle staging: the shared bnd-read
    parsing extracted from osgi/boot, and (later) the core extension that derives the shade-exclude
    and META-INF/bundles staging lists from what the bundles declare. Released to the local repo and
    consumed before the reactor builds, so it cannot be a reactor module — but it inherits build-parent
    for all shared build configuration.</description>

  <modules>
    <module>bnd-read</module>
    <module>staging-extension</module>
  </modules>
</project>
