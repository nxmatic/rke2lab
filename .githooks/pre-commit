#!/usr/bin/env bash
# Block committing wip/ onto the protected branch (main). Catches direct commits and
# squash-merges (both create a commit on main with wip/ staged). Fast-forward merges create
# no commit and slip past this — pre-push is the catch-all backstop for those.
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib-wip-guard.sh
. "${here}/lib-wip-guard.sh"

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
if [ "${branch}" = "${PROTECTED_BRANCH}" ] && wip_present_in_index; then
  reject "Unstage/remove ${WIP_DIR}/ before committing to ${PROTECTED_BRANCH}, or commit on a feature branch."
  exit 1
fi
