    "version": "0.2.0",
    "configurations": [
        {
            "name": "Connect to kdns",
            "type": "go",
            "request": "attach",
            "mode": "remote",
            "remotePath": "/var/lib/git/lab42/kdns",
            "port": 40000,
            "host": "127.0.0.1",
            "showLog": true,
            "substitutePath": [
                {
                    "from": "/var/lib/git/lab42/kdns",
                    "to": "${workspaceFolder:kdns}"
                }
            ]
        }
    ]
}