{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "atlassian@claude-plugins-official": true
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": ["Read", "Grep", "Glob", "Bash", "Edit", "Write"],
    "ask": ["Bash(sudo *)"],
    "deny": [
      "Bash(pulumi up*)",
      "Bash(pulumi destroy*)",
      "Bash(pulumi cancel*)",
      "Bash(kubectl apply*)",
      "Bash(kubectl delete*)",
      "Bash(kubectl patch*)",
      "Bash(kubectl create*)",
      "Bash(kubectl replace*)",
      "Bash(helm install*)",
      "Bash(helm upgrade*)",
      "Bash(helm uninstall*)",
      "Bash(incus *)",
      "Bash(home-manager switch*)",
      "Bash(darwin-rebuild*)",
      "Bash(nixos-rebuild*)",
      "Bash(rm -rf *)",
      "Bash(mv ~/.claude*)",
      "Bash(rm -rf ~/.claude*)"
    ]
  }
}
