{
  "model": "us.anthropic.claude-opus-4-8[1m]",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/bin/checkpoint-write.sh\"",
            "statusMessage": "Creating checkpoint before compaction...",
            "timeout": 10
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/bin/checkpoint-gc.sh\"",
            "statusMessage": "Pruning orphaned checkpoints...",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
