{
  "permissions": {
    "allow": [
      "Bash(flox activate *)",
      "Bash(git worktree *)",
      "Bash(git -C /private/var/lib/git/nxmatic/rke2lab.d/feature/cli-osgi-exec-alignment log --oneline -1)"
    ]
  },
  "model": "us.anthropic.claude-opus-4-8[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/bin/session-start-reminder.sh\"",
            "timeout": 5,
            "statusMessage": "Checking checkpoint draft status..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/bin/checkpoint-write.sh\"",
            "timeout": 10,
            "statusMessage": "Creating checkpoint before compaction..."
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "manual|auto",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/bin/checkpoint-gc.sh\"",
            "timeout": 10,
            "statusMessage": "Pruning orphaned checkpoints..."
          }
        ]
      }
    ]
  }
}
