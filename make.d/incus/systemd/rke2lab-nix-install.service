[Unit]
Description=Install Nix Package Manager for RKE2 Lab
After=local-fs.target network.target rke2lab-network-config.service
Requires=local-fs.target rke2lab-network-config.service

[Service]
Type=oneshot
ExecStart=/srv/host/scripts.d/rke2lab-nix-install.sh
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=rke2lab-tools.target
