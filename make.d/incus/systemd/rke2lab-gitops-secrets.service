[Unit]
Description=Apply RKE2Lab gitops secrets
RequiresMountsFor=/srv/host/system.d /srv/host
After=local-fs.target
After=rke2-server.service
Requires=rke2-server.service
ConditionPathExists=/srv/host/scripts.d/rke2lab-layer-secrets-apply.sh

[Service]
Type=oneshot
ExecStart=/srv/host/scripts.d/rke2lab-layer-secrets-apply.sh gitops
RemainAfterExit=true
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target