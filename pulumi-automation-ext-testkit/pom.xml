<?xml version="1.0" encoding="UTF-8"?>
<!-- @codebase -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.nxmatic.rke2lab</groupId>
    <artifactId>build-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../build-parent/pom.xml</relativePath>
  </parent>

  <artifactId>pulumi-automation-ext-testkit</artifactId>
  <name>pulumi-automation-ext-testkit</name>
  <description>Shared test fixtures for pulumi-automation-ext: reusable checkpoint/stack stubs,
    kept in main scope so consumers depend on them without a test-jar.</description>

  <!--
    Shared test fixtures for the file-backend stack layout, kept in src/main/java so consumers
    depend on them in test scope across modules WITHOUT a test-jar — m2e does not resolve test-jar
    classpaths, so the one-module-two-artifacts route would leave the IDE red. A plain main artifact
    of a workspace project resolves cleanly. The fixture writes the on-disk history/checkpoint pair
    once, reused by StackHandleTest (in pulumi-automation-ext) and seed-master's SnapshotSource
    tests.

    It depends on pulumi-automation-ext ONLY for PulumiBackendLayout (the single source of truth for
    the .pulumi/history/<project>/<stack> on-disk convention), so the fixture writes into the exact
    layout the reader reads — never a second copy of the path string. It does NOT reference the
    classes under test (StackHandle/StackHistory/...): each consumer builds its own
    StackHandle.forBackend(...) from the returned backendDir.
  -->
  <dependencies>
    <dependency>
      <groupId>io.nxmatic.rke2lab</groupId>
      <artifactId>pulumi-automation-ext</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
