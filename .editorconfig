root = true

# Shell scripts: spaces, never tabs. shfmt (run by the spotless gate) defaults to TAB
# indentation; without this, it rewrites the space-indented sources to tabs on every build —
# and a tab anywhere in a scalar forces SnakeYAML to abandon the readable literal-block (`|`)
# style when these scripts are carried as local-config ConfigMaps, falling back to an escaped
# double-quoted blob. (A `<<-` heredoc still keeps its required leading tabs — shfmt preserves
# heredoc bodies — so a script using one stays double-quoted; that is correct, not a regression.)
[*.sh]
indent_style = space
indent_size = 4
